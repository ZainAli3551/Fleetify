@model List<Fleetify.Models.Entities.DeliveryRequest>
@{
    ViewData["Title"] = "All Deliveries Management";
    var currentFilter = (ViewBag.CurrentFilter as string) ?? "All";
    var searchTerm = (ViewBag.SearchTerm as string) ?? "";
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count);
    var pendingCount = (int)(ViewBag.PendingCount ?? Model.Count(m => m.RequestedStatus == "Pending"));
    var assignedCount = (int)(ViewBag.AssignedCount ?? Model.Count(m => m.RequestedStatus == "Assigned"));
    var inTransitCount = (int)(ViewBag.InTransitCount ?? Model.Count(m => m.RequestedStatus == "In-Transit"));
    var deliveredCount = (int)(ViewBag.DeliveredCount ?? Model.Count(m => m.RequestedStatus == "Delivered"));
    var cancelledCount = (int)(ViewBag.CancelledCount ?? Model.Count(m => m.RequestedStatus == "Cancelled"));
}

<div class="admin-page-content">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-card-checklist text-primary me-2"></i>All Deliveries &amp; Shipments
            </h2>
            <p class="text-secondary small mb-0">Complete lifecycle tracking, customer orders, cargo verification, and fleet dispatch statuses</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Admin/Assignments" class="btn btn-primary rounded-pill px-4 py-2 text-white small shadow-xs">
                <i class="bi bi-plus-circle me-1.5"></i>Dispatch &amp; Assign Orders
            </a>
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 small" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print Manifest
            </button>
        </div>
    </div>

    <!-- Top 4 KPI Metrics Row -->
    <div class="row g-3 mb-4">
        <!-- Total Shipments -->
        <div class="col-xl-3 col-sm-6">
            <div class="kpi-metric-card">
                <div class="kpi-icon-box kpi-icon-blue">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="kpi-title">Total Shipments</div>
                    <div class="kpi-value">@totalCount</div>
                    <div class="kpi-trend text-primary x-small">
                        <span>Lifetime Logged</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- In-Transit -->
        <div class="col-xl-3 col-sm-6">
            <div class="kpi-metric-card">
                <div class="kpi-icon-box kpi-icon-green">
                    <i class="bi bi-truck"></i>
                </div>
                <div>
                    <div class="kpi-title">Active In-Transit</div>
                    <div class="kpi-value">@inTransitCount</div>
                    <div class="kpi-trend text-success x-small">
                        <span>On GT Road / Highways</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Allocation -->
        <div class="col-xl-3 col-sm-6">
            <div class="kpi-metric-card">
                <div class="kpi-icon-box kpi-icon-orange">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <div class="kpi-title">Pending Allocation</div>
                    <div class="kpi-value">@pendingCount</div>
                    <div class="kpi-trend text-warning x-small">
                        <span>Awaiting Driver</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delivered -->
        <div class="col-xl-3 col-sm-6">
            <div class="kpi-metric-card">
                <div class="kpi-icon-box kpi-icon-purple">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <div class="kpi-title">Completed &amp; Delivered</div>
                    <div class="kpi-value">@deliveredCount</div>
                    <div class="kpi-trend text-success x-small">
                        <span>100% Successful Dropoffs</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="card border-0 shadow-xs rounded-4 bg-white p-3 mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <!-- Filter Pills -->
            <div class="d-flex flex-wrap gap-1">
                <a asp-action="Deliveries" asp-route-statusFilter="All" asp-route-search="@searchTerm"
                   class="btn btn-sm rounded-pill @(currentFilter == "All" ? "btn-primary" : "btn-light text-secondary")">
                    All (@totalCount)
                </a>
                <a asp-action="Deliveries" asp-route-statusFilter="In-Transit" asp-route-search="@searchTerm"
                   class="btn btn-sm rounded-pill @(currentFilter == "In-Transit" ? "btn-success" : "btn-light text-secondary")">
                    In-Transit (@inTransitCount)
                </a>
                <a asp-action="Deliveries" asp-route-statusFilter="Pending" asp-route-search="@searchTerm"
                   class="btn btn-sm rounded-pill @(currentFilter == "Pending" ? "btn-warning text-dark" : "btn-light text-secondary")">
                    Pending (@pendingCount)
                </a>
                <a asp-action="Deliveries" asp-route-statusFilter="Assigned" asp-route-search="@searchTerm"
                   class="btn btn-sm rounded-pill @(currentFilter == "Assigned" ? "btn-info text-white" : "btn-light text-secondary")">
                    Assigned (@assignedCount)
                </a>
                <a asp-action="Deliveries" asp-route-statusFilter="Delivered" asp-route-search="@searchTerm"
                   class="btn btn-sm rounded-pill @(currentFilter == "Delivered" ? "btn-primary" : "btn-light text-secondary")">
                    Delivered (@deliveredCount)
                </a>
                <a asp-action="Deliveries" asp-route-statusFilter="Cancelled" asp-route-search="@searchTerm"
                   class="btn btn-sm rounded-pill @(currentFilter == "Cancelled" ? "btn-secondary text-white" : "btn-light text-secondary")">
                    Cancelled (@cancelledCount)
                </a>
            </div>

            <!-- Search Field -->
            <form method="get" asp-action="Deliveries" class="d-flex align-items-center gap-2 m-0" style="min-width: 300px;">
                <input type="hidden" name="statusFilter" value="@currentFilter" />
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="search" class="form-control bg-light border-start-0 rounded-end-pill pe-3" 
                           placeholder="Filter tracking #, city, customer..." value="@searchTerm" />
                </div>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <a asp-action="Deliveries" asp-route-statusFilter="@currentFilter" class="btn btn-sm btn-light rounded-pill px-2" title="Clear search">
                        <i class="bi bi-x"></i>
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Deliveries Master Table -->
    <div class="card border-0 shadow-xs rounded-4 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">
                Shipment Manifest Records
                <span class="badge bg-light text-secondary border rounded-pill ms-2 fw-semibold" style="font-size: 0.75rem;">@Model.Count shipments displayed</span>
            </h5>
            <span class="text-muted small">Showing @Model.Count records</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th>Tracking ID</th>
                        <th>Customer / Sender</th>
                        <th>Origin &rarr; Destination</th>
                        <th>Package Details</th>
                        <th>Driver &amp; Vehicle</th>
                        <th>Status</th>
                        <th>Booked Date</th>
                        <th>Est. Cost</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Any())
                    {
                        foreach (var req in Model)
                        {
                            var badgeClass = req.RequestedStatus switch
                            {
                                "Delivered" => "bg-success-subtle text-success",
                                "In-Transit" => "bg-primary-subtle text-primary",
                                "Assigned" => "bg-info-subtle text-info",
                                "Cancelled" => "bg-secondary-subtle text-secondary",
                                _ => "bg-warning-subtle text-warning"
                            };

                            var driverName = req.Assignment?.Driver?.FullName;
                            var vehiclePlate = req.Assignment?.Vehicle?.VehicleNumber;

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-1.5">
                                        <a href="/Customer/Track?trackingNumber=@req.TrackingNumber" class="fw-bold font-mono text-primary text-decoration-none">
                                            @req.TrackingNumber
                                        </a>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-muted" title="Copy tracking" onclick="navigator.clipboard.writeText('@req.TrackingNumber')">
                                            <i class="bi bi-clipboard" style="font-size: 0.75rem;"></i>
                                        </button>
                                    </div>
                                    <span class="text-muted font-mono" style="font-size: 0.7rem;">#REQ-@req.RequestID.ToString("D4")</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(req.User?.FullName ?? "Walk-in Customer")</div>
                                    <span class="text-muted" style="font-size: 0.72rem;">@(req.User?.Email ?? "N/A")</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@req.PickupLocation &rarr; @req.DropoffLocation</div>
                                    <div class="d-flex align-items-center gap-2 mt-0.5">
                                        <span class="text-muted" style="font-size: 0.72rem;"><i class="bi bi-signpost-2 me-1"></i>@req.DistanceKm km</span>
                                        <span class="badge bg-light text-muted border" style="font-size: 0.65rem;">
                                            @(req.DestinationType == "WarehousePickup" ? "Hub Pickup" : "Doorstep")
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(req.PackageName) ? (req.ParcelDescription ?? "General Cargo") : req.PackageName)</div>
                                    <span class="text-muted" style="font-size: 0.72rem;">
                                        @req.ParcelWeight.ToString("N1") kg &bull; @(req.Quantity > 1 ? $"{req.Quantity} Items (Bundle)" : "Single Item")
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(driverName))
                                    {
                                        <div class="fw-semibold text-dark">@driverName</div>
                                        <span class="badge bg-light text-muted border font-mono" style="font-size: 0.7rem;">@vehiclePlate</span>
                                    }
                                    else
                                    {
                                        <a href="/Admin/Assignments" class="badge bg-warning-subtle text-warning text-decoration-none rounded-pill px-2 py-1">
                                            <i class="bi bi-person-plus me-1"></i>Unassigned
                                        </a>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill px-2.5 py-1 fw-bold @badgeClass">
                                        @req.RequestedStatus
                                    </span>
                                </td>
                                <td>
                                    <div class="text-muted font-mono" style="font-size: 0.75rem;">
                                        @req.RequestDate.ToString("MMM dd, yyyy")
                                    </div>
                                    <span class="text-muted" style="font-size: 0.7rem;">
                                        @req.RequestDate.ToString("hh:mm tt")
                                    </span>
                                </td>
                                <td>
                                    <strong class="text-dark font-mono">Rs. @req.EstimatedCost.ToString("N0")</strong>
                                </td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm rounded-pill px-2 py-1" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                            <li>
                                                <a class="dropdown-item small" href="/Customer/Track?trackingNumber=@req.TrackingNumber" target="_blank">
                                                    <i class="bi bi-geo-alt text-primary me-2"></i>Live Track Page
                                                </a>
                                            </li>
                                            @if (req.RequestedStatus == "Pending")
                                            {
                                                <li>
                                                    <a class="dropdown-item small" href="/Admin/Assignments">
                                                        <i class="bi bi-person-check text-success me-2"></i>Dispatch Driver
                                                    </a>
                                                </li>
                                            }
                                            @if (req.RequestedStatus != "Delivered" && req.RequestedStatus != "Cancelled")
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="UpdateDeliveryMilestone" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="requestId" value="@req.RequestID" />
                                                        <input type="hidden" name="status" value="In-Transit" />
                                                        <input type="hidden" name="returnUrl" value="/Admin/Deliveries" />
                                                        <button type="submit" class="dropdown-item small text-primary">
                                                            <i class="bi bi-truck me-2"></i>Mark In-Transit
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="UpdateDeliveryMilestone" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="requestId" value="@req.RequestID" />
                                                        <input type="hidden" name="status" value="Delivered" />
                                                        <input type="hidden" name="returnUrl" value="/Admin/Deliveries" />
                                                        <button type="submit" class="dropdown-item small text-success">
                                                            <i class="bi bi-check-circle me-2"></i>Mark Delivered
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="UpdateDeliveryMilestone" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="requestId" value="@req.RequestID" />
                                                        <input type="hidden" name="status" value="Cancelled" />
                                                        <input type="hidden" name="returnUrl" value="/Admin/Deliveries" />
                                                        <button type="submit" class="dropdown-item small text-danger">
                                                            <i class="bi bi-x-circle me-2"></i>Cancel Order
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 text-secondary mb-2 d-block"></i>
                                <p class="mb-1">No deliveries found matching this filter or search.</p>
                                <a asp-action="Deliveries" class="btn btn-sm btn-outline-primary rounded-pill mt-2">Reset Filters</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
