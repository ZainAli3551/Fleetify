    <script>
        // =====================================================================
        // 1. REVENUE TREND CHART (EXACT REPLICATION OF SCREENSHOT)
        // =====================================================================
        const ctxRev = document.getElementById('revenueTrendChart').getContext('2d');
        
        // Gradient for line fill
        const gradientRev = ctxRev.createLinearGradient(0, 0, 0, 230);
        gradientRev.addColorStop(0, 'rgba(37, 99, 235, 0.22)');
        gradientRev.addColorStop(1, 'rgba(37, 99, 235, 0.00)');

        const revenueChart = new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
                datasets: [{
                    label: 'Revenue ($)',
                    data: [15000, 20000, 26000, 23000, 35000, 31000, 48000],
                    borderColor: '#2563eb',
                    borderWidth: 2.5,
                    backgroundColor: gradientRev,
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#2563eb',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4.5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleFont: { family: 'Plus Jakarta Sans', size: 12, weight: '700' },
                        bodyFont: { family: 'Plus Jakarta Sans', size: 12 },
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(ctx) { return '$' + ctx.raw.toLocaleString(); }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 11, weight: '500' } }
                    },
                    y: {
                        min: 0,
                        max: 50000,
                        ticks: {
                            stepSize: 10000,
                            callback: function(val) {
                                if (val === 0) return '0';
                                return (val / 1000) + 'k';
                            },
                            color: '#94a3b8',
                            font: { family: 'Plus Jakarta Sans', size: 11, weight: '500' }
                        },
                        grid: { color: 'rgba(226, 232, 240, 0.6)', borderDash: [4, 4] }
                    }
                }
            }
        });

        // =====================================================================
        // 2. WEEKLY DELIVERIES BAR CHART (EXACT REPLICATION OF SCREENSHOT)
        // =====================================================================
        const ctxWeek = document.getElementById('weeklyDeliveriesChart').getContext('2d');
        const weeklyChart = new Chart(ctxWeek, {
            type: 'bar',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    label: 'Deliveries',
                    data: [7, 9, 11, 9, 16, 11, 7],
                    backgroundColor: '#2563eb',
                    borderRadius: 6,
                    borderSkipped: false,
                    barPercentage: 0.55
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleFont: { family: 'Plus Jakarta Sans', size: 12, weight: '700' },
                        bodyFont: { family: 'Plus Jakarta Sans', size: 12 },
                        padding: 10,
                        cornerRadius: 8
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 11, weight: '500' } }
                    },
                    y: {
                        min: 0,
                        max: 20,
                        ticks: {
                            stepSize: 5,
                            color: '#94a3b8',
                            font: { family: 'Plus Jakarta Sans', size: 11, weight: '500' }
                        },
                        grid: { color: 'rgba(226, 232, 240, 0.6)', borderDash: [4, 4] }
                    }
                }
            }
        });

        // =====================================================================
        // 3. LEAFLET INTERACTIVE ACTIVE ROUTE MAP (LAHORE -> GUJRANWALA)
        // =====================================================================
        let adminMap = null;
        let routeLine = null;

        function initAdminRouteMap() {
            const lahore = [31.5204, 74.3587];
            const gujranwala = [32.1877, 74.1945];

            adminMap = L.map('adminActiveRouteMap', {
                zoomControl: false,
                attributionControl: false
            }).setView([31.85, 74.28], 9);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18
            }).addTo(adminMap);

            // Custom Start Pin (Green)
            const greenPin = L.divIcon({
                className: 'custom-map-pin',
                html: '<div style="background: #10b981; color: #ffffff; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.25); border: 2px solid #ffffff;"><i class="bi bi-geo-alt-fill" style="font-size: 13px;"></i></div>',
                iconSize: [28, 28],
                iconAnchor: [14, 28]
            });

            // Custom Destination Pin (Red)
            const redPin = L.divIcon({
                className: 'custom-map-pin',
                html: '<div style="background: #ef4444; color: #ffffff; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.25); border: 2px solid #ffffff;"><i class="bi bi-geo-alt-fill" style="font-size: 13px;"></i></div>',
                iconSize: [28, 28],
                iconAnchor: [14, 28]
            });

            // Custom Truck Pin (Blue)
            const truckPin = L.divIcon({
                className: 'custom-truck-pin',
                html: '<div style="background: #2563eb; color: #ffffff; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 14px rgba(37,99,235,0.7); border: 2px solid #ffffff;"><i class="bi bi-truck" style="font-size: 14px;"></i></div>',
                iconSize: [30, 30],
                iconAnchor: [15, 15]
            });

            L.marker(lahore, { icon: greenPin }).addTo(adminMap).bindPopup('<b>Origin:</b> Lahore Hub');
            L.marker(gujranwala, { icon: redPin }).addTo(adminMap).bindPopup('<b>Destination:</b> Gujranwala Terminal');

            // Route points along Grand Trunk Road (GT Road)
            const midCoord = [31.8540, 74.2760];
            const routePoints = [lahore, [31.68, 74.31], midCoord, [32.02, 74.24], gujranwala];

            routeLine = L.polyline(routePoints, {
                color: '#2563eb',
                weight: 4,
                opacity: 0.9,
                dashArray: '6, 6'
            }).addTo(adminMap);

            L.marker(midCoord, { icon: truckPin }).addTo(adminMap).bindPopup('<b>Fleetify Express LEA-7846:</b> En Route (64 km/h)');

            adminMap.fitBounds(L.latLngBounds([lahore, gujranwala]), { padding: [30, 30] });
        }

        function recenterAdminMap() {
            if (adminMap && routeLine) {
                adminMap.fitBounds(routeLine.getBounds(), { padding: [30, 30] });
            }
        }

        function showRouteModal() {
            const modal = new bootstrap.Modal(document.getElementById('routeDetailsModal'));
            modal.show();
        }

        function filterDeliveriesTable(keyword) {
            keyword = (keyword || '').toLowerCase();
            const rows = document.querySelectorAll('#recentFleetTable tbody tr');
            rows.forEach(r => {
                const text = r.textContent.toLowerCase();
                r.style.display = text.includes(keyword) ? '' : 'none';
            });
        }

        function toggleTheme() {
            const icon = document.getElementById('themeIcon');
            if (icon.classList.contains('bi-brightness-high')) {
                icon.classList.remove('bi-brightness-high');
                icon.classList.add('bi-moon-stars');
                alert('Dark theme preference toggled.');
            } else {
                icon.classList.remove('bi-moon-stars');
                icon.classList.add('bi-brightness-high');
                alert('Light theme preference toggled.');
            }
        }

        function toggleRevenueRange() {
            alert('Filtering Revenue telemetry: Last 6 Months (Active)');
        }

        // Initialize Map after DOM ready
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(initAdminRouteMap, 300);
        });
    </script>
</body>
</html>
