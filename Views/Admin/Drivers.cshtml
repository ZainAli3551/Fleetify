@model List<Fleetify.Models.Entities.Driver>
@{
    ViewData["Title"] = "Driver Management";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Driver Management</h2>
            <p class="text-secondary small mb-0">Manage fleet drivers, license verification, and availability status</p>
        </div>
        <button type="button" class="btn btn-primary rounded-pill px-3 py-2 text-white small" data-bs-toggle="modal" data-bs-target="#addDriverModal">
            <i class="bi bi-plus-circle me-1"></i>Add New Driver
        </button>
    </div>

    <!-- Secondary Navigation Menu -->
    <div class="admin-subnav d-flex gap-3 border-bottom pb-3 mb-4 overflow-auto">
        <a asp-action="Index" class="text-secondary text-decoration-none pb-2 px-2 hover-primary">Overview</a>
        <a asp-action="Drivers" class="fw-semibold text-primary text-decoration-none border-bottom border-2 border-primary pb-2 px-2">Drivers</a>
        <a asp-action="Vehicles" class="text-secondary text-decoration-none pb-2 px-2 hover-primary">Vehicles</a>
        <a asp-action="Assignments" class="text-secondary text-decoration-none pb-2 px-2 hover-primary">Assignments</a>
        <a asp-action="Maintenance" class="text-secondary text-decoration-none pb-2 px-2 hover-primary">AI Maintenance</a>
    </div>

    <div class="card border-0 shadow-xs rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th>Driver ID</th>
                        <th>Full Name</th>
                        <th>Email &amp; Contact</th>
                        <th>License Number</th>
                        <th>Total Tasks</th>
                        <th>Availability</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var driver in Model)
                    {
                        <tr>
                            <td class="fw-bold">#DRV-@driver.UserID.ToString("D3")</td>
                            <td class="fw-semibold text-dark">@driver.FullName</td>
                            <td>
                                <div>@driver.Email</div>
                                <div class="text-muted">@driver.PhoneNumber</div>
                            </td>
                            <td><span class="badge bg-light text-dark border font-mono">@driver.LicenseNumber</span></td>
                            <td>@driver.Assignments.Count assignments</td>
                            <td>
                                @if (driver.AvailabilityStatus == "Available")
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Available</span>
                                }
                                else if (driver.AvailabilityStatus == "Busy")
                                {
                                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1">Busy</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">Offline</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown d-inline">
                                    <button class="btn btn-light btn-sm rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Status
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <form asp-action="ToggleDriverStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@driver.UserID" />
                                                <input type="hidden" name="status" value="Available" />
                                                <button type="submit" class="dropdown-item text-success">Mark Available</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-action="ToggleDriverStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@driver.UserID" />
                                                <input type="hidden" name="status" value="Busy" />
                                                <button type="submit" class="dropdown-item text-warning">Mark Busy</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-action="ToggleDriverStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@driver.UserID" />
                                                <input type="hidden" name="status" value="Offline" />
                                                <button type="submit" class="dropdown-item text-secondary">Mark Offline</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Driver Modal -->
<div class="modal fade" id="addDriverModal" tabindex="-1" aria-labelledby="addDriverModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="addDriverModalLabel">Register New Driver</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateDriver" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body pt-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Full Name</label>
                        <input name="FullName" required class="form-control rounded-3" placeholder="e.g. Tariq Mehmood" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Email Address</label>
                        <input name="Email" type="email" required class="form-control rounded-3" placeholder="driver@fleetify.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Phone Number</label>
                        <input name="PhoneNumber" required class="form-control rounded-3" placeholder="+92 300 0000000" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Driver License Number</label>
                        <input name="LicenseNumber" required class="form-control rounded-3" placeholder="PK-DL-12345" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Temporary Password</label>
                        <input name="Password" type="password" required class="form-control rounded-3" placeholder="••••••••" />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 text-white">Save Driver</button>
                </div>
            </form>
        </div>
    </div>
</div>
