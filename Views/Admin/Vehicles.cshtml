@model List<Fleetify.Models.Entities.Vehicle>
@{
    ViewData["Title"] = "Vehicle Fleet Management";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Vehicle Fleet Management</h2>
            <p class="text-secondary small mb-0">Monitor fleet inventory, mileage, load capacity, and operational readiness</p>
        </div>
        <button type="button" class="btn btn-primary rounded-pill px-3 py-2 text-white small" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
            <i class="bi bi-plus-circle me-1"></i>Add Fleet Vehicle
        </button>
    </div>

    <!-- Secondary Navigation Menu -->
    <div class="admin-subnav d-flex gap-3 border-bottom pb-3 mb-4 overflow-auto">
        <a asp-action="Index" class="text-secondary text-decoration-none pb-2 px-2 hover-primary">Overview</a>
        <a asp-action="Drivers" class="text-secondary text-decoration-none pb-2 px-2 hover-primary">Drivers</a>
        <a asp-action="Vehicles" class="fw-semibold text-primary text-decoration-none border-bottom border-2 border-primary pb-2 px-2">Vehicles</a>
        <a asp-action="Assignments" class="text-secondary text-decoration-none pb-2 px-2 hover-primary">Assignments</a>
        <a asp-action="Maintenance" class="text-secondary text-decoration-none pb-2 px-2 hover-primary">AI Maintenance</a>
    </div>

    <div class="card border-0 shadow-xs rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th>Vehicle Plate #</th>
                        <th>Type &amp; Model</th>
                        <th>Capacity</th>
                        <th>Current Mileage</th>
                        <th>Since Service</th>
                        <th>Condition Status</th>
                        <th>Availability</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var v in Model)
                    {
                        var kmSinceService = v.CurrentMileage - v.LastServiceMileage;
                        <tr>
                            <td class="fw-bold font-mono text-primary">@v.VehicleNumber</td>
                            <td>
                                <div class="fw-semibold text-dark">@v.Model</div>
                                <span class="badge bg-light text-muted border">@v.VehicleType</span>
                            </td>
                            <td>@v.CapacityKg.ToString("N0") kg</td>
                            <td class="fw-semibold">@v.CurrentMileage.ToString("N0") km</td>
                            <td>
                                <span class="@(kmSinceService > 8000 ? "text-danger fw-bold" : "text-muted")">
                                    @kmSinceService.ToString("N0") km
                                </span>
                            </td>
                            <td>
                                @if (v.ConditionStatus == "Good")
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Good</span>
                                }
                                else if (v.ConditionStatus == "Warning")
                                {
                                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1">Warning</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">Critical</span>
                                }
                            </td>
                            <td>
                                @if (v.AvailabilityStatus == "Available")
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Available</span>
                                }
                                else if (v.AvailabilityStatus == "Assigned")
                                {
                                    <span class="badge bg-info-subtle text-info rounded-pill px-3 py-1">Assigned</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">Under Service</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Vehicle Modal -->
<div class="modal fade" id="addVehicleModal" tabindex="-1" aria-labelledby="addVehicleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="addVehicleModalLabel">Add Vehicle to Fleet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateVehicle" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body pt-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Registration / Plate Number</label>
                        <input name="VehicleNumber" required class="form-control rounded-3" placeholder="e.g. FLT-VAN-05" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Vehicle Type</label>
                        <select name="VehicleType" class="form-select rounded-3">
                            <option value="Bike">Bike (Up to 40 kg)</option>
                            <option value="Car">Car (Up to 400 kg)</option>
                            <option value="Van" selected>Van (Up to 1,500 kg)</option>
                            <option value="Truck">Truck (Up to 5,000 kg)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Model &amp; Year</label>
                        <input name="Model" required class="form-control rounded-3" placeholder="e.g. Toyota Hiace 2024" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Capacity (kg)</label>
                            <input name="CapacityKg" type="number" step="10" required class="form-control rounded-3" value="1200" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Current Mileage (km)</label>
                            <input name="CurrentMileage" type="number" step="10" required class="form-control rounded-3" value="5000" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Initial Condition</label>
                        <select name="ConditionStatus" class="form-select rounded-3">
                            <option value="Good" selected>Good</option>
                            <option value="Warning">Warning (Needs inspection)</option>
                            <option value="Critical">Critical (Needs repair)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 text-white">Save Vehicle</button>
                </div>
            </form>
        </div>
    </div>
</div>
