@model Fleetify.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Fleetify – Modern Fleet Management System";
}

<!-- Custom Styles for Modern Fleetify SaaS Home Page -->
<style>
    /* ==========================================================================
       HERO SECTION - CINEMATIC FLEET BANNER & GLASSMORPHISM
       ========================================================================== */
    .home-hero-container {
        position: relative;
        min-height: 640px;
        border-radius: 1.75rem;
        overflow: hidden;
        margin-bottom: 3.5rem;
        background: #0f172a url('/images/fleet-home-hero.jpg?v=2') right center / cover no-repeat;
        box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.15), 0 0 40px rgba(14, 165, 233, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
    }

    /* Soft daylight overlay with readable text contrast */
    .home-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, 
            rgba(10, 25, 47, 0.94) 0%, 
            rgba(12, 33, 62, 0.88) 42%, 
            rgba(15, 45, 82, 0.60) 65%, 
            rgba(15, 23, 42, 0.25) 100%
        );
        z-index: 1;
    }

    .home-hero-content {
        position: relative;
        z-index: 2;
        padding: 4.5rem 3.5rem;
    }

    @@media (max-width: 991.98px) {
        .home-hero-container {
            min-height: auto;
            border-radius: 1.25rem;
        }
        .home-hero-content {
            padding: 2.5rem 1.5rem;
        }
        .home-hero-overlay {
            background: linear-gradient(180deg, 
                rgba(10, 25, 47, 0.92) 0%, 
                rgba(12, 33, 62, 0.85) 100%
            );
        }
    }

    /* Hero Pill Tag */
    .hero-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 1.15rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #e0f2fe;
        font-size: 0.825rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    /* Hero Headings */
    .hero-headline {
        font-size: clamp(2.4rem, 4.5vw, 3.85rem);
        font-weight: 800;
        letter-spacing: -0.035em;
        line-height: 1.12;
        color: #ffffff !important;
    }

    .hero-headline .text-hero-accent {
        background: linear-gradient(135deg, #38bdf8 0%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
    }

    .hero-subtext {
        font-size: clamp(1rem, 1.25vw, 1.2rem);
        color: #cbd5e1;
        max-width: 640px;
        font-weight: 400;
        line-height: 1.65;
    }

    /* Hero Buttons */
    .btn-hero-primary {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        font-weight: 700;
        border-radius: 9999px;
        padding: 0.85rem 2rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
    }

    .btn-hero-primary:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
        box-shadow: 0 14px 30px -5px rgba(2, 132, 199, 0.65);
        color: #ffffff;
    }

    .btn-hero-glass {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: #ffffff;
        font-weight: 600;
        border-radius: 9999px;
        padding: 0.85rem 1.85rem;
        border: 1px solid rgba(255, 255, 255, 0.25);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
    }

    .btn-hero-glass:hover {
        background: rgba(255, 255, 255, 0.22);
        color: #ffffff;
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.4);
    }

    /* Trust Stats Strip */
    .hero-stats-strip {
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        padding-top: 1.75rem;
        margin-top: 2.25rem;
    }

    .hero-stat-item {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .hero-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        color: #38bdf8;
        flex-shrink: 0;
    }

    .hero-stat-number {
        font-size: 1.45rem;
        font-weight: 800;
        color: #ffffff;
        font-family: var(--font-sans);
        line-height: 1;
        margin-bottom: 0.2rem;
    }

    .hero-stat-label {
        font-size: 0.8rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 600;
        margin-bottom: 0;
    }

    /* Tracking Search Bar on Hero */
    .hero-tracking-form {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 9999px;
        padding: 5px 6px 5px 16px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
        max-width: 540px;
    }

    .hero-tracking-form input {
        border: none;
        background: transparent;
        font-size: 0.925rem;
        color: #0f172a;
        font-weight: 500;
    }

    .hero-tracking-form input:focus {
        outline: none;
        box-shadow: none;
    }

    /* ==========================================================================
       GLASSMORPHISM CARDS & CONTAINERS
       ========================================================================== */
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1.5px solid rgba(226, 232, 240, 0.9);
        border-radius: 1.35rem;
        padding: 2rem 1.75rem;
        box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.05);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .glass-card:hover {
        transform: translateY(-6px);
        background: #ffffff;
        border-color: rgba(2, 132, 199, 0.35);
        box-shadow: 0 20px 40px -10px rgba(2, 132, 199, 0.15);
    }

    .glass-card-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.65rem;
        margin-bottom: 1.35rem;
        transition: transform 0.3s ease;
    }

    .glass-card:hover .glass-card-icon {
        transform: scale(1.08);
    }

    .icon-teal-theme {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .icon-blue-theme {
        background: #eff6ff;
        color: #0284c7;
        border: 1px solid #bfdbfe;
    }

    .icon-indigo-theme {
        background: #eef2ff;
        color: #4f46e5;
        border: 1px solid #c7d2fe;
    }

    .icon-amber-theme {
        background: #fffbeb;
        color: #d97706;
        border: 1px solid #fde68a;
    }

    .icon-purple-theme {
        background: #faf5ff;
        color: #9333ea;
        border: 1px solid #e9d5ff;
    }

    .icon-rose-theme {
        background: #fff1f2;
        color: #e11d48;
        border: 1px solid #fecdd3;
    }

    .glass-card-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.65rem;
    }

    .glass-card-desc {
        font-size: 0.925rem;
        color: #475569;
        line-height: 1.6;
        margin-bottom: 1.25rem;
        flex-grow: 1;
    }

    .glass-card-link {
        font-size: 0.875rem;
        font-weight: 700;
        color: #0284c7;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: gap 0.2s ease, color 0.2s ease;
    }

    .glass-card-link:hover {
        gap: 0.6rem;
        color: #0369a1;
    }

    /* ==========================================================================
       SECTION LABELS & HEADINGS
       ========================================================================== */
    .section-label {
        display: inline-block;
        font-size: 0.775rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #0284c7;
        background: #e0f2fe;
        border: 1px solid #bae6fd;
        padding: 0.35rem 1rem;
        border-radius: 9999px;
        margin-bottom: 0.75rem;
    }

    .section-heading {
        font-size: clamp(1.85rem, 3.2vw, 2.75rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #0f172a;
        line-height: 1.2;
    }

    .section-subheading {
        font-size: 1.05rem;
        color: #64748b;
        max-width: 680px;
        margin: 0.5rem auto 0 auto;
    }

    /* ==========================================================================
       ABOUT SECTION
       ========================================================================== */
    .about-image-wrapper {
        position: relative;
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.15);
        border: 1px solid rgba(226, 232, 240, 0.9);
    }

    .about-image-wrapper img {
        width: 100%;
        height: 100%;
        max-height: 480px;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }

    .about-image-wrapper:hover img {
        transform: scale(1.02);
    }

    .about-floating-badge {
        position: absolute;
        bottom: 1.25rem;
        left: 1.25rem;
        background: rgba(15, 23, 42, 0.88);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1rem;
        padding: 0.85rem 1.25rem;
        color: #ffffff;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        max-width: 280px;
    }

    .about-check-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.85rem;
    }

    .about-check-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #ecfdf5;
        color: #059669;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 800;
        flex-shrink: 0;
        margin-top: 0.15rem;
    }

    .about-mission-card {
        background: rgba(240, 249, 255, 0.85);
        border: 1.5px solid #bae6fd;
        border-radius: 1.25rem;
        padding: 1.5rem;
        margin-top: 1.5rem;
    }

    /* ==========================================================================
       4-STEP WORKFLOW TIMELINE
       ========================================================================== */
    .workflow-card {
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        border-radius: 1.25rem;
        padding: 2rem 1.5rem;
        position: relative;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        height: 100%;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
    }

    .workflow-card:hover {
        transform: translateY(-5px);
        border-color: #0284c7;
        box-shadow: 0 16px 32px -8px rgba(2, 132, 199, 0.15);
    }

    .step-number {
        font-size: 1.85rem;
        font-weight: 900;
        color: #0284c7;
        font-family: var(--font-sans);
        line-height: 1;
        margin-bottom: 0.85rem;
        display: inline-block;
        background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .workflow-step-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #f0f9ff;
        color: #0284c7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        margin-bottom: 1rem;
    }

    /* ==========================================================================
       WHY CHOOSE FLEETIFY - SUBTLE BLUE GRADIENT
       ========================================================================== */
    .why-choose-section {
        background: linear-gradient(135deg, #f0f7ff 0%, #e0effe 45%, #f8fafc 100%);
        border-radius: 1.75rem;
        padding: 4.5rem 3rem;
        border: 1px solid #bfdbfe;
        box-shadow: 0 10px 30px -5px rgba(2, 132, 199, 0.08);
        margin-bottom: 3.5rem;
    }

    @@media (max-width: 991.98px) {
        .why-choose-section {
            padding: 2.5rem 1.5rem;
            border-radius: 1.25rem;
        }
    }

    .benefit-card {
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1.5px solid rgba(255, 255, 255, 0.8);
        border-radius: 1.25rem;
        padding: 2rem 1.75rem;
        box-shadow: 0 6px 20px -2px rgba(15, 23, 42, 0.05);
        transition: all 0.3s ease;
        height: 100%;
    }

    .benefit-card:hover {
        transform: translateY(-5px);
        background: #ffffff;
        border-color: #38bdf8;
        box-shadow: 0 16px 32px -6px rgba(2, 132, 199, 0.16);
    }

    /* ==========================================================================
       CALL TO ACTION (CTA) CARD
       ========================================================================== */
    .cta-card {
        background: linear-gradient(135deg, #0b1e3a 0%, #034b75 60%, #0284c7 100%);
        border-radius: 1.75rem;
        padding: 4.5rem 3rem;
        color: #ffffff;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 25px 60px -12px rgba(3, 75, 117, 0.4);
        margin-bottom: 3.5rem;
    }

    @@media (max-width: 991.98px) {
        .cta-card {
            padding: 2.5rem 1.5rem;
            border-radius: 1.25rem;
        }
    }

    .cta-glow-circle {
        position: absolute;
        top: -30%;
        right: -10%;
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.3) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(50px);
        pointer-events: none;
    }

    /* Interactive Hub Pills */
    .hub-pill-modern {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.15rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        color: #334155;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .hub-pill-modern:hover {
        background: #f0f9ff;
        color: #0284c7;
        border-color: #bae6fd;
        transform: translateY(-2px);
    }

    /* Weight Chips for Rate Calculator */
    .calc-chip {
        cursor: pointer;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        background: #f1f5f9;
        color: #475569;
        font-weight: 600;
        font-size: 0.8rem;
        border: 1px solid #e2e8f0;
        transition: all 0.15s ease;
    }

    .calc-chip:hover {
        background: #e0f2fe;
        color: #0369a1;
        border-color: #bae6fd;
    }
</style>

<div class="container-fluid px-lg-5 py-2">

    <!-- =====================================================================
         1. HERO SECTION (CINEMATIC FLEET MANAGEMENT SAAS BANNER)
         ===================================================================== -->
    <section id="home" class="home-hero-container">
        <div class="home-hero-overlay"></div>
        <div class="home-hero-content">
            <div class="row align-items-center">
                <div class="col-xl-8 col-lg-9 col-md-11">

                    <!-- Small Pill Badge -->
                    <div class="mb-3">
                        <span class="hero-badge-pill">
                            <i class="bi bi-shield-check text-info"></i>
                            Smarter Fleet &bull; Safer Roads &bull; Better Deliveries
                        </span>
                    </div>

                    <!-- Main Hero Heading -->
                    <h1 class="hero-headline mb-3">
                        Your Fleet. <span class="text-hero-accent">Our Priority.</span>
                    </h1>

                    <!-- Supporting Hero Subtitle -->
                    <p class="hero-subtext mb-4 pe-lg-4">
                        Manage your fleet, shipments and deliveries with a smarter, safer and more efficient logistics platform. Powered by real-time GPS telemetry, route planning and centralized control.
                    </p>

                    <!-- Dual Action Buttons -->
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                        <a asp-controller="Account" asp-action="Register" class="btn-hero-primary">
                            <span>Get Started</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                        <a href="#about" class="btn-hero-glass">
                            <span>Learn More</span>
                            <i class="bi bi-chevron-down"></i>
                        </a>
                    </div>

                    <!-- Instant Live Tracking Bar on Hero (Evaluator Testing Widget) -->
                    <div id="hero-track-bar" class="mb-4">
                        <form action="/Customer/Track" method="get" class="hero-tracking-form d-flex align-items-center">
                            <i class="bi bi-search text-primary ms-2 fs-5"></i>
                            <input type="text" name="trackingNumber" class="form-control" placeholder="Enter Tracking # (e.g. FLT-2026-X00000)" required autocomplete="off" />
                            <button type="submit" class="btn btn-hero-primary py-2 px-3.5 fs-6 flex-shrink-0">
                                <span>Track</span>
                                <i class="bi bi-arrow-right small"></i>
                            </button>
                        </form>
                        <small class="text-white-50 ms-3 mt-1.5 d-inline-block">
                            <i class="bi bi-broadcast text-info me-1"></i>Track any ongoing consignment live across Pakistan without signing in.
                        </small>
                    </div>

                    <!-- Trust Statistics Strip Underneath Hero -->
                    <div class="hero-stats-strip">
                        <div class="row g-4">
                            <div class="col-sm-4 col-6">
                                <div class="hero-stat-item">
                                    <div class="hero-stat-icon">
                                        <i class="bi bi-truck"></i>
                                    </div>
                                    <div>
                                        <div class="hero-stat-number">@(Model.ActiveFleets)+</div>
                                        <div class="hero-stat-label">Active Fleets</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4 col-6">
                                <div class="hero-stat-item">
                                    <div class="hero-stat-icon">
                                        <i class="bi bi-shield-check"></i>
                                    </div>
                                    <div>
                                        <div class="hero-stat-number">@(Model.DeliverySuccessRate)%</div>
                                        <div class="hero-stat-label">Delivery Success</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4 col-12">
                                <div class="hero-stat-item">
                                    <div class="hero-stat-icon">
                                        <i class="bi bi-headset"></i>
                                    </div>
                                    <div>
                                        <div class="hero-stat-number">24/7</div>
                                        <div class="hero-stat-label">Tracking &amp; Support</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>


    <!-- =====================================================================
         2. SERVICES SECTION (OUR SERVICES)
         ===================================================================== -->
    <section id="services" class="mb-5 pb-3">
        <div class="text-center mb-5">
            <span class="section-label">OUR SERVICES</span>
            <h2 class="section-heading">Everything You Need to Manage Your Fleet</h2>
            <p class="section-subheading">
                A unified platform combining GPS telemetry, dispatch automation, driver coordination, and complete delivery lifecycle visibility.
            </p>
        </div>

        <div class="row g-4">
            <!-- 1. Real-Time Tracking -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card">
                    <div class="glass-card-icon icon-blue-theme">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <h3 class="glass-card-title">Real-Time Tracking</h3>
                    <p class="glass-card-desc">
                        Monitor vehicles and shipments in real time with continuous GPS telemetry, live status updates, and transparent milestone notifications.
                    </p>
                    <a href="#hero-track-bar" class="glass-card-link">
                        <span>Learn More</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 2. Route Management -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card">
                    <div class="glass-card-icon icon-teal-theme">
                        <i class="bi bi-signpost-2-fill"></i>
                    </div>
                    <h3 class="glass-card-title">Route Management</h3>
                    <p class="glass-card-desc">
                        Plan efficient routes and reduce unnecessary travel time across major highway corridors, optimizing fuel and turnaround schedules.
                    </p>
                    <a href="#rate-calculator" class="glass-card-link">
                        <span>Learn More</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 3. Shipment Management -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card">
                    <div class="glass-card-icon icon-indigo-theme">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                    <h3 class="glass-card-title">Shipment Management</h3>
                    <p class="glass-card-desc">
                        Manage bulk shipments and delivery requests between cities with automated weight, volume, and dimension verification formulas.
                    </p>
                    <a asp-controller="Account" asp-action="Register" class="glass-card-link">
                        <span>Learn More</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 4. Driver Management -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card">
                    <div class="glass-card-icon icon-amber-theme">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    <h3 class="glass-card-title">Driver Management</h3>
                    <p class="glass-card-desc">
                        Manage drivers, duty assignments and delivery activities with dedicated route pairing, real-time alerts, and status logging.
                    </p>
                    <a asp-controller="Account" asp-action="Login" class="glass-card-link">
                        <span>Learn More</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 5. Secure Logistics -->
            <div class="col-lg-4 col-md-6">
