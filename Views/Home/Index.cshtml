<!-- Interactive Estimator & Contact Script -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const originSel = document.getElementById('estOriginSelect');
        const destSel = document.getElementById('estDestSelect');
        const weightInput = document.getElementById('estWeightInput');
        const speedSel = document.getElementById('estSpeedSelect');

        function fetchLandingEstimate() {
            const pickup = originSel ? originSel.value : '';
            const dropoff = destSel ? destSel.value : '';
            const weight = parseFloat(weightInput ? weightInput.value : '2.0') || 2.0;
            const route = speedSel ? speedSel.value : 'Normal';

            fetch('/api/ai/estimate-cost', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    pickupLocation: pickup,
                    dropoffLocation: dropoff,
                    parcelWeight: weight,
                    routeType: route,
                    originType: 'WarehouseDropoff',
                    destinationType: 'WarehousePickup'
                })
            })
            .then(res => res.json())
            .then(data => {
                if (document.getElementById('previewDistance')) {
                    document.getElementById('previewDistance').innerText = Math.floor(data.distanceKm) + ' km';
                }
                if (document.getElementById('previewDays')) {
                    document.getElementById('previewDays').innerText = data.estimatedDeliveryDays || '4 to 6 days';
                }
                if (document.getElementById('previewBaseCost')) {
                    const wt = (data.weightCharge !== undefined && data.weightCharge !== null) ? data.weightCharge : (data.baseCost || 0);
                    document.getElementById('previewBaseCost').innerText = 'Rs. ' + Math.floor(wt);
                }
                if (document.getElementById('previewPetrol')) {
                    const distFee = (data.distanceCharge !== undefined && data.distanceCharge !== null) ? data.distanceCharge : (data.petrolCharge || 0);
                    document.getElementById('previewPetrol').innerText = 'Rs. ' + Math.floor(distFee);
                }
                if (document.getElementById('previewTotal')) {
                    document.getElementById('previewTotal').innerText = 'Rs. ' + Math.floor(data.estimatedTotal || 0);
                }
                const specialRow = document.getElementById('previewSpecialRow');
                if (specialRow) {
                    if (data.isSpecialDelivery) {
                        specialRow.classList.remove('d-none');
                    } else {
                        specialRow.classList.add('d-none');
                    }
                }
            })
            .catch(err => console.log('Landing estimate preview:', err));
        }

        originSel?.addEventListener('change', fetchLandingEstimate);
        destSel?.addEventListener('change', fetchLandingEstimate);
        weightInput?.addEventListener('input', fetchLandingEstimate);
        speedSel?.addEventListener('change', fetchLandingEstimate);

        // Initial preview call
        fetchLandingEstimate();
    });

    function handleContactSubmit(event) {
        event.preventDefault();
        const alertBox = document.getElementById('contactSuccessAlert');
        const form = document.getElementById('landingContactForm');
        if (alertBox) {
            alertBox.classList.remove('d-none');
        }
        if (form) {
            form.reset();
        }
    }
</script>
