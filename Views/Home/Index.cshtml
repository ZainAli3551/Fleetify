    <!-- =====================================================================
         4. HOW FLEETIFY WORKS (4-STEP CONNECTED TIMELINE)
         ===================================================================== -->
    <section id="how-it-works" class="mb-5 pb-3">
        <div class="text-center mb-5">
            <span class="section-label">PROCESS FLOW</span>
            <h2 class="section-heading">How Fleetify Works</h2>
            <p class="section-subheading">
                A seamless four-stage operational workflow from initial customer request to verified recipient handover.
            </p>
        </div>

        <div class="row g-4">
            <!-- Step 01: Request -->
            <div class="col-lg-3 col-sm-6">
                <div class="workflow-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="step-number">01</div>
                        <div class="workflow-step-icon">
                            <i class="bi bi-file-earmark-plus"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Request</h4>
                    <p class="text-secondary small mb-0">
                        Customer creates a shipment/transport request with pickup, destination hubs, parcel weight, and delivery urgency tier.
                    </p>
                </div>
            </div>

            <!-- Step 02: Approval -->
            <div class="col-lg-3 col-sm-6">
                <div class="workflow-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="step-number">02</div>
                        <div class="workflow-step-icon">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Approval</h4>
                    <p class="text-secondary small mb-0">
                        Admin reviews package dimensions, verifies rate calculations, schedules routing, and approves the consignment request.
                    </p>
                </div>
            </div>

            <!-- Step 03: Assignment -->
            <div class="col-lg-3 col-sm-6">
                <div class="workflow-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="step-number">03</div>
                        <div class="workflow-step-icon">
                            <i class="bi bi-person-check"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Assignment</h4>
                    <p class="text-secondary small mb-0">
                        The shipment is assigned to an available certified driver with dedicated truck load allocation and pickup instructions.
                    </p>
                </div>
            </div>

            <!-- Step 04: Delivery -->
            <div class="col-lg-3 col-sm-6">
                <div class="workflow-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="step-number">04</div>
                        <div class="workflow-step-icon">
                            <i class="bi bi-box2-heart"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Delivery</h4>
                    <p class="text-secondary small mb-0">
                        Driver delivers the shipment to recipient destination, updates status to Delivered, and logs digital proof of delivery.
                    </p>
                </div>
            </div>
        </div>
    </section>


