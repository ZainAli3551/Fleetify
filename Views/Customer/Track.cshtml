@model Fleetify.Models.Entities.DeliveryRequest
@{
    ViewData["Title"] = $"Track Shipment - {Model.TrackingNumber}";
    var isDelivered = Model.RequestedStatus == "Delivered";
    var isInTransit = Model.RequestedStatus == "In-Transit" || isDelivered;
    var isAssigned = Model.Assignment != null || isInTransit;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="text-secondary text-decoration-none small">&larr; Back to Dashboard</a>
            <h3 class="fw-bold text-dark mt-2 mb-1 font-mono">Shipment @Model.TrackingNumber</h3>
            <span class="text-secondary small">Booked on @Model.RequestDate.ToString("MMMM dd, yyyy HH:mm")</span>
        </div>
        <div>
            @if (Model.RequestedStatus == "Delivered")
            {
                <span class="badge bg-success-subtle text-success fs-6 rounded-pill px-4 py-2">Delivered</span>
            }
            else if (Model.RequestedStatus == "In-Transit")
            {
                <span class="badge bg-warning-subtle text-warning fs-6 rounded-pill px-4 py-2">In Transit</span>
            }
            else if (Model.RequestedStatus == "Assigned")
            {
                <span class="badge bg-info-subtle text-info fs-6 rounded-pill px-4 py-2">Driver Assigned</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary fs-6 rounded-pill px-4 py-2">Processing</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Tracking Timeline Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-xs rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-semibold text-dark mb-4">Delivery Progress Timeline</h5>

                <!-- Visual Step Indicator -->
                <div class="d-flex justify-content-between position-relative mb-5 px-3">
                    <div class="timeline-step text-center z-1">
                        <div class="step-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 42px; height: 42px;">
                            <i class="bi bi-clipboard-check"></i>
                        </div>
                        <span class="small fw-semibold d-block">Booked</span>
                        <span class="x-small text-muted">@Model.RequestDate.ToString("MMM dd")</span>
                    </div>

                    <div class="timeline-step text-center z-1">
                        <div class="step-circle @(isAssigned ? "bg-primary text-white" : "bg-light text-muted border") rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 42px; height: 42px;">
                            <i class="bi bi-person-check"></i>
                        </div>
                        <span class="small fw-semibold d-block">Assigned</span>
                        <span class="x-small text-muted">@(Model.Assignment != null ? Model.Assignment.AssignedDate.ToString("MMM dd") : "Pending")</span>
                    </div>

                    <div class="timeline-step text-center z-1">
                        <div class="step-circle @(isInTransit ? "bg-primary text-white" : "bg-light text-muted border") rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 42px; height: 42px;">
                            <i class="bi bi-truck"></i>
                        </div>
                        <span class="small fw-semibold d-block">In Transit</span>
                        <span class="x-small text-muted">@(isInTransit ? "On the road" : "Awaiting")</span>
                    </div>

                    <div class="timeline-step text-center z-1">
                        <div class="step-circle @(isDelivered ? "bg-success text-white" : "bg-light text-muted border") rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 42px; height: 42px;">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <span class="small fw-semibold d-block">Delivered</span>
                        <span class="x-small text-muted">@(isDelivered ? "Completed" : "Pending")</span>
                    </div>
                </div>

                <!-- Event Logs -->
                <h6 class="fw-semibold text-secondary mb-3">Milestone Activity</h6>
                @if (Model.Assignment?.StatusUpdates != null && Model.Assignment.StatusUpdates.Any())
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var update in Model.Assignment.StatusUpdates.OrderByDescending(u => u.UpdateTime))
                        {
                            <li class="list-group-item px-0 py-3 border-bottom d-flex gap-3 align-items-start">
                                <div class="bg-primary-subtle text-primary rounded-circle p-2 mt-1">
                                    <i class="bi bi-dot fs-5"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <strong class="text-dark">@update.UpdateStatus</strong>
                                        <span class="text-muted">@update.UpdateTime.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                    <p class="text-secondary mb-0 mt-1">@update.Remarks</p>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-0">Delivery request registered in the system. Dispatcher assignment in progress.</p>
                }
            </div>
        </div>

        <!-- Shipment Overview Card (Right Column) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-xs rounded-4 p-4 bg-white mb-3">
                <h6 class="fw-bold text-dark mb-3">Shipment Details</h6>

                <div class="mb-3">
                    <span class="text-secondary small d-block">Pickup Location</span>
                    <strong class="text-dark"><i class="bi bi-geo-alt-fill text-muted me-1"></i>@Model.PickupLocation</strong>
                </div>

                <div class="mb-3">
                    <span class="text-secondary small d-block">Dropoff Destination</span>
                    <strong class="text-dark"><i class="bi bi-flag-fill text-danger me-1"></i>@Model.DropoffLocation</strong>
                </div>

                <div class="row g-2 mb-3 small">
                    <div class="col-6">
                        <span class="text-secondary d-block">Weight</span>
                        <strong>@Math.Floor(Model.ParcelWeight).ToString("F0") kg</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-secondary d-block">Vehicle Type</span>
                        <strong>@Model.VehicleType</strong>
                    </div>
                </div>

                <div class="row g-2 mb-3 small">
                    <div class="col-6">
                        <span class="text-secondary d-block">Estimated Distance</span>
                        <strong>@Math.Floor(Model.DistanceKm).ToString("F0") km</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-secondary d-block">Delivery Type</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.RouteType) ? "Normal" : Model.RouteType)</strong>
                    </div>
                </div>

                <div class="row g-2 mb-3 small">
                    <div class="col-12">
                        <span class="text-secondary d-block">Total Cost</span>
                        <strong class="text-primary fs-6">Rs. @Math.Floor(Model.EstimatedCost).ToString("F0")</strong>
                    </div>
                </div>

                @if (Model.Assignment?.Driver != null)
                {
                    <hr />
                    <h6 class="fw-bold text-dark mb-2">Assigned Driver</h6>
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary p-2">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                        <div>
                            <strong class="d-block text-dark">@Model.Assignment.Driver.FullName</strong>
                            <span class="text-muted small">@Model.Assignment.Driver.PhoneNumber</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
