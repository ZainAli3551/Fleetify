@model Fleetify.Models.ViewModels.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Portal";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- User Header (Figure 23) -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Fleetify</h2>
            <p class="text-secondary small mb-0">Welcome, <strong class="text-dark">@Model.UserName</strong></p>
        </div>
    </div>

    <!-- 4 Top Metric Cards (Figure 23) -->
    <div class="row g-3 mb-4">
        <!-- Total Deliveries -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Total Deliveries</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalDeliveries</h3>
                    </div>
                    <div class="kpi-icon bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- In Transit -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">In Transit</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.InTransitCount</h3>
                    </div>
                    <div class="kpi-icon bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="bi bi-truck fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delivered -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Delivered</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.DeliveredCount</h3>
                    </div>
                    <div class="kpi-icon bg-success-subtle text-success rounded-circle p-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Spent -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Total Spent</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">Rs. @Model.TotalSpent.ToString("N0")</h3>
                    </div>
                    <div class="kpi-icon bg-purple-subtle text-purple rounded-circle p-3">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs (Figure 23: New Delivery | Track Deliveries) -->
    <ul class="nav nav-pills mb-4 gap-2" id="customerTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 py-2" id="new-delivery-tab" data-bs-toggle="tab" data-bs-target="#new-delivery-pane" type="button" role="tab">
                New Delivery
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 py-2" id="track-deliveries-tab" data-bs-toggle="tab" data-bs-target="#track-deliveries-pane" type="button" role="tab">
                Track Deliveries (@Model.MyDeliveries.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="customerTabsContent">
        <!-- TAB 1: NEW DELIVERY (Figure 23) -->
        <div class="tab-pane fade show active" id="new-delivery-pane" role="tabpanel" tabindex="0">
            <div class="row g-4">
                <!-- Request Form (Left Column) -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-xs rounded-4 p-4 p-md-5 bg-white">
                        <h5 class="fw-bold text-dark mb-4">Request New Delivery</h5>

                        <form asp-action="CreateDelivery" method="post" id="deliveryForm">
                            @Html.AntiForgeryToken()

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">Pickup Address</label>
                                    <input asp-for="NewDelivery.PickupLocation" id="pickupAddr" class="form-control rounded-3 py-2" placeholder="e.g. Shaheenabad, Gujranwala" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">Dropoff Address</label>
                                    <input asp-for="NewDelivery.DropoffLocation" id="dropoffAddr" class="form-control rounded-3 py-2" placeholder="e.g. Data Darbar, Lahore" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">Package Weight (kg)</label>
                                    <input asp-for="NewDelivery.ParcelWeight" id="packageWeight" type="number" step="0.5" min="0.5" class="form-control rounded-3 py-2" value="2.0" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">Package Type</label>
                                    <select asp-for="NewDelivery.ParcelDescription" id="parcelDescription" class="form-select rounded-3 py-2">
                                        <option value="Document">Document</option>
                                        <option value="Electronics">Electronics</option>
                                        <option value="Clothing & Apparel">Clothing &amp; Apparel</option>
                                        <option value="Fragile Goods">Fragile Goods</option>
                                        <option value="Hardware Parts" selected>Hardware Parts</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-secondary">Delivery Type</label>
                                    <select asp-for="NewDelivery.RouteType" id="deliveryType" class="form-select rounded-3 py-2 fw-semibold text-dark">
                                        <option value="Normal" selected>Normal Delivery</option>
                                        <option value="Fast">Fast Delivery</option>
                                        <option value="Express">Express Delivery</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-secondary">Vehicle Type</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-primary"><i class="bi bi-truck fs-5"></i></span>
                                        <input type="text" class="form-control rounded-end-3 py-2 bg-light fw-bold text-dark border-start-0" value="Truck (Heavy freight)" readonly />
                                    </div>
                                    <input type="hidden" asp-for="NewDelivery.VehicleType" id="vehicleType" value="Truck" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-secondary">Pickup Date</label>
                                    <input asp-for="NewDelivery.PickupDate" id="pickupDate" type="date" class="form-control rounded-3 py-2" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>

                            <input type="hidden" asp-for="NewDelivery.Height" id="packageHeight" value="1.0" />
                            <input type="hidden" asp-for="NewDelivery.Width" id="packageWidth" value="1.0" />
                            <input type="hidden" id="distanceKm" name="NewDelivery.EstimatedDistanceKm" value="15" />

                            <div class="d-grid">
                                <button type="button" class="btn btn-primary rounded-pill py-2 fw-semibold text-white shadow-sm" onclick="showDeliveryNoticeModal()">
                                    <i class="bi bi-send me-1"></i> Submit Delivery Request
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Cost Estimate Card (Right Column - Figure 23) -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-xs rounded-4 p-4 bg-white sticky-top" style="top: 20px;">
                        <h6 class="fw-bold text-dark mb-3">Cost Estimate</h6>

                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Route Distance</span>
                            <span class="fw-semibold text-primary font-mono" id="estDistanceKm">15 km</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Cargo Size</span>
                            <span class="fw-semibold text-dark" id="estWeight">2 kg</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 small">
                            <span class="text-secondary">Delivery Speed</span>
                            <span class="fw-semibold text-primary" id="estDeliveryType">Normal</span>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold text-dark">Estimated Total</span>
                            <h4 class="fw-bold text-primary mb-0" id="estTotal">Rs. 545</h4>
                        </div>

                        <div class="p-3 bg-light-blue rounded-3 text-primary small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-clock-history fs-5"></i>
                            <div>
                                <span class="d-block text-secondary x-small">Estimated Delivery</span>
                                <strong id="estDeliveryDays">1-2 business days</strong>
                            </div>
                        </div>

                        <!-- Interactive Live Route Map -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-secondary small fw-semibold"><i class="bi bi-map me-1 text-primary"></i>Live Route Map</span>
                                <span id="estMapProvider" class="badge bg-light text-primary border" style="font-size: 0.68rem;">Google Maps Verified</span>
                            </div>
                            <div id="routeMap" class="rounded-3 border shadow-xs" style="height: 190px; width: 100%; background: #f8fafc; z-index: 1;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: TRACK DELIVERIES (History & Tracking) -->
        <div class="tab-pane fade" id="track-deliveries-pane" role="tabpanel" tabindex="0">
            <div class="card border-0 shadow-xs rounded-4 bg-white p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">My Delivery Bookings</h5>
                        <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i>Time-Limited: You can only Edit or Cancel delivery requests within <strong>1 hour</strong> of booking.</p>
                    </div>
                    <form asp-action="Track" method="get" class="d-flex gap-2" style="max-width: 320px;">
                        <input name="trackingNumber" class="form-control form-control-sm rounded-pill" placeholder="Enter Tracking # (e.g. FLT-...)" required />
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 text-white">Track</button>
                    </form>
                </div>

                @if (Model.MyDeliveries.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th>Tracking #</th>
                                    <th>Date</th>
                                    <th>Pickup &rarr; Dropoff</th>
                                    <th>Weight</th>
                                    <th>Speed</th>
                                    <th>Vehicle</th>
                                    <th>Cost</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.MyDeliveries)
                                {
                                    <tr>
                                        <td class="fw-bold font-mono text-primary">@d.TrackingNumber</td>
                                        <td>@d.RequestDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 200px;">
                                                <i class="bi bi-circle-fill text-muted me-1 small"></i>@d.PickupLocation
                                                <br />
                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@d.DropoffLocation
                                            </div>
                                        </td>
                                        <td><strong>@Math.Floor(d.ParcelWeight).ToString("F0")</strong> kg</td>
                                        <td>
                                            @{
                                                var speed = string.IsNullOrWhiteSpace(d.RouteType) ? "Normal" : d.RouteType;
                                                var speedBadge = speed == "Express" ? "bg-danger-subtle text-danger" : speed == "Fast" ? "bg-warning-subtle text-warning-emphasis" : "bg-light text-dark";
                                            }
                                            <span class="badge @speedBadge border">@speed</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border"><i class="bi bi-truck me-1"></i>@d.VehicleType</span>
                                        </td>
                                        <td class="fw-bold text-dark">Rs. @Math.Floor(d.EstimatedCost).ToString("F0")</td>
                                        <td>
                                            @if (d.RequestedStatus == "Delivered")
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Delivered</span>
                                            }
                                            else if (d.RequestedStatus == "In-Transit" || d.RequestedStatus == "Assigned")
                                            {
                                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1">In-Transit</span>
                                            }
                                            else if (d.RequestedStatus == "Cancelled")
                                            {
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">Pending</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end align-items-center gap-1">
                                                <a asp-action="Track" asp-route-trackingNumber="@d.TrackingNumber" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-1" title="Track Live">
                                                    <i class="bi bi-geo-alt"></i>
                                                </a>
                                                @{
                                                    var elapsedMins = (DateTime.UtcNow - d.RequestDate).TotalMinutes;
                                                    var isEditable = elapsedMins <= 60.0 && d.RequestedStatus == "Pending";
                                                    var minsLeft = Math.Max(0, (int)(60.0 - elapsedMins));
                                                }
                                                @if (isEditable)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-1" title="Edit Request (~@minsLeft mins left)"
                                                            onclick="openEditModal(@d.RequestID, '@d.TrackingNumber', '@Html.Raw(d.PickupLocation.Replace("'", "\\'"))', '@Html.Raw(d.DropoffLocation.Replace("'", "\\'"))', @d.ParcelWeight, '@Html.Raw((d.RouteType ?? "Normal").Replace("'", "\\'"))', '@Html.Raw((d.ParcelDescription ?? "").Replace("'", "\\'"))')">
                                                        <i class="bi bi-pencil-square text-dark"></i>
                                                    </button>
                                                    <form asp-action="CancelDelivery" method="post" class="d-inline" onsubmit="return confirm('Aap yeh delivery request cancel karna chahte hain? (Tracking: @d.TrackingNumber)');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@d.RequestID" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1" title="Cancel (~@minsLeft mins left)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border rounded-pill small ms-1" style="font-size: 0.65rem;" title="1-hour window">
                                                        <i class="bi bi-hourglass-split"></i> @(minsLeft)m
                                                    </span>
                                                }
                                                else if (d.RequestedStatus != "Cancelled")
                                                {
                                                    <span class="badge bg-light text-muted border rounded-pill small ms-1" style="font-size: 0.65rem;" title="1-hour window closed; locked for shipping">
                                                        <i class="bi bi-lock-fill"></i> Locked
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-box2 fs-1 mb-2"></i>
                        <h5>No deliveries requested yet.</h5>
                        <p class="small">Switch to the "New Delivery" tab above to book your first delivery.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- POP-UP 1: SUBMIT DELIVERY 1-HOUR LOCK NOTICE MODAL -->
<div class="modal fade" id="submitNoticeModal" tabindex="-1" aria-labelledby="submitNoticeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-warning bg-opacity-10 border-bottom-0 pb-2 pt-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-warning text-dark p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="submitNoticeModalLabel">Important Delivery Notice</h5>
                        <span class="text-muted small">1-Hour Edit &amp; Cancellation Policy</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <div class="alert alert-warning border-0 rounded-3 p-3 mb-3">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-clock-history fs-4 text-warning-emphasis flex-shrink-0 mt-1"></i>
                        <div class="small text-dark">
                            <p class="mb-2">
                                <strong>Time-Limited Adjustments:</strong> You can only Edit, Delete, or Cancel this delivery request within 1 hour (60 minutes) of submission.
                            </p>
                            <p class="mb-0 text-secondary">
                                <strong class="text-dark">Order Locking:</strong> Please note that the delivery request will lock automatically after 1 hour. Once locked, no further modifications or cancellations can be processed.
                            </p>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-2 small text-uppercase letter-spacing-1">Order Details Summary:</h6>
                <div class="bg-light rounded-3 p-3 small mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Pickup:</span>
                        <strong class="text-dark text-truncate ms-2" style="max-width: 250px;" id="modalPickupText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Dropoff:</span>
                        <strong class="text-dark text-truncate ms-2" style="max-width: 250px;" id="modalDropoffText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Weight:</span>
                        <strong class="text-dark" id="modalWeightText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Delivery Type:</span>
                        <strong class="text-dark" id="modalTypeText">Normal Delivery</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Vehicle Assigned:</span>
                        <span class="badge bg-primary text-white"><i class="bi bi-truck me-1"></i>Truck</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                        <strong class="text-dark">Estimated Cost:</strong>
                        <strong class="text-primary fs-6" id="modalCostText">-</strong>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Review Again</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 text-white fw-semibold" onclick="confirmAndSubmitDelivery()">
                    <i class="bi bi-check2-circle me-1"></i>I Understand, Confirm Booking
                </button>
            </div>
        </div>
    </div>
</div>

<!-- POP-UP 2: EDIT DELIVERY MODAL (Within 1-Hour Window) -->
<div class="modal fade" id="editDeliveryModal" tabindex="-1" aria-labelledby="editDeliveryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0 pt-3 px-4">
                <h5 class="modal-title fw-bold text-dark" id="editDeliveryModalLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Delivery (<span id="editTrackingNumber"></span>)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editDeliveryForm" asp-action="EditDelivery" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editRequestId" name="id" value="" />
                <input type="hidden" name="VehicleType" value="Truck" />
                <input type="hidden" id="editHeight" name="Height" value="1.0" />
                <input type="hidden" id="editWidth" name="Width" value="1.0" />

                <div class="modal-body px-4 py-3">
                    <div class="alert alert-info border-0 rounded-3 py-2 px-3 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>You are modifying this delivery request within the 1-hour allowed window.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Pickup Address</label>
                        <input id="editPickup" name="PickupLocation" class="form-control rounded-3 py-2" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Dropoff Address</label>
                        <input id="editDropoff" name="DropoffLocation" class="form-control rounded-3 py-2" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Weight (kg)</label>
                        <input id="editWeight" name="ParcelWeight" type="number" step="0.5" min="0.5" class="form-control rounded-3 py-2" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Delivery Type</label>
                        <select id="editRouteType" name="RouteType" class="form-select rounded-3 py-2 fw-semibold">
                            <option value="Normal">Normal Delivery</option>
                            <option value="Fast">Fast Delivery</option>
                            <option value="Express">Express Delivery</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Package Description</label>
                        <input id="editDesc" name="ParcelDescription" class="form-control rounded-3 py-2" />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 text-white fw-semibold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let estimateTimeout = null;
        let map = null;
        let routeLayer = null;
        let pickupMarker = null;
        let dropoffMarker = null;

        function initRouteMap() {
            const mapEl = document.getElementById('routeMap');
            if (!mapEl || map) return;
            map = L.map('routeMap', { zoomControl: false }).setView([31.5204, 74.3587], 8);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: 'Map data &copy; OpenStreetMap'
            }).addTo(map);
            L.control.zoom({ position: 'topright' }).addTo(map);
        }

        function decodePolyline(str, precision) {
            var index = 0, lat = 0, lng = 0, coordinates = [], shift = 0, result = 0, byte = null, lat_change, lng_change;
            var factor = Math.pow(10, precision || 5);
            while (index < str.length) {
                byte = null; shift = 0; result = 0;
                do {
                    byte = str.charCodeAt(index++) - 63;
                    result |= (byte & 0x1f) << shift;
                    shift += 5;
                } while (byte >= 0x20);
                lat_change = ((result & 1) ? ~(result >> 1) : (result >> 1));
                shift = 0; result = 0;
                do {
                    byte = str.charCodeAt(index++) - 63;
                    result |= (byte & 0x1f) << shift;
                    shift += 5;
                } while (byte >= 0x20);
                lng_change = ((result & 1) ? ~(result >> 1) : (result >> 1));
                lat += lat_change;
                lng += lng_change;
                coordinates.push([lat / factor, lng / factor]);
            }
            return coordinates;
        }

        // Real-time AI & Map Cost Calculation (((1.5 * Distance * Weight) + Petrol) * Speed)
        function updateAiEstimate() {
            initRouteMap();

            const pickup = document.getElementById('pickupAddr')?.value || '';
            const dropoff = document.getElementById('dropoffAddr')?.value || '';
            const weight = parseFloat(document.getElementById('packageWeight')?.value) || 2.0;
            const vehicle = 'Truck';
            const route = document.getElementById('deliveryType')?.value || 'Normal';

            fetch('/api/ai/estimate-cost', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    pickupLocation: pickup,
                    dropoffLocation: dropoff,
                    parcelWeight: weight,
                    vehicleType: vehicle,
                    routeType: route
                })
            })
            .then(res => {
                if (!res.ok) throw new Error('Network error: ' + res.status);
                return res.json();
            })
            .then(data => {
                if (document.getElementById('estDistanceKm')) {
                    document.getElementById('estDistanceKm').innerText = Math.floor(data.distanceKm) + ' km';
                }
                const currentWeight = (data.parcelWeight || weight || 2.0);
                if (document.getElementById('estWeight')) {
                    document.getElementById('estWeight').innerText = Math.floor(currentWeight) + ' kg';
                }
                if (document.getElementById('estDeliveryType')) {
                    document.getElementById('estDeliveryType').innerText = (data.deliveryType || route);
                }
                document.getElementById('estTotal').innerText = 'Rs. ' + Math.floor(data.estimatedTotal);
                document.getElementById('estDeliveryDays').innerText = data.estimatedDeliveryDays;

                const provBadge = document.getElementById('estMapProvider');
                if (provBadge && data.provider) {
                    provBadge.innerText = data.provider + ' Verified';
                }

                const distInput = document.getElementById('distanceKm');
                if (distInput) distInput.value = data.distanceKm;

                // Render Route Polyline on Map without annoying marker popups
                if (map && data.routePolyline) {
                    try {
                        const coords = decodePolyline(data.routePolyline);
                        if (coords && coords.length > 0) {
                            if (routeLayer) map.removeLayer(routeLayer);
                            if (pickupMarker) map.removeLayer(pickupMarker);
                            if (dropoffMarker) map.removeLayer(dropoffMarker);

                            routeLayer = L.polyline(coords, { color: '#2563eb', weight: 4, opacity: 0.85 }).addTo(map);

                            const startPt = coords[0];
                            const endPt = coords[coords.length - 1];

                            pickupMarker = L.circleMarker(startPt, { radius: 6, color: '#16a34a', fillColor: '#22c55e', fillOpacity: 0.9 }).addTo(map);
                            dropoffMarker = L.circleMarker(endPt, { radius: 6, color: '#dc2626', fillColor: '#ef4444', fillOpacity: 0.9 }).addTo(map);

                            map.fitBounds(routeLayer.getBounds(), { padding: [20, 20] });
                        }
                    } catch (e) {
                        console.warn('Polyline render error:', e);
                    }
                }
            })
            .catch(err => console.error("Error fetching AI estimate:", err));
        }

        function debouncedUpdate() {
            clearTimeout(estimateTimeout);
            estimateTimeout = setTimeout(updateAiEstimate, 350);
        }

        // Pop-up trigger with validation and 1-hour policy notice
        function showDeliveryNoticeModal() {
            const form = document.getElementById('deliveryForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const pickup = document.getElementById('pickupAddr')?.value || 'Not specified';
            const dropoff = document.getElementById('dropoffAddr')?.value || 'Not specified';
            const rawWeight = parseFloat(document.getElementById('packageWeight')?.value) || 2.0;
            const weight = Math.floor(rawWeight);
            const typeSel = document.getElementById('deliveryType');
            const deliveryType = typeSel ? typeSel.options[typeSel.selectedIndex].text : 'Normal Delivery';
            const total = document.getElementById('estTotal')?.innerText || 'Rs. 0';

            document.getElementById('modalPickupText').innerText = pickup;
            document.getElementById('modalDropoffText').innerText = dropoff;
            document.getElementById('modalWeightText').innerText = weight + ' kg';
            if (document.getElementById('modalTypeText')) {
                document.getElementById('modalTypeText').innerText = deliveryType;
            }
            document.getElementById('modalCostText').innerText = total;

            const modalEl = document.getElementById('submitNoticeModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        function confirmAndSubmitDelivery() {
            document.getElementById('deliveryForm').submit();
        }

        function openEditModal(id, tracking, pickup, dropoff, weight, routeType, desc) {
            document.getElementById('editRequestId').value = id;
            document.getElementById('editTrackingNumber').innerText = tracking;
            document.getElementById('editPickup').value = pickup;
            document.getElementById('editDropoff').value = dropoff;
            document.getElementById('editWeight').value = weight;
            if (document.getElementById('editRouteType')) {
                document.getElementById('editRouteType').value = routeType || 'Normal';
            }
            document.getElementById('editDesc').value = desc;

            const editModalEl = document.getElementById('editDeliveryModal');
            const modal = bootstrap.Modal.getOrCreateInstance(editModalEl);
            modal.show();
        }

        // Live interactive listeners
        document.getElementById('pickupAddr')?.addEventListener('input', debouncedUpdate);
        document.getElementById('dropoffAddr')?.addEventListener('input', debouncedUpdate);
        document.getElementById('packageWeight')?.addEventListener('input', debouncedUpdate);
        document.getElementById('deliveryType')?.addEventListener('change', updateAiEstimate);

        // Run on page load
        document.addEventListener('DOMContentLoaded', () => {
            initRouteMap();
            updateAiEstimate();
        });
    </script>
}
