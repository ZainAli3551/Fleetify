    // Known Inter-Hub Distances in Pakistan (Road km)
    const INTER_HUB_DISTANCES = {
        "gujranwala|lahore": 71.0, "lahore|gujranwala": 71.0,
        "gujranwala|sialkot": 52.0, "sialkot|gujranwala": 52.0,
        "gujranwala|islamabad": 215.0, "islamabad|gujranwala": 215.0,
        "lahore|islamabad": 375.0, "islamabad|lahore": 375.0,
        "lahore|faisalabad": 180.0, "faisalabad|lahore": 180.0,
        "lahore|multan": 345.0, "multan|lahore": 345.0,
        "lahore|karachi": 1215.0, "karachi|lahore": 1215.0,
        "islamabad|rawalpindi": 18.0, "rawalpindi|islamabad": 18.0,
        "islamabad|peshawar": 185.0, "peshawar|islamabad": 185.0,
        "lahore|sialkot": 132.0, "sialkot|lahore": 132.0
    };

    // State Variables
    let currentOriginMode = "DoorstepPickup"; // DoorstepPickup, WarehouseDropoff
    let currentDestinationMode = "DoorstepDelivery"; // DoorstepDelivery, WarehousePickup
    let currentRouteType = "Normal"; // Normal, Fast, Express
    let liveRouteMap = null;
    let mapLayersGroup = null;
    let activityChart = null;
    let doughnutChart = null;

    function selectDeliverySpeed(type) {
        currentRouteType = type;
        const hiddenRt = document.getElementById('hiddenRouteType');
        if (hiddenRt) hiddenRt.value = type;

        const cardNormal = document.getElementById('cardSpeedNormal');
        const cardFast = document.getElementById('cardSpeedFast');
        const cardExpress = document.getElementById('cardSpeedExpress');

        if (cardNormal) cardNormal.classList.remove('active');
        if (cardFast) cardFast.classList.remove('active');
        if (cardExpress) cardExpress.classList.remove('active');

        if (type === 'Normal' && cardNormal) cardNormal.classList.add('active');
        else if (type === 'Fast' && cardFast) cardFast.classList.add('active');
        else if ((type === 'Express' || type === 'Urgent') && cardExpress) cardExpress.classList.add('active');

        recalculateAll();
    }

    function getHub(city) {
        return WAREHOUSE_NETWORK[city] || WAREHOUSE_NETWORK["Lahore"];
    }

    function calculateInterHubDistance(cityA, cityB) {
        if (cityA === cityB) return 15.0; // Intra-city hub transit
        const key = `${cityA.toLowerCase()}|${cityB.toLowerCase()}`;
        if (INTER_HUB_DISTANCES[key]) return INTER_HUB_DISTANCES[key];

        const hubA = getHub(cityA);
        const hubB = getHub(cityB);
        // Haversine fallback with 25% road curvature
        const R = 6371;
        const dLat = (hubB.hubCoords[0] - hubA.hubCoords[0]) * Math.PI / 180;
        const dLon = (hubB.hubCoords[1] - hubA.hubCoords[1]) * Math.PI / 180;
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                  Math.cos(hubA.hubCoords[0] * Math.PI / 180) * Math.cos(hubB.hubCoords[0] * Math.PI / 180) *
                  Math.sin(dLon/2) * Math.sin(dLon/2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        return Math.round(R * c * 1.25);
    }

    // =========================================================================
    // SERVICE MODE SWITCHERS (CONDITIONAL LOGIC)
    // =========================================================================
    function setOriginServiceMode(mode) {
        currentOriginMode = mode;
        const btnDoorstep = document.getElementById('btnPickupDoorstep');
        const btnWarehouse = document.getElementById('btnPickupWarehouse');
        const doorstepBox = document.getElementById('pickupDoorstepFieldGroup');
        const warehouseBox = document.getElementById('pickupWarehouseFieldGroup');
        const badge = document.getElementById('badgePickupMode');
        const pCity = document.getElementById('selectPickupCity').value;
        const hub = getHub(pCity);

        if (mode === 'DoorstepPickup') {
            btnDoorstep.classList.add('active', 'is-success');
            btnWarehouse.classList.remove('active');
            doorstepBox.classList.remove('d-none');
            warehouseBox.classList.add('d-none');
            badge.innerText = 'Home Pickup';
            badge.className = 'badge bg-success-subtle text-success small';
            document.getElementById('hiddenOriginType').value = 'DoorstepPickup';
            document.getElementById('inputPickupAddress').setAttribute('required', 'required');
            const userAddr = document.getElementById('inputPickupAddress').value.trim();
            if (!userAddr || userAddr === hub.hubAddress) {
                document.getElementById('inputPickupAddress').value = `House 14, Street 5, Model Town, ${pCity}`;
            }
        } else {
            btnWarehouse.classList.add('active');
            btnDoorstep.classList.remove('active', 'is-success');
            doorstepBox.classList.add('d-none');
            warehouseBox.classList.remove('d-none');
            badge.innerText = 'Warehouse Drop-off';
            badge.className = 'badge bg-primary-subtle text-primary small';
            document.getElementById('hiddenOriginType').value = 'WarehouseDropoff';
            document.getElementById('inputPickupAddress').removeAttribute('required');
            // When warehouse dropoff, PickupLocation takes warehouse address
            document.getElementById('inputPickupAddress').value = hub.hubAddress;
        }

        recalculateAll();
    }

    function setDestinationServiceMode(mode) {
        currentDestinationMode = mode;
        const btnDoorstep = document.getElementById('btnDeliveryDoorstep');
        const btnWarehouse = document.getElementById('btnDeliveryWarehouse');
        const doorstepBox = document.getElementById('dropoffDoorstepFieldGroup');
        const warehouseBox = document.getElementById('dropoffWarehouseFieldGroup');
        const badge = document.getElementById('badgeDeliveryMode');
        const dCity = document.getElementById('selectDeliveryCity').value;
        const hub = getHub(dCity);

        if (mode === 'DoorstepDelivery') {
            btnDoorstep.classList.add('active', 'is-danger');
            btnWarehouse.classList.remove('active');
            doorstepBox.classList.remove('d-none');
            warehouseBox.classList.add('d-none');
            badge.innerText = 'Home Delivery';
            badge.className = 'badge bg-danger-subtle text-danger small';
            document.getElementById('hiddenDestinationType').value = 'DoorstepDelivery';
            document.getElementById('inputDropoffAddress').setAttribute('required', 'required');
            const userAddr = document.getElementById('inputDropoffAddress').value.trim();
            if (!userAddr || userAddr === hub.hubAddress) {
                document.getElementById('inputDropoffAddress').value = `Flat 4B, Gulberg III, ${dCity}`;
            }
        } else {
            btnWarehouse.classList.add('active');
            btnDoorstep.classList.remove('active', 'is-danger');
            doorstepBox.classList.add('d-none');
            warehouseBox.classList.remove('d-none');
            badge.innerText = 'Warehouse Pickup';
            badge.className = 'badge bg-primary-subtle text-primary small';
            document.getElementById('hiddenDestinationType').value = 'WarehousePickup';
            document.getElementById('inputDropoffAddress').removeAttribute('required');
