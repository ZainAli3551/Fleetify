            const deliveryType = typeSel ? typeSel.options[typeSel.selectedIndex].text : 'Normal Delivery';
            const total = document.getElementById('estTotal')?.innerText || 'Rs. 0';

            const originText = isDoorstep 
                ? 'Doorstep Pickup (Courier)' 
                : 'Warehouse Dropoff (' + (originWhSelect?.selectedOptions[0]?.text || 'Hub') + ')';

            const destText = isDestDoorstep 
                ? 'Doorstep Delivery (Address)' 
