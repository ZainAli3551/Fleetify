        function updateDimensionsDisplay() {
            const name = document.getElementById('packageName')?.value?.trim() || 'Product';
            const desc = document.getElementById('parcelDescription')?.value || 'Electronics';
            const l = parseFloat(document.getElementById('packageLength')?.value) || 2.0;
            const w = parseFloat(document.getElementById('packageWidth')?.value) || 1.5;
            const h = parseFloat(document.getElementById('packageHeight')?.value) || 1.0;
            const q = parseInt(document.getElementById('packageQuantity')?.value) || 1;
            const sw = parseFloat(document.getElementById('singleItemWeight')?.value) || 2.0;
            const singleCft = Math.round((l * w * h) * 100) / 100;
            const totalCft = Math.round((singleCft * q) * 100) / 100;
            const totalWt = Math.round((sw * q) * 100) / 100;

            if (document.getElementById('estPackageName')) document.getElementById('estPackageName').innerText = name;
            if (document.getElementById('estPackageType')) document.getElementById('estPackageType').innerText = desc;
            if (document.getElementById('estDimensions')) document.getElementById('estDimensions').innerText = `${l} × ${w} × ${h} ft`;
            if (document.getElementById('estSingleWeight')) document.getElementById('estSingleWeight').innerText = `${sw.toFixed(1)} kg`;
            if (document.getElementById('estQuantity')) document.getElementById('estQuantity').innerText = `${q} ${q > 1 ? 'units' : 'unit'}`;
            if (document.getElementById('estWeight')) document.getElementById('estWeight').innerText = `${totalWt.toFixed(1)} kg`;
            if (document.getElementById('estVolume')) document.getElementById('estVolume').innerText = `${totalCft.toFixed(2)} CFT`;
            if (document.getElementById('estVolumeMultiplier')) {
                const vm = (totalCft < 1000) ? 1.0 : (totalCft < 2000) ? 1.25 : (totalCft < 3000) ? 1.40 : 1.50;
                const tierLabel = vm === 1.0 ? ' (<1000 CFT)' : vm === 1.25 ? ' (<2000 CFT)' : vm === 1.40 ? ' (<3000 CFT)' : ' (≥3000 CFT)';
                document.getElementById('estVolumeMultiplier').innerText = vm.toFixed(2) + '×' + tierLabel;
            }
        }

        // Doorstep addresses are collected only and do not impact the map
        document.getElementById('dropoffAddr')?.addEventListener('input', () => {
            updateWarehouseWarningNotice(lastEstimateData);
        });
        document.getElementById('singleItemWeight')?.addEventListener('input', () => {
            calculateWeight();
            debouncedUpdate();
        });
        document.getElementById('packageName')?.addEventListener('input', updateDimensionsDisplay);
        document.getElementById('parcelDescription')?.addEventListener('change', updateDimensionsDisplay);
        document.getElementById('packageLength')?.addEventListener('input', () => {
            calculateVolume();
            debouncedUpdate();
        });
        document.getElementById('packageWidth')?.addEventListener('input', () => {
            calculateVolume();
            debouncedUpdate();
        });
        document.getElementById('packageHeight')?.addEventListener('input', () => {
            calculateVolume();
            debouncedUpdate();
        });
        document.getElementById('packageQuantity')?.addEventListener('input', () => {
            calculateWeight();
            calculateVolume();
            debouncedUpdate();
        });

        document.getElementById('editSingleWeight')?.addEventListener('input', calculateEditWeight);
        document.getElementById('editLength')?.addEventListener('input', calculateEditVolume);
        document.getElementById('editWidth')?.addEventListener('input', calculateEditVolume);
        document.getElementById('editHeight')?.addEventListener('input', calculateEditVolume);
        document.getElementById('editQuantity')?.addEventListener('input', () => {
            calculateEditWeight();
            calculateEditVolume();
        });

        function getEstimatedDaysForType(type) {
            if (!type) return "4 to 6 days";
            const lower = type.toLowerCase();
            if (lower.includes("express")) return "1 to 2 days";
            if (lower.includes("fast")) return "2 to 3 days";
            return "4 to 6 days";
        }
        document.getElementById('deliveryType')?.addEventListener('change', function() {
            const daysEl = document.getElementById('estDeliveryDays');
            if (daysEl) daysEl.innerText = getEstimatedDaysForType(this.value);
            updateAiEstimate();
        });
        document.getElementById('originDoorstep')?.addEventListener('change', toggleOriginPickupMode);
        document.getElementById('originWarehouse')?.addEventListener('change', toggleOriginPickupMode);
        document.getElementById('originWarehouseSelect')?.addEventListener('change', onOriginWarehouseChanged);
        document.getElementById('destDoorstep')?.addEventListener('change', toggleDestinationDeliveryMode);
        document.getElementById('destWarehouse')?.addEventListener('change', toggleDestinationDeliveryMode);
        document.getElementById('destWarehouseSelect')?.addEventListener('change', onDestWarehouseChanged);

        // Fix map tile rendering when switching between tabs
        document.getElementById('new-delivery-tab')?.addEventListener('shown.bs.tab', () => {
            if (map) {
                setTimeout(() => map.invalidateSize(), 150);
            }
        });

        // Run on page load
        document.addEventListener('DOMContentLoaded', () => {
            initRouteMap();
            toggleOriginPickupMode();
            toggleDestinationDeliveryMode();
            updateWarehouseWarningNotice(null);
            calculateWeight();
            calculateVolume();
            updateDimensionsDisplay();
            updateAiEstimate();
        });
    </script>
}
