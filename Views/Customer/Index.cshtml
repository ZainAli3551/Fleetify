        function showDeliveryNoticeModal() {
            const form = document.getElementById('deliveryForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const isDoorstep = document.getElementById('originDoorstep')?.checked;
            const originWhSelect = document.getElementById('originWarehouseSelect');
            const pickupInput = document.getElementById('pickupAddr');

            if (!isDoorstep && originWhSelect && pickupInput) {
                pickupInput.value = originWhSelect.value;
            }

            const isDestDoorstep = document.getElementById('destDoorstep')?.checked;
            const destWhSelect = document.getElementById('destWarehouseSelect');
            const dropoffInput = document.getElementById('dropoffAddr');

            if (!isDestDoorstep && destWhSelect && dropoffInput) {
                dropoffInput.value = destWhSelect.value;
            }

            const destSelectedOpt = destWhSelect?.selectedOptions[0];
            const isNoWarehouse = destSelectedOpt?.getAttribute('data-no-warehouse') === 'true';
            if (!isDestDoorstep && isNoWarehouse) {
                const cityName = destSelectedOpt?.getAttribute('data-city') || 'this city';
                alert(`Fleetify does not operate a warehouse in ${cityName}. Warehouse self-pickup is not available here; please choose Doorstep Delivery instead.`);
                return;
