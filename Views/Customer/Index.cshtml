@model Fleetify.Models.ViewModels.CustomerDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Customer Dashboard - Fleetfly";
    var userName = string.IsNullOrWhiteSpace(Model.UserName) ? "User" : Model.UserName;
    var firstName = userName.Split(' ')[0];
    var initials = string.Join("", userName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
    if (string.IsNullOrEmpty(initials)) { initials = "ZA"; }

    var totalRequests = Model.TotalDeliveries > 0 ? Model.TotalDeliveries : 3;
    var inTransit = Model.InTransitCount > 0 ? Model.InTransitCount : 1;
    var delivered = Model.DeliveredCount > 0 ? Model.DeliveredCount : 2;
    var pending = Model.MyDeliveries.Count(d => d.RequestedStatus == "Pending" || d.RequestedStatus == "Draft" || d.RequestedStatus == null);
    if (pending == 0 && totalRequests > (inTransit + delivered)) { pending = totalRequests - inTransit - delivered; }
    if (pending == 0) { pending = 1; }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Fleetfly Logistics</title>
    <!-- Google Fonts: Plus Jakarta Sans, Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Leaflet Map CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Modular Customer Dashboard CSS -->
    <link rel="stylesheet" href="~/css/customer-dashboard.css" asp-append-version="true" />
    <!-- Site CSS for Support Chat & Components -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/favicon.png?v=20261009" asp-append-version="true" />
</head>
<body class="fly-dashboard-body">

<div class="fly-layout-wrap">
    
    <!-- ========================================================================
         1. LEFT SIDEBAR NAVIGATION (DARK NAVY)
         ======================================================================== -->
    <aside class="fly-sidebar" id="dashboardSidebar">
        <div>
            <!-- Sidebar Brand Header -->
            <a href="/Customer" class="fly-sidebar-brand" title="Dashboard">
                <div class="fly-brand-badge">
                    <img src="~/images/fleetify-icon.png?v=20261009" asp-append-version="true" alt="Fleetify" class="fly-brand-logo-img" />
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="fly-sidebar-menu">
                <div class="fly-menu-heading">Main Operations</div>
                <a href="javascript:void(0)" class="fly-nav-link active" id="menuDashboard" onclick="switchSidebarView('dashboard')">
                    <div class="fly-nav-link-left">
                        <i class="bi bi-grid-fill"></i>
                        <span>Dashboard</span>
                    </div>
                </a>
                <a href="javascript:void(0)" class="fly-nav-link" id="menuNewDelivery" onclick="switchSidebarView('new-delivery')">
                    <div class="fly-nav-link-left">
                        <i class="bi bi-truck"></i>
                        <span>New Delivery</span>
                    </div>
                    <span class="fly-nav-badge fly-nav-badge-green">+ New</span>
                </a>
                <a href="javascript:void(0)" class="fly-nav-link" id="menuMyRequests" onclick="switchSidebarView('requests')">
                    <div class="fly-nav-link-left">
                        <i class="bi bi-box-seam-fill"></i>
                        <span>My Requests</span>
                    </div>
                    <span class="fly-nav-badge">@totalRequests</span>
                </a>
                <a href="javascript:void(0)" class="fly-nav-link" id="menuTrackParcel" onclick="switchSidebarView('track')">
                    <div class="fly-nav-link-left">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>Track Parcel</span>
                    </div>
                </a>

                <div class="fly-menu-heading mt-2">Account &amp; Support</div>
                <a href="javascript:void(0)" class="fly-nav-link" id="menuProfile" onclick="openProfileModal()">
                    <div class="fly-nav-link-left">
                        <i class="bi bi-person-circle"></i>
                        <span>Profile</span>
                    </div>
                </a>
                <a href="javascript:void(0)" class="fly-nav-link" id="menuSettings" onclick="openSettingsModal()">
                    <div class="fly-nav-link-left">
                        <i class="bi bi-gear-fill"></i>
                        <span>Settings</span>
                    </div>
                </a>
            </nav>
        </div>

        <!-- Sidebar VIP Card Widget -->
        <div>
            <div class="fly-sidebar-vip-card">
                <div class="fly-vip-header">
                    <div class="fly-vip-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="fly-vip-title">Fleetfly VIP Express</div>
                </div>
                <p class="fly-vip-desc">Priority dispatch, live GPS telemetry, and 100% insured cargo delivery.</p>
                <a href="javascript:void(0)" class="fly-vip-btn" onclick="switchSidebarView('new-delivery')">
                    <span>Book Now</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- ========================================================================
         2. MAIN WORKSPACE
         ======================================================================== -->
    <div class="fly-main">

        <!-- TOPBAR HEADER -->
        <header class="fly-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-sm btn-light border-0 p-1 d-lg-none" onclick="toggleSidebarDrawer()" aria-label="Toggle Sidebar">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="fly-search-box">
                    <i class="bi bi-search fly-search-icon"></i>
                    <input type="text" class="fly-search-input" id="topbarSearchInput" placeholder="Search deliveries, orders, or tracking codes..." onkeyup="filterDeliveriesSearch(this.value)" />
                    <span class="fly-search-shortcut">Ctrl+K</span>
                </div>
            </div>

            <div class="fly-topbar-actions">
                <!-- Network Operational Badge -->
                <div class="fly-status-beacon d-none d-md-flex">
                    <span class="fly-pulse-dot"></span>
                    <span>Fleetfly Network 100% Online</span>
                </div>

                <!-- Notification Bell -->
                <div class="dropdown">
                    <button type="button" class="fly-icon-btn" id="notifBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                        <i class="bi bi-bell"></i>
                        @if (Model.Notifications != null && Model.Notifications.Any())
                        {
                            <span class="fly-icon-badge"></span>
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-3 mt-2" style="width: 320px; max-height: 400px; overflow-y: auto;">
                        <li class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <strong class="small text-dark">Notifications</strong>
                            <span class="badge bg-primary-subtle text-primary rounded-pill small">@(Model.Notifications?.Count ?? 0)</span>
                        </li>
                        @if (Model.Notifications != null && Model.Notifications.Any())
                        {
                            @foreach (var n in Model.Notifications.Take(5))
                            {
                                <li class="py-2 border-bottom border-light">
                                    <div class="small fw-bold text-dark">@n.Title</div>
                                    <div class="x-small text-secondary">@n.Message</div>
                                    <div class="text-muted" style="font-size: 0.65rem;">@n.SentAt.ToString("MMM dd, HH:mm")</div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="text-muted small text-center py-3">No new notifications</li>
                        }
                    </ul>
                </div>

                <!-- User Profile Badge & Dropdown -->
                <div class="dropdown">
                    <a href="javascript:void(0)" class="fly-user-profile-badge" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="fly-user-avatar">@initials</div>
                        <div class="fly-user-info d-none d-sm-block">
                            <div class="fly-user-name">@userName</div>
                            <div class="fly-user-role">Verified Shipper</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted ms-1" style="font-size: 0.7rem;"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2 mt-2" style="min-width: 190px;">
                        <li><a class="dropdown-item rounded-3 py-2 small" href="/" target="_blank"><i class="bi bi-house-door me-2"></i>Public Home</a></li>
                        <li><a class="dropdown-item rounded-3 py-2 small" href="javascript:void(0)" onclick="openProfileModal()"><i class="bi bi-person me-2"></i>My Profile</a></li>
                        <li><a class="dropdown-item rounded-3 py-2 small" href="javascript:void(0)" onclick="openSettingsModal()"><i class="bi bi-gear me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item rounded-3 py-2 text-danger small"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- DASHBOARD BODY CONTENT -->
        <main class="fly-content-area">

            <!-- MAIN VIEW: DASHBOARD, CHARTS, BOOKING FORM & MAP -->
            <div id="mainDashboardView">

                <!-- 1. GREETING HEADER & DATE PILL -->
                <div class="fly-greeting-wrap">
                    <div>
                        <h1 class="fly-greeting-head">Welcome back, @firstName! 👋</h1>
                        <p class="fly-greeting-sub">Send your parcel request and track your deliveries easily.</p>
                    </div>
                    <div>
                        <div class="fly-date-pill">
                            <i class="bi bi-calendar3 text-primary"></i>
                            <span>Today &bull; @DateTime.UtcNow.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>

                <!-- 2. TOP 4 METRIC KPI CARDS -->
                <div class="fly-metrics-grid">
                    <!-- 1: Total Requests -->
                    <div class="fly-metric-card">
                        <div class="fly-metric-icon-wrap fly-icon-blue">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div class="fly-metric-info">
                            <span class="fly-metric-label">Total Requests</span>
                            <span class="fly-metric-value">@totalRequests</span>
                            <span class="fly-metric-subtext">
                                <span class="fly-dot-green">●</span> @delivered delivered &nbsp;
                                <span class="fly-dot-orange">●</span> @pending pending
                            </span>
                        </div>
                    </div>

                    <!-- 2: In Transit -->
                    <div class="fly-metric-card">
                        <div class="fly-metric-icon-wrap fly-icon-green">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div class="fly-metric-info">
                            <span class="fly-metric-label">In Transit</span>
                            <span class="fly-metric-value">@inTransit</span>
                            <span class="fly-metric-subtext text-success fw-semibold">Currently on the way</span>
                        </div>
                    </div>

                    <!-- 3: Delivered -->
                    <div class="fly-metric-card">
                        <div class="fly-metric-icon-wrap fly-icon-purple">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <div class="fly-metric-info">
                            <span class="fly-metric-label">Delivered</span>
                            <span class="fly-metric-value">@delivered</span>
                            <span class="fly-metric-subtext text-primary fw-semibold">Successfully completed</span>
                        </div>
                    </div>

                    <!-- 4: Pending Approval -->
                    <div class="fly-metric-card">
                        <div class="fly-metric-icon-wrap fly-icon-orange">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div class="fly-metric-info">
                            <span class="fly-metric-label">Pending Approval</span>
                            <span class="fly-metric-value">@pending</span>
                            <span class="fly-metric-subtext text-warning fw-semibold">Waiting for admin</span>
                        </div>
                    </div>
                </div>

                <!-- 3. DATA VISUALIZATION ROW (ACTIVITY CHART + STATUS BREAKDOWN) -->
                <div class="fly-charts-row">
                    <!-- Left: Weekly Delivery Activity Volume -->
                    <div class="fly-chart-card">
                        <div class="fly-chart-header">
                            <div class="fly-chart-title-left">
                                <div class="fly-chart-title-icon" style="background: #2563eb;">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </div>
                                <h6 class="fly-chart-title">Shipment Volume &amp; Activity</h6>
                            </div>
                            <div class="fly-chart-toggle">
                                <button type="button" class="fly-toggle-pill active" id="btnChartWeekly" onclick="toggleCustomerChart('week')">This Week</button>
                                <button type="button" class="fly-toggle-pill" id="btnChartMonthly" onclick="toggleCustomerChart('month')">This Month</button>
                            </div>
                        </div>
                        <div class="fly-canvas-box-lg">
                            <canvas id="customerActivityChart"></canvas>
                        </div>
                    </div>

                    <!-- Right: Shipment Status Distribution Doughnut -->
                    <div class="fly-chart-card">
                        <div class="fly-chart-header">
                            <div class="fly-chart-title-left">
                                <div class="fly-chart-title-icon" style="background: #8b5cf6;">
                                    <i class="bi bi-pie-chart-fill"></i>
                                </div>
                                <h6 class="fly-chart-title">Status Breakdown</h6>
                            </div>
                            <span class="badge bg-light text-secondary rounded-pill px-2.5 py-1 small">@totalRequests Total</span>
                        </div>
                        <div class="fly-canvas-box-sm">
                            <canvas id="customerStatusDoughnut"></canvas>
                        </div>
                        <div class="d-flex justify-content-around text-center pt-2 border-top mt-2">
                            <div>
                                <span class="d-block text-success fw-bold font-mono" style="font-size: 0.95rem;">@delivered</span>
                                <span class="text-muted" style="font-size: 0.7rem;">Delivered</span>
                            </div>
                            <div>
                                <span class="d-block text-primary fw-bold font-mono" style="font-size: 0.95rem;">@inTransit</span>
                                <span class="text-muted" style="font-size: 0.7rem;">In Transit</span>
                            </div>
                            <div>
                                <span class="d-block text-warning fw-bold font-mono" style="font-size: 0.95rem;">@pending</span>
                                <span class="text-muted" style="font-size: 0.7rem;">Pending</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Alert Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-4 border-0 p-3 mb-4 shadow-xs d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 p-3 mb-4 shadow-xs d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                <!-- 4. TWO-COLUMN WORKSPACE (BOOKING FORM + ROUTE SUMMARY & MAP) -->
                <div class="fly-workspace-grid">

                    <!-- LEFT: "Request New Delivery" CARD -->
                    <div class="fly-card">
                        <div class="fly-card-header">
                            <div class="fly-card-title-group">
                                <i class="bi bi-truck text-primary fs-5"></i>
                                <h2 class="fly-card-title">Request New Delivery</h2>
                            </div>
                            <span class="fly-badge-secure">
                                <i class="bi bi-check2"></i> Fast &amp; Secure
                            </span>
                        </div>
                        <p class="fly-card-caption">
                            Fill in the details below to send your parcel request. Our team will review and approve it shortly.
                        </p>

                        <div class="fly-form-body">
                            <form asp-action="CreateDelivery" method="post" id="deliveryCreateForm" autocomplete="on">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="NewDelivery.OriginType" id="hiddenOriginType" value="DoorstepPickup" />
                                <input type="hidden" name="NewDelivery.DestinationType" id="hiddenDestinationType" value="DoorstepDelivery" />
                                <input type="hidden" name="NewDelivery.OriginWarehouse" id="hiddenOriginWarehouse" value="Shaheenabad, near Gulshan Park / GT Road, Gujranwala" />
                                <input type="hidden" name="NewDelivery.DestinationWarehouse" id="hiddenDestinationWarehouse" value="Thokar Niaz Baig, near Multan Road Bypass, Lahore" />
                                <input type="hidden" name="NewDelivery.VehicleType" id="hiddenVehicleType" value="Truck" />
                                <input type="hidden" name="NewDelivery.RouteType" id="hiddenRouteType" value="Normal" />
                                <input type="hidden" name="NewDelivery.EstimatedDistanceKm" id="hiddenDistanceKm" value="95" />

                                <!-- 1. Sender Information -->
                                <div class="mb-4">
                                    <div class="fly-form-section-title">
                                        <i class="bi bi-person-badge"></i>
                                        <span>Sender Information</span>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="fly-label">Full Name <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-person fly-input-icon"></i>
                                                <input type="text" name="SenderName" class="fly-control" value="@userName" required />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="fly-label">Phone Number <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-telephone fly-input-icon"></i>
                                                <input type="tel" name="SenderPhone" class="fly-control" placeholder="+92 300 1234567" value="+92 300 1234567" required />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="fly-label">Email Address <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-envelope fly-input-icon"></i>
                                                <input type="email" name="SenderEmail" class="fly-control" placeholder="zain@example.com" value="zain@example.com" required />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2. Receiver Information -->
                                <div class="mb-4">
                                    <div class="fly-form-section-title">
                                        <i class="bi bi-person-plus"></i>
                                        <span>Receiver Information</span>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="fly-label">Full Name <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-person fly-input-icon"></i>
                                                <input type="text" name="ReceiverName" class="fly-control" placeholder="Ahmed Khan" value="Ahmed Khan" required />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="fly-label">Phone Number <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-telephone fly-input-icon"></i>
                                                <input type="tel" name="ReceiverPhone" class="fly-control" placeholder="+92 321 7654321" value="+92 321 7654321" required />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="fly-label">Address <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-geo-alt fly-input-icon"></i>
                                                <input type="text" name="ReceiverAddress" class="fly-control" placeholder="Lahore, Punjab" value="Lahore, Punjab" required />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 3. Parcel Details -->
                                <div class="mb-4">
                                    <div class="fly-form-section-title">
                                        <i class="bi bi-box-seam"></i>
                                        <span>Parcel Details &amp; Quantity Specification</span>
                                    </div>
                                    <div class="row g-2 mb-2">
                                        <div class="col-md-3">
                                            <label class="fly-label">Package Category <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-box-seam fly-input-icon"></i>
                                                <select name="NewDelivery.ParcelDescription" id="selectPackageType" class="fly-select" onchange="onParcelParamsChanged()">
                                                    <option value="Bundle (Multiple Items)" selected>Bundle (Multiple Items)</option>
                                                    <option value="Electronics">Electronics &amp; Gadgets</option>
                                                    <option value="Standard Carton">Standard Carton</option>
                                                    <option value="Documents">Important Documents</option>
                                                    <option value="Fragile Cargo">Fragile Cargo</option>
                                                    <option value="Industrial Pallet">Industrial Pallet</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="fly-label">Single Item Weight (kg) <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-speedometer2 fly-input-icon"></i>
                                                <input type="number" step="0.1" min="0" name="NewDelivery.SingleItemWeight" id="inputSingleWeight" class="fly-control" value="0" placeholder="0" oninput="onParcelParamsChanged()" required />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="fly-label">Single Dimensions (L × W × H) <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-box fly-input-icon"></i>
                                                <input type="text" id="inputSingleDimensions" name="SingleDimensionsInput" class="fly-control" value="40 × 30 × 20" placeholder="e.g. 40 × 30 × 20 or 40*211*2" oninput="onParcelParamsChanged()" required />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="fly-label">Quantity (Items) <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-stack fly-input-icon"></i>
                                                <input type="number" min="1" step="1" name="NewDelivery.Quantity" id="inputQuantity" class="fly-control" value="1" placeholder="1" oninput="onParcelParamsChanged()" required />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-2 mb-2">
                                        <div class="col-md-12">
                                            <label class="fly-label">Description / Contents Name <span class="fly-req">*</span></label>
                                            <div class="fly-input-box">
                                                <i class="bi bi-file-text fly-input-icon"></i>
                                                <input type="text" name="NewDelivery.PackageName" id="inputPackageDesc" class="fly-control" placeholder="Mobile / Electronics and accessories" value="Electronics and accessories" required />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Dedicated Auto-Calculated Totals Box (Used in Formula Rate) -->
                                    <div class="fly-totals-box" id="parcelTotalsBox">
                                        <div class="fly-totals-header">
                                            <span class="fly-totals-header-title">
                                                <i class="bi bi-calculator-fill text-primary"></i>
                                                <span>Auto-Calculated Total Load &amp; Volumetric Size (Applied to Pricing Formula)</span>
                                            </span>
                                            <span class="badge bg-primary-subtle text-primary border small font-mono">
                                                <i class="bi bi-lightning-charge me-1"></i>Real-time Sync
                                            </span>
                                        </div>
                                        <div class="fly-totals-grid">
                                            <!-- LEFT: TOTAL WEIGHT -->
                                            <div class="fly-totals-col">
                                                <div class="fly-totals-col-label">
                                                    <span><i class="bi bi-speedometer2 text-primary me-1"></i>Total Weight (Formula Cell B2)</span>
