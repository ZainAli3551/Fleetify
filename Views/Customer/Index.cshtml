@model Fleetify.Models.ViewModels.CustomerDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Customer Dashboard - Fleetify";
    var userName = string.IsNullOrWhiteSpace(Model.UserName) ? "User" : Model.UserName;
    var firstName = userName.Split(' ')[0];
    var initials = string.Join("", userName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
    if (string.IsNullOrEmpty(initials)) { initials = "ZA"; }

    var totalRequests = Model.TotalDeliveries > 0 ? Model.TotalDeliveries : 3;
    var inTransit = Model.InTransitCount > 0 ? Model.InTransitCount : 1;
    var delivered = Model.DeliveredCount > 0 ? Model.DeliveredCount : 2;
    var pending = Model.MyDeliveries.Count(d => d.RequestedStatus == "Pending" || d.RequestedStatus == "Draft" || d.RequestedStatus == null);
    if (pending == 0 && totalRequests > (inTransit + delivered)) { pending = totalRequests - inTransit - delivered; }
    if (pending == 0) { pending = 1; }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Fleetify</title>
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Leaflet Map CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/favicon.png?v=20261009" asp-append-version="true" />
    <!-- Site CSS for Support Chat & Components -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --sidebar-bg: #0b1329;
            --sidebar-hover: #16203d;
            --sidebar-active: #2563eb;
            --body-bg: #f4f6fa;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --primary-blue: #2563eb;
            --primary-blue-hover: #1d4ed8;
            --success-green: #10b981;
            --warning-orange: #f59e0b;
            --purple-accent: #8b5cf6;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--body-bg);
            color: var(--text-dark);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* --------------------------------------------------------------------------
           MAIN LAYOUT WRAPPER
           -------------------------------------------------------------------------- */
        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        /* --------------------------------------------------------------------------
           SIDEBAR
           -------------------------------------------------------------------------- */
        .dashboard-sidebar {
            width: 250px;
            background-color: var(--sidebar-bg);
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1040;
            transition: all 0.3s ease;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.12);
        }

        .sidebar-brand {
            padding: 1.5rem 1.25rem 1.25rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .sidebar-logo {
            height: 38px;
            width: auto;
        }

        .sidebar-brand-name {
            font-size: 1.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }

        .sidebar-brand-sub {
            font-size: 0.65rem;
            color: #94a3b8;
            letter-spacing: 0.04em;
        }

        .sidebar-menu {
            padding: 1.25rem 0.85rem;
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.75rem 1rem;
            color: #94a3b8;
            font-size: 0.925rem;
            font-weight: 600;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .sidebar-item i {
            font-size: 1.15rem;
            transition: transform 0.2s ease;
        }

        .sidebar-item:hover {
            background-color: var(--sidebar-hover);
            color: #ffffff;
        }

        .sidebar-item.active {
            background-color: var(--sidebar-active);
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        }

        /* Bottom Sidebar Artwork Widget */
        .sidebar-footer-widget {
            padding: 1rem 0.85rem 1.25rem 0.85rem;
        }

        .sidebar-truck-card {
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.4) 0%, rgba(7, 13, 27, 0.9) 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 0.75rem;
            position: relative;
            overflow: hidden;
            text-align: center;
        }

        .sidebar-truck-img {
            width: 100%;
            height: 80px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 0.5rem;
            filter: brightness(0.9);
        }

        .sidebar-truck-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 0.15rem;
        }

        .sidebar-truck-desc {
            font-size: 0.7rem;
            color: #38bdf8;
            letter-spacing: 0.02em;
        }

        /* --------------------------------------------------------------------------
           MAIN CONTENT AREA
           -------------------------------------------------------------------------- */
        .dashboard-main {
            margin-left: 250px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: var(--body-bg);
            transition: margin-left 0.3s ease;
        }

        /* Topbar Header */
        .dashboard-topbar {
            height: 70px;
            background-color: #ffffff;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .topbar-search-box {
            position: relative;
            max-width: 420px;
            width: 100%;
        }

        .topbar-search-input {
            width: 100%;
            height: 44px;
            border-radius: 9999px;
            background-color: #f8fafc;
            border: 1.5px solid #e2e8f0;
            padding: 0 1.25rem 0 2.75rem;
            font-size: 0.875rem;
            color: var(--text-dark);
            outline: none;
            transition: all 0.2s ease;
        }

        .topbar-search-input:focus {
            background-color: #ffffff;
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .topbar-search-icon {
            position: absolute;
            left: 1.15rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.95rem;
            pointer-events: none;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .notification-btn {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #475569;
            font-size: 1.15rem;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }

        .notification-btn:hover {
            background-color: #f1f5f9;
            color: var(--primary-blue);
        }

        .notification-badge {
            position: absolute;
            top: 7px;
            right: 7px;
            width: 8px;
            height: 8px;
            background-color: #ef4444;
            border-radius: 50%;
            border: 2px solid #ffffff;
        }

        .user-profile-badge {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            padding: 0.35rem 0.65rem;
            border-radius: 9999px;
            transition: background-color 0.2s ease;
            text-decoration: none;
        }

        .user-profile-badge:hover {
            background-color: #f8fafc;
        }

        .user-avatar-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        .user-info-text {
            line-height: 1.2;
            text-align: left;
        }

        .user-display-name {
            font-weight: 700;
            font-size: 0.875rem;
            color: var(--text-dark);
            display: block;
        }

        .user-display-role {
            font-size: 0.725rem;
            color: var(--text-muted);
            font-weight: 500;
            display: block;
        }

        /* --------------------------------------------------------------------------
           DASHBOARD BODY
           -------------------------------------------------------------------------- */
        .dashboard-content-area {
            padding: 2rem 2.25rem;
            flex: 1;
        }

        /* Welcome Greeting */
        .welcome-heading {
            font-size: 1.85rem;
            font-weight: 800;
            color: var(--text-dark);
            letter-spacing: -0.025em;
            margin-bottom: 0.25rem;
        }

        .welcome-sub {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-bottom: 1.75rem;
        }

        /* --------------------------------------------------------------------------
           TOP 4 METRICS CARDS
           -------------------------------------------------------------------------- */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
            margin-bottom: 2rem;
        }

        .metric-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 1.35rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 1.15rem;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .metric-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
        }

        .metric-icon-wrap {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.45rem;
            flex-shrink: 0;
        }

        .metric-icon-blue { background-color: #2563eb; color: #ffffff; }
        .metric-icon-green { background-color: #10b981; color: #ffffff; }
        .metric-icon-purple { background-color: #8b5cf6; color: #ffffff; }
        .metric-icon-orange { background-color: #f59e0b; color: #ffffff; }

        .metric-details {
            display: flex;
            flex-direction: column;
        }

        .metric-label {
            font-size: 0.825rem;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 0.15rem;
        }

        .metric-value {
            font-size: 1.65rem;
            font-weight: 800;
            color: var(--text-dark);
            line-height: 1.1;
            margin-bottom: 0.25rem;
        }

        .metric-sub {
            font-size: 0.75rem;
            color: #94a3b8;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .dot-delivered { color: #10b981; }
        .dot-pending { color: #f59e0b; }

        /* --------------------------------------------------------------------------
           MAIN TWO-COLUMN DASHBOARD GRID (FORM + SUMMARY & MAP)
           -------------------------------------------------------------------------- */
        .dashboard-two-col {
            display: grid;
            grid-template-columns: 1.65fr 1fr;
            gap: 1.5rem;
            align-items: start;
        }

        .dash-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
            overflow: hidden;
        }

        .card-header-clean {
            padding: 1.5rem 1.75rem 0.75rem 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-title-group {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .card-title-icon {
            color: var(--primary-blue);
            font-size: 1.25rem;
        }

        .card-title-text {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0;
        }

        .card-subtext {
            font-size: 0.825rem;
            color: var(--text-muted);
            margin: 0.25rem 0 1.25rem 0;
            padding: 0 1.75rem;
        }

        .badge-fast-secure {
            background-color: #ecfdf5;
            color: #059669;
            font-weight: 600;
            font-size: 0.75rem;
            border-radius: 9999px;
            padding: 0.35rem 0.85rem;
            border: 1px solid #a7f3d0;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        /* Form Sub-Sections */
        .form-section-header {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--primary-blue);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.85rem;
        }

        .custom-input-box {
            position: relative;
            display: flex;
            align-items: center;
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            height: 48px;
            padding: 0 0.85rem;
            transition: all 0.2s ease;
        }

        .custom-input-box:focus-within {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .input-icon {
            color: #94a3b8;
            font-size: 1rem;
            margin-right: 0.65rem;
            flex-shrink: 0;
        }

        .custom-input-box:focus-within .input-icon {
            color: var(--primary-blue);
        }

        .custom-form-control {
            border: none !important;
            outline: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-dark);
            padding: 0;
        }

        .custom-form-control::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        .custom-select-control {
            border: none !important;
            outline: none !important;
            background: transparent !important;
            width: 100%;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-dark);
            cursor: pointer;
        }

        .custom-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 0.35rem;
            display: block;
        }

        .req-star { color: #ef4444; }

        .custom-textarea {
            width: 100%;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-dark);
            outline: none;
            resize: none;
            height: 75px;
            transition: all 0.2s ease;
        }

        .custom-textarea:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .btn-submit-request {
            width: 100%;
            height: 50px;
            border-radius: 12px;
            background-color: var(--primary-blue);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            box-shadow: 0 8px 18px -3px rgba(37, 99, 235, 0.35);
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-submit-request:hover {
            background-color: var(--primary-blue-hover);
            transform: translateY(-1.5px);
            box-shadow: 0 12px 24px -3px rgba(37, 99, 235, 0.45);
        }

        /* --------------------------------------------------------------------------
           RIGHT COLUMN CARDS (SUMMARY & LIVE MAP)
           -------------------------------------------------------------------------- */
        .summary-route-box {
            background-color: #f8fafc;
            border: 1px solid #edf2f7;
            border-radius: 16px;
            padding: 1.25rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
        }

        .route-stop {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .route-pin {
            font-size: 1.35rem;
        }

        .route-city-name {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.1;
        }

        .route-city-tag {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .route-arrow-connector {
            display: flex;
            align-items: center;
            color: #94a3b8;
            font-size: 0.85rem;
            letter-spacing: 2px;
            font-weight: bold;
        }

        .summary-stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.75rem;
            text-align: center;
            padding-top: 0.5rem;
        }

        .summary-stat-cell {
            padding: 0.5rem;
            border-radius: 10px;
            background: #fafafa;
        }

        .stat-icon-label {
            font-size: 0.725rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            margin-bottom: 0.25rem;
        }

        .stat-main-value {
            font-size: 0.875rem;
            font-weight: 700;
            color: var(--text-dark);
        }

        /* Map Card */
        #routeLiveMap {
            width: 100%;
            height: 250px;
            border-radius: 0;
            z-index: 1;
        }

        .map-safety-banner {
            background-color: #ffffff;
            padding: 1rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--border-color);
        }

        .safety-badge-text {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .safety-badge-icon {
            color: #10b981;
            font-size: 1.5rem;
        }

        .safety-title {
            font-size: 0.825rem;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0;
        }

        .safety-sub {
            font-size: 0.725rem;
            color: var(--text-muted);
            margin: 0;
        }

        /* --------------------------------------------------------------------------
           BOTTOM FOOTER
           -------------------------------------------------------------------------- */
        .dashboard-footer {
            background-color: #060d21;
            color: #ffffff;
            padding: 1.25rem 2.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            margin-top: auto;
        }

        .footer-brand {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .footer-links {
            display: flex;
            align-items: center;
            gap: 1.75rem;
        }

        .footer-link-item {
            color: #94a3b8;
            font-size: 0.85rem;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .footer-link-item:hover {
            color: #ffffff;
        }

        .footer-social-wrap {
            display: flex;
            align-items: center;
            gap: 1.15rem;
            color: #94a3b8;
        }

        .footer-social-icon {
            color: #94a3b8;
            text-decoration: none;
            font-size: 1rem;
            transition: color 0.2s ease;
        }

        .footer-social-icon:hover {
            color: #38bdf8;
        }

        /* --------------------------------------------------------------------------
           RESPONSIVE MEDIA QUERIES
           -------------------------------------------------------------------------- */
        @@media (max-width: 1200px) {
            .metrics-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .dashboard-two-col {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 991.98px) {
            .dashboard-sidebar {
                transform: translateX(-100%);
            }
            .dashboard-sidebar.show {
                transform: translateX(0);
            }
            .dashboard-main {
                margin-left: 0;
            }
            .dashboard-content-area {
                padding: 1.5rem 1rem;
            }
            .dashboard-topbar {
                padding: 0 1rem;
            }
            .dashboard-footer {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
        }

        @@media (max-width: 575.98px) {
            .metrics-grid {
                grid-template-columns: 1fr;
            }
            .topbar-search-box {
                display: none;
            }
        }
    </style>
</head>
<body>

<div class="dashboard-container">
    
    <!-- ========================================================================
         LEFT SIDEBAR (MATCHING SCREENSHOT)
         ======================================================================== -->
    <aside class="dashboard-sidebar" id="dashboardSidebar">
        <div>
            <!-- Sidebar Brand Header -->
            <a href="/" class="sidebar-brand">
                <img src="~/images/fleetify-brand-logo.png?v=20261009" asp-append-version="true" alt="Fleetify" class="sidebar-logo" style="height: 38px; width: auto; border-radius: 8px; padding: 3px 8px; background: #ffffff;" />
            </a>

            <!-- Navigation Links -->
            <nav class="sidebar-menu">
                <a href="javascript:void(0)" class="sidebar-item active" id="menuDashboard" onclick="switchSidebarView('dashboard')">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>
                <a href="javascript:void(0)" class="sidebar-item" id="menuNewDelivery" onclick="switchSidebarView('new-delivery')">
                    <i class="bi bi-truck"></i>
                    <span>New Delivery</span>
                </a>
                <a href="javascript:void(0)" class="sidebar-item" id="menuMyRequests" onclick="switchSidebarView('requests')">
                    <i class="bi bi-list-ul"></i>
                    <span>My Requests</span>
                </a>
                <a href="javascript:void(0)" class="sidebar-item" id="menuTrackParcel" onclick="switchSidebarView('track')">
                    <i class="bi bi-geo-alt"></i>
                    <span>Track Parcel</span>
                </a>
                <a href="javascript:void(0)" class="sidebar-item" id="menuProfile" onclick="openProfileModal()">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>
                <a href="javascript:void(0)" class="sidebar-item" id="menuSettings" onclick="openSettingsModal()">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>
            </nav>
        </div>

        <!-- Bottom Sidebar Widget Artwork -->
        <div class="sidebar-footer-widget">
            <div class="sidebar-truck-card">
                <img src="~/images/fleet-sidebar-truck.jpg" alt="Fleetify Logistics" class="sidebar-truck-img" />
                <div class="sidebar-truck-title">Fleetify</div>
                <div class="sidebar-truck-desc">Your Cargo, Our Priority</div>
            </div>
        </div>
    </aside>

    <!-- ========================================================================
         MAIN CONTENT AREA
         ======================================================================== -->
    <div class="dashboard-main">

        <!-- TOPBAR HEADER -->
        <header class="dashboard-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-sm btn-light border-0 p-1 d-lg-none" onclick="toggleSidebarDrawer()" aria-label="Toggle Sidebar">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="topbar-search-box">
                    <i class="bi bi-search topbar-search-icon"></i>
                    <input type="text" class="topbar-search-input" id="topbarSearchInput" placeholder="Search for deliveries, orders, or locations..." onkeyup="filterDeliveriesSearch(this.value)" />
                </div>
            </div>

            <div class="topbar-actions">
                <!-- Notification Bell -->
                <div class="dropdown">
                    <button type="button" class="notification-btn" id="notifBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                        <i class="bi bi-bell"></i>
                        @if (Model.Notifications != null && Model.Notifications.Any())
                        {
                            <span class="notification-badge"></span>
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-3 mt-2" style="width: 320px; max-height: 400px; overflow-y: auto;">
                        <li class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <strong class="small text-dark">Notifications</strong>
                            <span class="badge bg-primary-subtle text-primary rounded-pill small">@(Model.Notifications?.Count ?? 0)</span>
                        </li>
                        @if (Model.Notifications != null && Model.Notifications.Any())
                        {
                            @foreach (var n in Model.Notifications.Take(5))
                            {
                                <li class="py-2 border-bottom border-light">
                                    <div class="small fw-bold text-dark">@n.Title</div>
                                    <div class="x-small text-secondary">@n.Message</div>
                                    <div class="text-muted" style="font-size: 0.65rem;">@n.SentAt.ToString("MMM dd, HH:mm")</div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="text-muted small text-center py-3">No new notifications</li>
                        }
                    </ul>
                </div>

                <!-- User Profile Badge & Dropdown -->
                <div class="dropdown">
                    <a href="javascript:void(0)" class="user-profile-badge" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar-circle">@initials</div>
                        <div class="user-info-text d-none d-sm-block">
                            <span class="user-display-name">@userName</span>
                            <span class="user-display-role">User</span>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2 mt-2" style="min-width: 180px;">
                        <li><a class="dropdown-item rounded-3 py-2 small" href="/" target="_blank"><i class="bi bi-house-door me-2"></i>Public Home</a></li>
                        <li><a class="dropdown-item rounded-3 py-2 small" href="javascript:void(0)" onclick="openProfileModal()"><i class="bi bi-person me-2"></i>My Profile</a></li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item rounded-3 py-2 text-danger small"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- DASHBOARD BODY CONTENT -->
        <main class="dashboard-content-area">

            <!-- MAIN VIEW (DASHBOARD & NEW DELIVERY) -->
            <div id="mainDashboardView">

                <!-- Welcome Header -->
                <div class="mb-4">
                    <h1 class="welcome-heading">Welcome back, @firstName! 👋</h1>
                    <p class="welcome-sub">Send your parcel request and track your deliveries easily.</p>
                </div>

                <!-- ROW OF 4 METRIC CARDS (MATCHING SCREENSHOT) -->
                <div class="metrics-grid">
                    <!-- 1: Total Requests -->
                    <div class="metric-card">
                        <div class="metric-icon-wrap metric-icon-blue">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div class="metric-details">
                            <span class="metric-label">Total Requests</span>
                            <span class="metric-value">@totalRequests</span>
                            <span class="metric-sub">
                                <span class="dot-delivered">●</span> @delivered delivered &nbsp;
                                <span class="dot-pending">●</span> @pending pending
                            </span>
                        </div>
                    </div>

                    <!-- 2: In Transit -->
                    <div class="metric-card">
                        <div class="metric-icon-wrap metric-icon-green">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div class="metric-details">
                            <span class="metric-label">In Transit</span>
                            <span class="metric-value">@inTransit</span>
                            <span class="metric-sub">Currently on the way</span>
                        </div>
                    </div>

                    <!-- 3: Delivered -->
                    <div class="metric-card">
                        <div class="metric-icon-wrap metric-icon-purple">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <div class="metric-details">
                            <span class="metric-label">Delivered</span>
                            <span class="metric-value">@delivered</span>
                            <span class="metric-sub">Successfully completed</span>
                        </div>
                    </div>

                    <!-- 4: Pending Approval -->
                    <div class="metric-card">
                        <div class="metric-icon-wrap metric-icon-orange">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div class="metric-details">
                            <span class="metric-label">Pending Approval</span>
                            <span class="metric-value">@pending</span>
                            <span class="metric-sub">Waiting for admin</span>
                        </div>
                    </div>
                </div>

                <!-- Alert Feedback (Success / Error) -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-4 border-0 p-3 mb-4 shadow-xs d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 p-3 mb-4 shadow-xs d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                <!-- TWO-COLUMN DASHBOARD GRID -->
                <div class="dashboard-two-col">

                    <!-- LEFT: "Request New Delivery" CARD -->
                    <div class="dash-card p-4 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-truck text-primary fs-5"></i>
                                <h2 class="card-title-text" style="font-size: 1.25rem;">Request New Delivery</h2>
                            </div>
                            <span class="badge-fast-secure">
                                <i class="bi bi-check2"></i> Fast &amp; Secure
                            </span>
                        </div>
                        <p class="text-secondary small mb-4" style="font-size: 0.825rem;">
                            Fill in the details below to send your parcel request. Our team will review and approve it shortly.
                        </p>

                        <form asp-action="CreateDelivery" method="post" id="deliveryCreateForm" autocomplete="on">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="NewDelivery.OriginType" value="DoorstepPickup" />
                            <input type="hidden" name="NewDelivery.DestinationType" value="DoorstepDelivery" />
                            <input type="hidden" name="NewDelivery.VehicleType" id="hiddenVehicleType" value="Truck" />
                            <input type="hidden" name="NewDelivery.RouteType" id="hiddenRouteType" value="Normal" />
                            <input type="hidden" name="NewDelivery.EstimatedDistanceKm" id="hiddenDistanceKm" value="75" />

                            <!-- 1. Sender Information -->
                            <div class="mb-4">
                                <div class="form-section-header">
                                    <i class="bi bi-person-badge"></i>
                                    <span>Sender Information</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="custom-label">Full Name <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-person input-icon"></i>
                                            <input type="text" name="SenderName" class="custom-form-control" value="@userName" required />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="custom-label">Phone Number <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-telephone input-icon"></i>
                                            <input type="tel" name="SenderPhone" class="custom-form-control" placeholder="+92 300 1234567" value="+92 300 1234567" required />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="custom-label">Email Address <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-envelope input-icon"></i>
                                            <input type="email" name="SenderEmail" class="custom-form-control" placeholder="zain@example.com" value="zain@example.com" required />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Receiver Information -->
                            <div class="mb-4">
                                <div class="form-section-header">
                                    <i class="bi bi-person-plus"></i>
                                    <span>Receiver Information</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="custom-label">Full Name <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-person input-icon"></i>
                                            <input type="text" name="ReceiverName" class="custom-form-control" placeholder="Ahmed Khan" value="Ahmed Khan" required />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="custom-label">Phone Number <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-telephone input-icon"></i>
                                            <input type="tel" name="ReceiverPhone" class="custom-form-control" placeholder="+92 321 7654321" value="+92 321 7654321" required />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="custom-label">Address <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-geo-alt input-icon"></i>
                                            <input type="text" name="ReceiverAddress" class="custom-form-control" placeholder="Lahore, Punjab" value="Lahore, Punjab" required />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Parcel Details -->
                            <div class="mb-4">
                                <div class="form-section-header">
                                    <i class="bi bi-box-seam"></i>
                                    <span>Parcel Details</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-3">
                                        <label class="custom-label">Package Type <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-box-seam input-icon"></i>
                                            <select name="NewDelivery.ParcelDescription" id="selectPackageType" class="custom-select-control" onchange="updateSummaryPricing()">
                                                <option value="Bundle (Multiple Items)" selected>Bundle (Multiple Items)</option>
                                                <option value="Electronics">Electronics &amp; Gadgets</option>
                                                <option value="Standard Carton">Standard Carton</option>
                                                <option value="Documents">Important Documents</option>
                                                <option value="Fragile Cargo">Fragile Cargo</option>
                                                <option value="Industrial Pallet">Industrial Pallet</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="custom-label">Weight (kg) <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-speedometer2 input-icon"></i>
                                            <input type="number" step="0.5" min="0.5" name="NewDelivery.ParcelWeight" id="inputParcelWeight" class="custom-form-control" value="25" oninput="updateSummaryPricing()" required />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="custom-label">Dimensions (L × W × H) <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-box input-icon"></i>
                                            <input type="text" id="inputDimensions" class="custom-form-control" value="40 × 30 × 20" placeholder="40 × 30 × 20" />
                                            <input type="hidden" name="NewDelivery.Length" value="40" />
                                            <input type="hidden" name="NewDelivery.Width" value="30" />
                                            <input type="hidden" name="NewDelivery.Height" value="20" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="custom-label">Description <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-file-text input-icon"></i>
                                            <input type="text" name="NewDelivery.PackageName" id="inputPackageDesc" class="custom-form-control" placeholder="Electronics and accessories" value="Electronics and accessories" required />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 4. Locations (Pickup & Delivery) -->
                            <div class="mb-4">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="custom-label"><i class="bi bi-geo-alt-fill text-primary me-1"></i>Pickup Location <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-building input-icon text-primary"></i>
                                            <select name="NewDelivery.PickupLocation" id="selectPickupLocation" class="custom-select-control" onchange="onLocationsChanged()">
                                                <option value="Warehouse, Gujranwala" data-city="Gujranwala" selected>Warehouse, Gujranwala</option>
                                                <option value="Fleetify Central Hub, Lahore" data-city="Lahore">Fleetify Central Hub, Lahore</option>
                                                <option value="Industrial Area, Sialkot" data-city="Sialkot">Industrial Area, Sialkot</option>
                                                <option value="Textile Hub, Faisalabad" data-city="Faisalabad">Textile Hub, Faisalabad</option>
                                                <option value="South Hub, Karachi" data-city="Karachi">South Hub, Karachi</option>
                                                <option value="Sector I-9 Hub, Islamabad" data-city="Islamabad">Sector I-9 Hub, Islamabad</option>
                                                <option value="Faizabad Hub, Rawalpindi" data-city="Rawalpindi">Faizabad Hub, Rawalpindi</option>
                                                <option value="Khanewal Road, Multan" data-city="Multan">Khanewal Road, Multan</option>
                                                <option value="Hayatabad Hub, Peshawar" data-city="Peshawar">Hayatabad Hub, Peshawar</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="custom-label"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Delivery Location <span class="req-star">*</span></label>
                                        <div class="custom-input-box">
                                            <i class="bi bi-geo-alt input-icon text-danger"></i>
                                            <select name="NewDelivery.DropoffLocation" id="selectDeliveryLocation" class="custom-select-control" onchange="onLocationsChanged()">
                                                <option value="Lahore, Punjab" data-city="Lahore" selected>Lahore, Punjab</option>
                                                <option value="Warehouse, Gujranwala" data-city="Gujranwala">Warehouse, Gujranwala</option>
                                                <option value="Industrial Area, Sialkot" data-city="Sialkot">Industrial Area, Sialkot</option>
                                                <option value="Textile Hub, Faisalabad" data-city="Faisalabad">Textile Hub, Faisalabad</option>
                                                <option value="South Hub, Karachi" data-city="Karachi">South Hub, Karachi</option>
                                                <option value="Sector I-9 Hub, Islamabad" data-city="Islamabad">Sector I-9 Hub, Islamabad</option>
                                                <option value="Faizabad Hub, Rawalpindi" data-city="Rawalpindi">Faizabad Hub, Rawalpindi</option>
                                                <option value="Khanewal Road, Multan" data-city="Multan">Khanewal Road, Multan</option>
                                                <option value="Hayatabad Hub, Peshawar" data-city="Peshawar">Hayatabad Hub, Peshawar</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 5. Additional Notes (Optional) -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="custom-label mb-0"><i class="bi bi-chat-left-text text-primary me-1"></i>Additional Notes (Optional)</span>
                                    <span class="x-small text-muted font-mono" id="charCountDisplay">0/500</span>
                                </div>
                                <textarea name="AdditionalNotes" id="txtAdditionalNotes" class="custom-textarea" placeholder="Any special instructions or additional details..." maxlength="500" oninput="updateCharCount(this)"></textarea>
                            </div>

                            <!-- 6. Submit Button -->
                            <button type="submit" class="btn-submit-request" id="btnSubmitRequest">
                                <i class="bi bi-send-fill"></i>
                                <span>Submit Request</span>
                            </button>
                        </form>
                    </div>

                    <!-- RIGHT COLUMN: DELIVERY SUMMARY & LIVE MAP -->
                    <div class="d-flex flex-column gap-3">

                        <!-- CARD 1: DELIVERY SUMMARY -->
                        <div class="dash-card p-4">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-card-heading text-primary fs-5"></i>
                                <h3 class="card-title-text" style="font-size: 1.05rem;">Delivery Summary</h3>
                            </div>

                            <!-- Route Visual Box -->
                            <div class="summary-route-box">
                                <div class="route-stop">
                                    <i class="bi bi-geo-alt-fill text-success route-pin"></i>
                                    <div>
                                        <div class="route-city-name" id="summaryPickupCity">Gujranwala</div>
                                        <div class="route-city-tag">Pickup City</div>
                                    </div>
                                </div>
                                
                                <div class="route-arrow-connector">
                                    <span>------&gt;</span>
                                </div>

                                <div class="route-stop">
                                    <i class="bi bi-geo-alt-fill text-danger route-pin"></i>
                                    <div>
                                        <div class="route-city-name" id="summaryDropoffCity">Lahore</div>
                                        <div class="route-city-tag">Delivery City</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row of 3 Stats -->
                            <div class="summary-stats-row">
                                <div class="summary-stat-cell">
                                    <div class="stat-icon-label">
                                        <i class="bi bi-clock text-primary"></i> Estimated Time
                                    </div>
                                    <div class="stat-main-value" id="summaryEstTime">2 - 4 Hours</div>
                                </div>

                                <div class="summary-stat-cell">
                                    <div class="stat-icon-label">
                                        <i class="bi bi-cash-coin text-primary"></i> Estimated Cost
                                    </div>
                                    <div class="stat-main-value text-primary" id="summaryEstCost">PKR 1,200 - 1,800</div>
                                </div>

                                <div class="summary-stat-cell">
                                    <div class="stat-icon-label">
                                        <i class="bi bi-shield-check text-primary"></i> Service Type
                                    </div>
                                    <div class="stat-main-value" id="summaryServiceType">Standard</div>
                                </div>
                            </div>
                        </div>

                        <!-- CARD 2: LIVE LOCATION PREVIEW (LEAFLET MAP) -->
                        <div class="dash-card">
                            <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-geo-alt-fill text-primary"></i>
                                    <strong class="text-dark small">Live Location Preview</strong>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-sm btn-light border py-0 px-2" onclick="recenterRouteMap()" title="Recenter View">
                                        <i class="bi bi-crosshair"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Map Canvas -->
                            <div id="routeLiveMap"></div>

                            <!-- Safety Guarantee Banner -->
                            <div class="map-safety-banner">
                                <div class="safety-badge-text">
                                    <i class="bi bi-shield-check safety-badge-icon"></i>
                                    <div>
                                        <h4 class="safety-title">Your parcel is safe with Fleetify</h4>
                                        <p class="safety-sub">We ensure fast, secure and reliable delivery.</p>
                                    </div>
                                </div>
                                <i class="bi bi-truck text-muted fs-4"></i>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- MY REQUESTS VIEW (TOGGLED VIA SIDEBAR) -->
            <div id="requestsListView" class="d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="welcome-heading">My Delivery Requests</h2>
                        <p class="welcome-sub">View and track all your booked shipments in real-time.</p>
                    </div>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="switchSidebarView('new-delivery')">
                        <i class="bi bi-plus-lg me-1"></i> New Request
                    </button>
                </div>

                <div class="dash-card p-3 p-md-4">
                    @if (Model.MyDeliveries != null && Model.MyDeliveries.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="userRequestsTable">
                                <thead class="table-light small text-secondary">
                                    <tr>
                                        <th>Tracking #</th>
                                        <th>Date</th>
                                        <th>Pickup &rarr; Dropoff</th>
                                        <th>Weight / Item</th>
                                        <th>Estimated Cost</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in Model.MyDeliveries)
                                    {
                                        <tr>
                                            <td class="fw-bold font-mono text-primary">@req.TrackingNumber</td>
                                            <td class="small text-muted">@req.RequestDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <div class="small fw-semibold text-dark text-truncate" style="max-width: 200px;">
                                                    <i class="bi bi-circle-fill text-success me-1 x-small"></i>@req.PickupLocation
                                                </div>
                                                <div class="small text-muted text-truncate" style="max-width: 200px;">
                                                    <i class="bi bi-geo-alt-fill text-danger me-1 x-small"></i>@req.DropoffLocation
                                                </div>
                                            </td>
                                            <td class="small font-mono">
                                                @(req.ParcelWeight > 0 ? req.ParcelWeight.ToString("0.##") : "2.0") kg
                                                <span class="d-block text-muted x-small">@(!string.IsNullOrWhiteSpace(req.PackageName) ? req.PackageName : (req.ParcelDescription ?? "Package"))</span>
                                            </td>
                                            <td class="small fw-bold text-dark font-mono">
                                                PKR @req.EstimatedCost.ToString("N0")
                                            </td>
                                            <td>
                                                @if (req.RequestedStatus == "Delivered")
                                                {
                                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1.5">Delivered</span>
                                                }
                                                else if (req.RequestedStatus == "In-Transit")
                                                {
                                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1.5">In Transit</span>
                                                }
                                                else if (req.RequestedStatus == "Assigned")
                                                {
                                                    <span class="badge bg-info-subtle text-info rounded-pill px-3 py-1.5">Assigned</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-1.5">Pending</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="Track" asp-route-trackingNumber="@req.TrackingNumber" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold">
                                                    <i class="bi bi-radar me-1"></i>Track
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
                            <h5 class="fw-bold text-dark mt-3">No Delivery Requests Yet</h5>
                            <p class="text-muted small">Submit your first delivery request using the dashboard form.</p>
                            <button type="button" class="btn btn-primary rounded-pill px-4" onclick="switchSidebarView('new-delivery')">Create Delivery</button>
                        </div>
                    }
                </div>
            </div>

            <!-- TRACK PARCEL QUICK LOOKUP VIEW (TOGGLED VIA SIDEBAR) -->
            <div id="trackParcelView" class="d-none">
                <div class="mb-4">
                    <h2 class="welcome-heading">Track Your Parcel</h2>
                    <p class="welcome-sub">Enter any Fleetify tracking code to see its journey in real-time.</p>
                </div>

                <div class="dash-card p-4 p-md-5 text-center max-w-600 mx-auto" style="max-width: 650px;">
                    <i class="bi bi-radar text-primary fs-1 mb-2 d-inline-block"></i>
                    <h4 class="fw-bold text-dark mb-3">Live Shipment Tracking</h4>
                    <div class="input-group mb-3">
                        <input type="text" id="directTrackInput" class="form-control rounded-start-pill py-2.5 px-3 border-primary" placeholder="e.g. FLT-2026-XXXXX" />
                        <button class="btn btn-primary rounded-end-pill px-4 fw-bold" type="button" onclick="submitDirectTrack()">Track Now</button>
                    </div>
                    <span class="text-muted small">Tracking numbers are dispatched via email and displayed on your bookings.</span>
                </div>
            </div>

        </main>

        <!-- DASHBOARD BOTTOM FOOTER (MATCHING SCREENSHOT) -->
        <footer class="dashboard-footer">
            <div class="footer-brand">
                <img src="~/images/fleetify-brand-logo.png?v=20261009" asp-append-version="true" alt="Fleetify" style="height: 32px; width: auto; border-radius: 6px; padding: 3px 8px; background: #ffffff;" />
            </div>

            <div class="footer-links">
                <a href="/" class="footer-link-item">Home</a>
                <a href="/#about" class="footer-link-item">About</a>
                <a href="/#services" class="footer-link-item">Services</a>
