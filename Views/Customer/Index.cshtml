            const pickup = isDoorstep 
                ? (pickupInput?.value || 'Doorstep Location')
                : (originWhSelect?.selectedOptions[0]?.text || 'Origin Hub');

            const dropoff = isDestDoorstep 
                ? (dropoffInput?.value || 'Doorstep Destination')
                : (destWhSelect?.selectedOptions[0]?.text || 'Destination Hub');

            const singleItemWeight = parseFloat(document.getElementById('singleItemWeight')?.value) || 2.0;
            const pkgQty = parseInt(document.getElementById('packageQuantity')?.value) || 1;
            const totalWeight = Math.round((singleItemWeight * pkgQty) * 100) / 100;
