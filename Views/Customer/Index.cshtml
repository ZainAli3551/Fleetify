            if (document.getElementById('modalOriginText')) {
                document.getElementById('modalOriginText').innerText = originText;
            }
            if (document.getElementById('modalDestText')) {
                document.getElementById('modalDestText').innerText = destText;
            }

            const specialCities = ['sahiwal', 'okara', 'kasur', 'kasoor', 'sukkur'];
            const dropLower = dropoff.toLowerCase();
            const matchedSpecial = specialCities.find(c => dropLower.includes(c)) || isNoWarehouse;
            const isSpecial = (lastEstimateData && (lastEstimateData.isSpecialDelivery || lastEstimateData.isPrivateTransport)) || !!matchedSpecial;

            const specialRow = document.getElementById('modalSpecialRow');
            const specialText = document.getElementById('modalSpecialSurchargeText');
            if (specialRow) {
                if (isSpecial) {
                    specialRow.classList.remove('d-none');
                    const extra15 = (lastEstimateData && (lastEstimateData.specialDeliverySurcharge || lastEstimateData.privateTransportSurcharge)) || 0;
                    if (specialText) specialText.innerText = '+Rs. ' + Math.floor(extra15);
                } else {
                    specialRow.classList.add('d-none');
                }
            }

            // Modal Distance & Doorstep Surcharges
            const modalDistEl = document.getElementById('modalDistanceText');
            if (modalDistEl) {
                const totalDistVal = (lastEstimateData && (lastEstimateData.totalDrivingDistanceKm || lastEstimateData.distanceKm)) 
                    ? (lastEstimateData.totalDrivingDistanceKm || lastEstimateData.distanceKm).toFixed(1) + ' km'
                    : (document.getElementById('estTotalDrivingDistance')?.innerText || document.getElementById('estDistanceKm')?.innerText || '15.0 km');
                modalDistEl.innerText = totalDistVal;
            }

            const modalDoorstepRow = document.getElementById('modalDoorstepSurchargeRow');
            const modalDoorstepText = document.getElementById('modalDoorstepSurchargeText');
            const activeLegCount = (isDoorstep ? 1 : 0) + (isDestDoorstep ? 1 : 0);
            if (modalDoorstepRow) {
                const doorstepTotal = (lastEstimateData && lastEstimateData.totalDoorstepSurcharge) || 0;
                if (activeLegCount > 0 && doorstepTotal > 0) {
                    modalDoorstepRow.classList.remove('d-none');
                    if (modalDoorstepText) {
                        modalDoorstepText.innerText = '+Rs. ' + Math.floor(doorstepTotal).toLocaleString() + ` (${activeLegCount} ${activeLegCount > 1 ? 'Legs' : 'Leg'})`;
                    }
                } else {
                    modalDoorstepRow.classList.add('d-none');
                }
            }

            document.getElementById('modalCostText').innerText = total;

            const modalEl = document.getElementById('submitNoticeModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

