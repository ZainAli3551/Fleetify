            </div>

            <div class="footer-social-wrap">
                <a href="https://facebook.com" target="_blank" class="footer-social-icon"><i class="bi bi-facebook"></i></a>
                <a href="https://twitter.com" target="_blank" class="footer-social-icon"><i class="bi bi-twitter-x"></i></a>
                <a href="https://linkedin.com" target="_blank" class="footer-social-icon"><i class="bi bi-linkedin"></i></a>
