            const pkgL = parseFloat(document.getElementById('packageLength')?.value) || 2.0;
            const pkgW = parseFloat(document.getElementById('packageWidth')?.value) || 1.5;
            const pkgH = parseFloat(document.getElementById('packageHeight')?.value) || 1.0;
            const singleCft = Math.round((pkgL * pkgW * pkgH) * 100) / 100;
            const totalCft = Math.round((singleCft * pkgQty) * 100) / 100;

            if (document.getElementById('modalPackageNameText')) {
                document.getElementById('modalPackageNameText').innerText = pkgName;
            }
            if (document.getElementById('modalPackageTypeText')) {
                document.getElementById('modalPackageTypeText').innerText = pkgType;
            }
            if (document.getElementById('modalDimensionsText')) {
                document.getElementById('modalDimensionsText').innerText = `${pkgL} × ${pkgW} × ${pkgH} ft`;
