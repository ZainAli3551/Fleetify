                document.getElementById('modalQuantityText').innerText = `${pkgQty} ${pkgQty > 1 ? 'units' : 'unit'}`;
            }
            if (document.getElementById('modalWeightText')) {
                document.getElementById('modalWeightText').innerText = `${totalWeight.toFixed(2)} kg (${singleItemWeight.toFixed(2)} kg × ${pkgQty})`;
