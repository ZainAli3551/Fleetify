            }

            if (document.getElementById('modalTypeText')) {
                document.getElementById('modalTypeText').innerText = deliveryType;
            }
            const estDays = (lastEstimateData && lastEstimateData.estimatedDeliveryDays) 
                ? lastEstimateData.estimatedDeliveryDays 
                : (document.getElementById('estDeliveryDays')?.innerText || '4 to 6 days');
            if (document.getElementById('modalDeliveryDaysText')) {
                document.getElementById('modalDeliveryDaysText').innerText = estDays;
            }
            const pickupDateRow = document.getElementById('modalPickupDateRow');
            const pickupDateInput = document.getElementById('pickupDate');
            if (pickupDateRow) {
                if (isDoorstep && pickupDateInput && pickupDateInput.value) {
                    pickupDateRow.classList.remove('d-none');
                    const pDateEl = document.getElementById('modalPickupDateText');
                    if (pDateEl) pDateEl.innerText = pickupDateInput.value;
                } else {
                    pickupDateRow.classList.add('d-none');
                }
