@model Fleetify.Models.ViewModels.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Portal";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- User Header (Figure 23) -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Fleetify</h2>
            <p class="text-secondary small mb-0">Welcome, <strong class="text-dark">@Model.UserName</strong></p>
        </div>
    </div>

    @if (Model.Notifications != null && Model.Notifications.Any())
    {
        <div class="card border-0 shadow-xs rounded-4 bg-white p-3 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary rounded-circle p-2"><i class="bi bi-bell-fill text-white"></i></span>
                    <h6 class="fw-bold text-dark mb-0">Recent Notifications &amp; Updates</h6>
                </div>
                <span class="badge bg-light text-secondary border">@Model.Notifications.Count Total</span>
            </div>
            <div class="list-group list-group-flush small">
                @foreach (var notif in Model.Notifications.Take(3))
                {
                    <div class="list-group-item px-0 py-2 border-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                            <div>
                                <strong class="text-dark">@notif.Title</strong>
                                <span class="text-secondary d-block">@notif.Message</span>
                            </div>
                        </div>
                        <span class="text-muted x-small text-nowrap ms-3">@notif.SentAt.ToString("MMM dd, HH:mm")</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- 4 Top Metric Cards (Figure 23) -->
    <div class="row g-3 mb-4">
        <!-- Total Deliveries -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Total Deliveries</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalDeliveries</h3>
                    </div>
                    <div class="kpi-icon bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- In Transit -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">In Transit</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.InTransitCount</h3>
                    </div>
                    <div class="kpi-icon bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="bi bi-truck fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delivered -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Delivered</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.DeliveredCount</h3>
                    </div>
                    <div class="kpi-icon bg-success-subtle text-success rounded-circle p-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Spent -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Total Spent</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">Rs. @Model.TotalSpent.ToString("N0")</h3>
                    </div>
                    <div class="kpi-icon bg-purple-subtle text-purple rounded-circle p-3">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs (Figure 23: New Delivery | Track Deliveries) -->
    <ul class="nav nav-pills mb-4 gap-2" id="customerTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 py-2" id="new-delivery-tab" data-bs-toggle="tab" data-bs-target="#new-delivery-pane" type="button" role="tab">
                New Delivery
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 py-2" id="track-deliveries-tab" data-bs-toggle="tab" data-bs-target="#track-deliveries-pane" type="button" role="tab">
                Track Deliveries (@Model.MyDeliveries.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="customerTabsContent">
        <!-- TAB 1: NEW DELIVERY (Figure 23) -->
        <div class="tab-pane fade show active" id="new-delivery-pane" role="tabpanel" tabindex="0">
            <div class="row g-4">
                <!-- Request Form (Left Column) -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-xs rounded-4 p-4 p-md-5 bg-white">
                        <h5 class="fw-bold text-dark mb-4">Request New Delivery</h5>

                        <form asp-action="CreateDelivery" method="post" id="deliveryForm">
                            @Html.AntiForgeryToken()

                            <!-- 1. TOP ROW: TWO DROPDOWNS FOR ORIGIN WAREHOUSE AND DESTINATION WAREHOUSE -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-dark mb-1">
                                        <i class="bi bi-building text-primary me-1"></i>Origin Warehouse
                                    </label>
                                    <select id="originWarehouseSelect" class="form-select rounded-3 py-2 fw-semibold" onchange="onOriginWarehouseChanged()">
                                        <option value="Fleetify GT Road Hub, Climax Town, Main GT Road, Gujranwala" data-city="Gujranwala" selected>Fleetify GT Road Hub - Gujranwala</option>
                                        <option value="Fleetify Central Hub, Multan Road, Near Thokar Niaz Baig, Lahore" data-city="Lahore">Fleetify Central Hub - Lahore</option>
                                        <option value="Fleetify South Hub, Plot 42, Korangi Industrial Area, Karachi" data-city="Karachi">Fleetify South Hub - Karachi</option>
                                        <option value="Fleetify North Hub, Sector I-9/2 Industrial Area, Islamabad" data-city="Islamabad">Fleetify North Hub - Islamabad</option>
                                        <option value="Fleetify Twin Cities Hub, Westridge 1, Main Peshawar Road, Rawalpindi" data-city="Rawalpindi">Fleetify Twin Cities Hub - Rawalpindi</option>
                                        <option value="Fleetify Textile Hub, Small Industrial Estate, Sargodha Road, Faisalabad" data-city="Faisalabad">Fleetify Textile Hub - Faisalabad</option>
                                        <option value="Fleetify South Punjab Hub, Industrial Estate Phase 2, Khanewal Road, Multan" data-city="Multan">Fleetify South Punjab Hub - Multan</option>
                                        <option value="Fleetify Khyber Hub, Industrial Estate, Jamrud Road, Hayatabad, Peshawar" data-city="Peshawar">Fleetify Khyber Hub - Peshawar</option>
                                        <option value="Fleetify Export Hub, Sambrial Road, Near Dry Port, Sialkot" data-city="Sialkot">Fleetify Export Hub - Sialkot</option>
                                        <option value="Fleetify Balochistan Hub, Joint Road, Near Railway Station, Quetta" data-city="Quetta">Fleetify Balochistan Hub - Quetta</option>
                                    </select>
                                    <span class="text-muted d-block x-small mt-1"><i class="bi bi-geo-alt me-1"></i>Fleetify warehouse serving your pickup region.</span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-dark mb-1">
                                        <i class="bi bi-building text-danger me-1"></i>Destination Warehouse
                                    </label>
                                    <select id="destWarehouseSelect" class="form-select rounded-3 py-2 fw-semibold" onchange="onDestWarehouseChanged()">
                                        <optgroup label="Fleetify Hub Warehouses">
                                            <option value="Fleetify Central Hub, Multan Road, Near Thokar Niaz Baig, Lahore" data-city="Lahore" selected>Fleetify Central Hub - Lahore</option>
                                            <option value="Fleetify South Hub, Plot 42, Korangi Industrial Area, Karachi" data-city="Karachi">Fleetify South Hub - Karachi</option>
                                            <option value="Fleetify North Hub, Sector I-9/2 Industrial Area, Islamabad" data-city="Islamabad">Fleetify North Hub - Islamabad</option>
                                            <option value="Fleetify Twin Cities Hub, Westridge 1, Main Peshawar Road, Rawalpindi" data-city="Rawalpindi">Fleetify Twin Cities Hub - Rawalpindi</option>
                                            <option value="Fleetify Textile Hub, Small Industrial Estate, Sargodha Road, Faisalabad" data-city="Faisalabad">Fleetify Textile Hub - Faisalabad</option>
                                            <option value="Fleetify South Punjab Hub, Industrial Estate Phase 2, Khanewal Road, Multan" data-city="Multan">Fleetify South Punjab Hub - Multan</option>
                                            <option value="Fleetify GT Road Hub, Climax Town, Main GT Road, Gujranwala" data-city="Gujranwala">Fleetify GT Road Hub - Gujranwala</option>
                                            <option value="Fleetify Khyber Hub, Industrial Estate, Jamrud Road, Hayatabad, Peshawar" data-city="Peshawar">Fleetify Khyber Hub - Peshawar</option>
                                            <option value="Fleetify Export Hub, Sambrial Road, Near Dry Port, Sialkot" data-city="Sialkot">Fleetify Export Hub - Sialkot</option>
                                            <option value="Fleetify Balochistan Hub, Joint Road, Near Railway Station, Quetta" data-city="Quetta">Fleetify Balochistan Hub - Quetta</option>
                                        </optgroup>
                                        <optgroup label="Special Delivery Areas (No Warehouse - 15% Surcharge)">
                                            <option value="Sahiwal, Pakistan" data-city="Sahiwal" data-no-warehouse="true">Sahiwal (No Warehouse - Special Delivery +15%)</option>
                                            <option value="Okara, Pakistan" data-city="Okara" data-no-warehouse="true">Okara (No Warehouse - Special Delivery +15%)</option>
                                            <option value="Kasur, Pakistan" data-city="Kasur" data-no-warehouse="true">Kasur (No Warehouse - Special Delivery +15%)</option>
                                            <option value="Sukkur, Pakistan" data-city="Sukkur" data-no-warehouse="true">Sukkur (No Warehouse - Special Delivery +15%)</option>
                                        </optgroup>
                                    </select>
                                    <span class="text-muted d-block x-small mt-1"><i class="bi bi-flag me-1"></i>Destination warehouse hub or delivery region.</span>
                                </div>
                            </div>

                            <!-- 2. BELOW DROPDOWNS: SELECTION BLOCKS & DYNAMIC ADDRESS FIELDS -->
                            <div class="row g-3 mb-3">
                                <!-- Left Column: Pickup Selection Blocks & Dynamic Pickup Address -->
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-secondary mb-1 d-block">Pickup Mode</label>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <label class="selectable-option-card d-block p-2.5 rounded-3 border h-100 position-relative cursor-pointer" for="originDoorstep" id="cardOriginDoorstep">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input class="form-check-input mt-0 flex-shrink-0" type="radio" asp-for="NewDelivery.OriginType" id="originDoorstep" value="DoorstepPickup" checked onchange="toggleOriginPickupMode()">
                                                    <div class="lh-sm">
                                                        <span class="fw-bold text-dark d-block small"><i class="bi bi-house-door-fill text-primary me-1"></i>Doorstep Pickup</span>
                                                        <span class="text-muted x-small d-block mt-0.5">Rider picks up from you</span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                        <div class="col-6">
                                            <label class="selectable-option-card d-block p-2.5 rounded-3 border h-100 position-relative cursor-pointer" for="originWarehouse" id="cardOriginWarehouse">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input class="form-check-input mt-0 flex-shrink-0" type="radio" asp-for="NewDelivery.OriginType" id="originWarehouse" value="WarehouseDropoff" onchange="toggleOriginPickupMode()">
                                                    <div class="lh-sm">
                                                        <span class="fw-bold text-dark d-block small"><i class="bi bi-building text-info me-1"></i>Warehouse Dropoff</span>
                                                        <span class="text-muted x-small d-block mt-0.5">You drop off at hub</span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Specific Pickup Address Field (Appears ONLY when Doorstep Pickup is selected) -->
                                    <div id="pickupAddrContainer">
                                        <label class="form-label small fw-semibold text-secondary">Specific Pickup Address (Street / House #)</label>
                                        <input asp-for="NewDelivery.PickupLocation" id="pickupAddr" class="form-control rounded-3 py-2" placeholder="e.g. Shaheenabad, Gujranwala" autocomplete="off" list="pakistanCitiesList" required />
                                        <span class="text-muted d-block x-small mt-1"><i class="bi bi-geo-alt me-1"></i>Courier will arrive at this address for pickup.</span>
                                    </div>

                                    <!-- Warehouse Drop-off Hub Confirmation Info (Appears when Warehouse Dropoff is selected) -->
                                    <div id="originWarehouseInfo" class="alert alert-light border rounded-3 p-2.5 d-none mb-0">
                                        <div class="d-flex align-items-center gap-2 text-primary small">
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            <div>
                                                <strong class="d-block text-dark x-small">Drop-off Hub Confirmed:</strong>
                                                <span id="originWarehouseNameDisplay" class="x-small text-secondary">Fleetify GT Road Hub - Gujranwala</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column: Drop-off Selection Blocks & Dynamic Drop-off Address -->
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-secondary mb-1 d-block">Delivery Mode</label>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <label class="selectable-option-card d-block p-2.5 rounded-3 border h-100 position-relative cursor-pointer" for="destDoorstep" id="cardDestDoorstep">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input class="form-check-input mt-0 flex-shrink-0" type="radio" asp-for="NewDelivery.DestinationType" id="destDoorstep" value="DoorstepDelivery" checked onchange="toggleDestinationDeliveryMode()">
                                                    <div class="lh-sm">
                                                        <span class="fw-bold text-dark d-block small"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Doorstep Delivery</span>
                                                        <span class="text-muted x-small d-block mt-0.5">Deliver to recipient</span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                        <div class="col-6">
                                            <label class="selectable-option-card d-block p-2.5 rounded-3 border h-100 position-relative cursor-pointer" for="destWarehouse" id="cardDestWarehouse">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input class="form-check-input mt-0 flex-shrink-0" type="radio" asp-for="NewDelivery.DestinationType" id="destWarehouse" value="WarehousePickup" onchange="toggleDestinationDeliveryMode()">
                                                    <div class="lh-sm">
                                                        <span class="fw-bold text-dark d-block small"><i class="bi bi-box-arrow-in-down-right text-info me-1"></i>Warehouse Self Pickup</span>
                                                        <span class="text-muted x-small d-block mt-0.5">Pick up from hub</span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Specific Drop-off Address Field (Appears ONLY when Doorstep Delivery is selected) -->
                                    <div id="dropoffAddrContainer">
                                        <label class="form-label small fw-semibold text-secondary">Specific Drop-off Address (Street / House #)</label>
                                        <input asp-for="NewDelivery.DropoffLocation" id="dropoffAddr" class="form-control rounded-3 py-2" placeholder="e.g. Data Darbar, Lahore" autocomplete="off" list="dropoffCitiesList" required />
                                        <span class="text-muted d-block x-small mt-1"><i class="bi bi-flag me-1"></i>Courier will deliver parcel directly to this doorstep.</span>
                                    </div>

                                    <!-- Warehouse Self-Pickup Hub Confirmation Info (Appears when Warehouse Self-Pickup is selected) -->
                                    <div id="destWarehouseInfo" class="alert alert-light border rounded-3 p-2.5 d-none mb-0">
                                        <div class="d-flex align-items-center gap-2 text-primary small">
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            <div>
                                                <strong class="d-block text-dark x-small">Self-Pickup Hub Confirmed:</strong>
                                                <span id="destWarehouseNameDisplay" class="x-small text-secondary">Fleetify Central Hub - Lahore</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Warning Notice (Triggered ONLY conditionally when selecting city without warehouse while choosing warehouse operations) -->
                                    <div id="specialDeliveryNotice" class="alert alert-warning border border-warning-subtle rounded-3 small p-2 mt-2 d-none">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0 mt-0.5"></i>
                                            <div class="x-small">
                                                <strong>Notice:</strong> Fleetify does not operate a warehouse in <span id="specialCityName" class="fw-bold">this city</span>. Warehouse self-pickup is not available here; please choose <strong>Doorstep Delivery</strong> (special delivery with an additional <strong>15% charge</strong>).
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pickup Cities Datalist -->
                            <datalist id="pakistanCitiesList">
                                <option value="Gujranwala, Pakistan" />
                                <option value="Lahore, Pakistan" />
                                <option value="Karachi, Pakistan" />
                                <option value="Islamabad, Pakistan" />
                                <option value="Rawalpindi, Pakistan" />
                                <option value="Faisalabad, Pakistan" />
                                <option value="Multan, Pakistan" />
                                <option value="Peshawar, Pakistan" />
                                <option value="Sialkot, Pakistan" />
                                <option value="Quetta, Pakistan" />
                            </datalist>

                            <!-- Dropoff Cities Datalist: Warehouse Hubs & Special Delivery Cities (Sahiwal, Okara, Kasur, Sukkur) -->
                            <datalist id="dropoffCitiesList">
                                <option value="Lahore, Pakistan" label="Lahore (Hub Warehouse)" />
                                <option value="Karachi, Pakistan" label="Karachi (Hub Warehouse)" />
                                <option value="Islamabad, Pakistan" label="Islamabad (Hub Warehouse)" />
                                <option value="Rawalpindi, Pakistan" label="Rawalpindi (Hub Warehouse)" />
                                <option value="Faisalabad, Pakistan" label="Faisalabad (Hub Warehouse)" />
                                <option value="Multan, Pakistan" label="Multan (Hub Warehouse)" />
                                <option value="Gujranwala, Pakistan" label="Gujranwala (Hub Warehouse)" />
                                <option value="Peshawar, Pakistan" label="Peshawar (Hub Warehouse)" />
                                <option value="Sialkot, Pakistan" label="Sialkot (Hub Warehouse)" />
                                <option value="Quetta, Pakistan" label="Quetta (Hub Warehouse)" />
                                <option value="Sahiwal, Pakistan" label="Sahiwal (No Warehouse - Special Delivery +15%)" />
                                <option value="Okara, Pakistan" label="Okara (No Warehouse - Special Delivery +15%)" />
                                <option value="Kasur, Pakistan" label="Kasur (No Warehouse - Special Delivery +15%)" />
                                <option value="Sukkur, Pakistan" label="Sukkur (No Warehouse - Special Delivery +15%)" />
                            </datalist>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">Package Weight (kg)</label>
                                    <input asp-for="NewDelivery.ParcelWeight" id="packageWeight" type="number" step="0.5" min="0.5" class="form-control rounded-3 py-2" value="2.0" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">Package Type</label>
                                    <select asp-for="NewDelivery.ParcelDescription" id="parcelDescription" class="form-select rounded-3 py-2">
                                        <option value="Document">Document</option>
                                        <option value="Electronics">Electronics</option>
                                        <option value="Clothing & Apparel">Clothing &amp; Apparel</option>
                                        <option value="Fragile Goods">Fragile Goods</option>
                                        <option value="Hardware Parts" selected>Hardware Parts</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-secondary">Delivery Type</label>
                                    <select asp-for="NewDelivery.RouteType" id="deliveryType" class="form-select rounded-3 py-2 fw-semibold text-dark">
                                        <option value="Normal" selected>Normal Delivery</option>
                                        <option value="Fast">Fast Delivery</option>
                                        <option value="Express">Express Delivery</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-secondary">Vehicle Type</label>
                                    <select asp-for="NewDelivery.VehicleType" id="vehicleType" class="form-select rounded-3 py-2 fw-semibold text-dark">
                                        <option value="Bike">Bike (Up to 40 kg)</option>
                                        <option value="Pickup">Pickup (Up to 800 kg)</option>
                                        <option value="Van">Van (Up to 1,500 kg)</option>
                                        <option value="Truck" selected>Truck (Up to 5,000 kg)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-secondary">Pickup Date</label>
                                    <input asp-for="NewDelivery.PickupDate" id="pickupDate" type="date" class="form-control rounded-3 py-2" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>

                            <input type="hidden" asp-for="NewDelivery.Height" id="packageHeight" value="1.0" />
                            <input type="hidden" asp-for="NewDelivery.Width" id="packageWidth" value="1.0" />
                            <input type="hidden" id="distanceKm" name="NewDelivery.EstimatedDistanceKm" value="15" />

                            <div class="d-grid">
                                <button type="button" class="btn btn-primary rounded-pill py-2 fw-semibold text-white shadow-sm" onclick="showDeliveryNoticeModal()">
                                    <i class="bi bi-send me-1"></i> Submit Delivery Request
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Cost Estimate Card (Right Column - Figure 23) -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-xs rounded-4 p-4 bg-white sticky-top" style="top: 20px;">
                        <h6 class="fw-bold text-dark mb-3">Cost Estimate</h6>

                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Route Distance</span>
                            <span class="fw-semibold text-primary font-mono" id="estDistanceKm">15 km</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Cargo Size</span>
                            <span class="fw-semibold text-dark" id="estWeight">2 kg</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 small">
                            <span class="text-secondary">Delivery Speed</span>
                            <span class="fw-semibold text-primary" id="estDeliveryType">Normal</span>
                        </div>

                        <div id="estSpecialSurchargeRow" class="d-flex justify-content-between mb-2 small text-warning-emphasis d-none">
                            <span><i class="bi bi-truck me-1"></i>Special Delivery (+15%)</span>
                            <span class="fw-semibold font-mono" id="estSpecialSurchargeAmount">+Rs. 0</span>
                        </div>

                        <div id="estHubInfoRow" class="d-flex justify-content-between mb-2 small text-secondary">
                            <span>Hub Network</span>
                            <span class="fw-semibold text-dark" id="estHubStatus">Connected Hubs</span>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold text-dark">Estimated Total</span>
                            <h4 class="fw-bold text-primary mb-0" id="estTotal">Rs. 545</h4>
                        </div>

                        <div class="p-3 bg-light-blue rounded-3 text-primary small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-clock-history fs-5"></i>
                            <div>
                                <span class="d-block text-secondary x-small">Estimated Delivery</span>
                                <strong id="estDeliveryDays">1-2 business days</strong>
                            </div>
                        </div>

                        <!-- Interactive Live Route Map -->
                        <div class="mt-1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-secondary small fw-semibold">
                                    <i class="bi bi-geo-alt-fill text-primary me-1"></i>Live Route Visualizer
                                </span>
                                <span id="estMapProvider" class="badge bg-light text-primary border" style="font-size: 0.68rem;">
                                    <i class="bi bi-broadcast text-success me-1"></i>Live GPS Active
                                </span>
                            </div>
                            <div id="routeMap" class="rounded-3 border shadow-sm position-relative overflow-hidden" style="height: 250px; width: 100%; background: #f1f5f9; z-index: 1;"></div>
                            <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-muted" style="font-size: 0.72rem;">
                                <span id="mapOriginDisplay" class="text-truncate" style="max-width: 45%;"><i class="bi bi-geo-alt-fill text-success me-1"></i>Pickup</span>
                                <span id="mapRouteStatus" class="fw-semibold text-primary px-1"><i class="bi bi-arrow-right"></i></span>
                                <span id="mapDestDisplay" class="text-truncate text-end" style="max-width: 45%;"><i class="bi bi-flag-fill text-danger me-1"></i>Destination</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: TRACK DELIVERIES (History & Tracking) -->
        <div class="tab-pane fade" id="track-deliveries-pane" role="tabpanel" tabindex="0">
            <div class="card border-0 shadow-xs rounded-4 bg-white p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">My Delivery Bookings</h5>
                        <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i>Time-Limited: You can only Edit or Cancel delivery requests within <strong>1 hour</strong> of booking.</p>
                    </div>
                    <form asp-action="Track" method="get" class="d-flex gap-2" style="max-width: 320px;">
                        <input name="trackingNumber" class="form-control form-control-sm rounded-pill" placeholder="Enter Tracking # (e.g. FLT-...)" required />
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 text-white">Track</button>
                    </form>
                </div>

                @{
                    var arrivedShipments = Model.MyDeliveries.Where(d => d.RequestedStatus == "Arrived at Destination Warehouse").ToList();
                }
                @if (arrivedShipments.Any())
                {
                    <div class="mb-4">
                        @foreach (var arr in arrivedShipments)
                        {
                            <div class="card border-primary shadow-sm rounded-4 p-4 bg-primary-subtle bg-opacity-25 mb-3">
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-primary text-white rounded-pill px-3 py-1 font-mono">
                                                <i class="bi bi-building me-1"></i> ARRIVED AT DESTINATION WAREHOUSE
                                            </span>
                                            <span class="badge bg-light text-dark border font-mono">@arr.TrackingNumber</span>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1">
                                            Your parcel has arrived at our destination warehouse!
                                        </h5>
                                        <p class="text-secondary small mb-2">
                                            Destination Hub: <strong class="text-dark">@(arr.DestinationWarehouseName ?? "Fleetify Destination Warehouse Hub")</strong>
                                            @if (!string.IsNullOrEmpty(arr.DestinationWarehouseAddress))
                                            {
                                                <span>(@arr.DestinationWarehouseAddress)</span>
                                            }
                                        </p>
                                        <div class="small">
                                            <span class="text-secondary">Current Preference:</span>
                                            <span class="badge @(arr.DestinationType == "WarehousePickup" ? "bg-info text-white" : "bg-success text-white") rounded-pill">
                                                @(arr.DestinationType == "WarehousePickup" ? "Self-Pickup from Warehouse" : "Doorstep Delivery to Address")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <form asp-action="SetDestinationDeliveryPreference" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@arr.RequestID" />
                                            <input type="hidden" name="preference" value="WarehousePickup" />
                                            <button type="submit" class="btn @(arr.DestinationType == "WarehousePickup" ? "btn-info text-white" : "btn-outline-info") rounded-pill px-3 py-2 btn-sm fw-semibold">
                                                <i class="bi bi-box-arrow-in-down-right me-1"></i> I Will Pick Up at Warehouse
                                            </button>
                                        </form>
                                        <form asp-action="SetDestinationDeliveryPreference" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@arr.RequestID" />
                                            <input type="hidden" name="preference" value="DoorstepDelivery" />
                                            <button type="submit" class="btn @(arr.DestinationType == "DoorstepDelivery" ? "btn-success text-white" : "btn-outline-success") rounded-pill px-3 py-2 btn-sm fw-semibold">
                                                <i class="bi bi-truck me-1"></i> Deliver to My Address
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (Model.MyDeliveries.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th>Tracking #</th>
                                    <th>Date</th>
                                    <th>Pickup &rarr; Dropoff</th>
                                    <th>Services</th>
                                    <th>Weight</th>
                                    <th>Speed</th>
                                    <th>Vehicle</th>
                                    <th>Cost</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.MyDeliveries)
                                {
                                    <tr>
                                        <td class="fw-bold font-mono text-primary">@d.TrackingNumber</td>
                                        <td>@d.RequestDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 200px;">
                                                <i class="bi bi-circle-fill text-muted me-1 small"></i>@d.PickupLocation
                                                <br />
                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@d.DropoffLocation
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                <span class="badge @(d.OriginType == "WarehouseDropoff" ? "bg-light text-primary border" : "bg-light text-secondary border")" style="font-size: 0.7rem;">
                                                    <i class="bi @(d.OriginType == "WarehouseDropoff" ? "bi-building" : "bi-house-door") me-1"></i>@(d.OriginType == "WarehouseDropoff" ? "Wh. Dropoff" : "Doorstep Pick")
                                                </span>
                                                <span class="badge @(d.DestinationType == "WarehousePickup" ? "bg-info-subtle text-info border border-info-subtle" : "bg-light text-secondary border")" style="font-size: 0.7rem;">
                                                    <i class="bi @(d.DestinationType == "WarehousePickup" ? "bi-box-arrow-in-down-right" : "bi-truck") me-1"></i>@(d.DestinationType == "WarehousePickup" ? "Wh. Pickup" : "Doorstep Del")
                                                </span>
                                                @if (d.IsPrivateTransport)
                                                {
                                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle" style="font-size: 0.65rem;">
                                                        <i class="bi bi-shield-lock me-1"></i>Dedicated Private
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td><strong>@Math.Floor(d.ParcelWeight).ToString("F0")</strong> kg</td>
                                        <td>
                                            @{
                                                var speed = string.IsNullOrWhiteSpace(d.RouteType) ? "Normal" : d.RouteType;
                                                var speedBadge = speed == "Express" ? "bg-danger-subtle text-danger" : speed == "Fast" ? "bg-warning-subtle text-warning-emphasis" : "bg-light text-dark";
                                            }
                                            <span class="badge @speedBadge border">@speed</span>
                                        </td>
                                        <td>
                                            @{
                                                var vIcon = (d.VehicleType ?? "Truck") switch {
                                                    "Bike" => "bi-bicycle",
                                                    "Pickup" => "bi-truck",
                                                    "Van" => "bi-box-seam",
                                                    _ => "bi-truck"
                                                };
                                            }
                                            <span class="badge bg-primary-subtle text-primary border"><i class="bi @vIcon me-1"></i>@d.VehicleType</span>
                                        </td>
                                        <td class="fw-bold text-dark">Rs. @Math.Floor(d.EstimatedCost).ToString("F0")</td>
                                        <td>
                                            @if (d.RequestedStatus == "Delivered")
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Delivered</span>
                                            }
                                            else if (d.RequestedStatus == "ArrivedAtWarehouse" || d.RequestedStatus == "Arrived at Destination Warehouse")
                                            {
                                                <span class="badge bg-primary text-white rounded-pill px-3 py-1"><i class="bi bi-building me-1"></i>At Destination Hub</span>
                                            }
                                            else if (d.WeightStatus == "Finalized" || d.RequestedStatus == "Cost Finalized")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Cost Finalized</span>
                                            }
                                            else if (d.WeightStatus == "VerifiedMatched" || d.RequestedStatus == "Weight Verified")
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1"><i class="bi bi-shield-check me-1"></i>Weight Verified</span>
                                            }
                                            else if (d.WeightStatus == "DiscrepancyReported" || d.RequestedStatus == "Weight Reported")
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1"><i class="bi bi-exclamation-triangle me-1"></i>Weight Reported</span>
                                            }
                                            else if (d.RequestedStatus == "In-Transit")
                                            {
                                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">In-Transit</span>
                                            }
                                            else if (d.RequestedStatus == "Assigned")
                                            {
                                                <span class="badge bg-info-subtle text-info rounded-pill px-3 py-1">Driver Assigned</span>
                                            }
                                            else if (d.RequestedStatus == "Cancelled")
                                            {
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">Pending Verification</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end align-items-center gap-1">
                                                <a asp-action="Track" asp-route-trackingNumber="@d.TrackingNumber" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-1" title="Track Live">
                                                    <i class="bi bi-geo-alt"></i>
                                                </a>
                                                @{
                                                    var elapsedMins = (DateTime.UtcNow - d.RequestDate).TotalMinutes;
                                                    var isEditable = elapsedMins <= 60.0 && d.RequestedStatus == "Pending";
                                                    var minsLeft = Math.Max(0, (int)(60.0 - elapsedMins));
                                                }
                                                @if (isEditable)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-1" title="Edit Request (~@minsLeft mins left)"
                                                            onclick="openEditModal(@d.RequestID, '@d.TrackingNumber', '@Html.Raw(d.PickupLocation.Replace("'", "\\'"))', '@Html.Raw(d.DropoffLocation.Replace("'", "\\'"))', @d.ParcelWeight, '@Html.Raw((d.RouteType ?? "Normal").Replace("'", "\\'"))', '@Html.Raw((d.ParcelDescription ?? "").Replace("'", "\\'"))', '@Html.Raw((d.VehicleType ?? "Truck").Replace("'", "\\'"))')">
                                                        <i class="bi bi-pencil-square text-dark"></i>
                                                    </button>
                                                    <form asp-action="CancelDelivery" method="post" class="d-inline" onsubmit="return confirm('Aap yeh delivery request cancel karna chahte hain? (Tracking: @d.TrackingNumber)');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@d.RequestID" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1" title="Cancel (~@minsLeft mins left)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border rounded-pill small ms-1" style="font-size: 0.65rem;" title="1-hour window">
                                                        <i class="bi bi-hourglass-split"></i> @(minsLeft)m
                                                    </span>
                                                }
                                                else if (d.RequestedStatus != "Cancelled")
                                                {
                                                    <span class="badge bg-light text-muted border rounded-pill small ms-1" style="font-size: 0.65rem;" title="1-hour window closed; locked for shipping">
                                                        <i class="bi bi-lock-fill"></i> Locked
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-box2 fs-1 mb-2"></i>
                        <h5>No deliveries requested yet.</h5>
                        <p class="small">Switch to the "New Delivery" tab above to book your first delivery.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- POP-UP 1: SUBMIT DELIVERY 1-HOUR LOCK NOTICE MODAL -->
<div class="modal fade" id="submitNoticeModal" tabindex="-1" aria-labelledby="submitNoticeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-warning bg-opacity-10 border-bottom-0 pb-2 pt-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-warning text-dark p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="submitNoticeModalLabel">Important Delivery Notice</h5>
                        <span class="text-muted small">1-Hour Edit &amp; Cancellation Policy</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <!-- Block 1: Time limit (unified into 1 paragraph) -->
                <div class="alert alert-warning border-0 rounded-3 p-3 mb-2">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-clock-history fs-4 text-warning-emphasis flex-shrink-0 mt-1"></i>
                        <div class="small text-dark">
                            <strong>Time limit:</strong> You can only Edit, Delete, or Cancel this delivery request within 1 hour (60 minutes) of submission. Please note that the delivery request will lock automatically after 1 hour, and once locked, no further modifications or cancellations can be processed.
                        </div>
                    </div>
                </div>

                <!-- Block 2: Weight Verification & Cost Finalization -->
                <div class="alert alert-info border-0 rounded-3 p-3 mb-3 bg-info-subtle">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-shield-check fs-4 text-primary flex-shrink-0 mt-1"></i>
                        <div class="small text-dark">
                            <strong>Weight Verification &amp; Final Cost:</strong> When the driver arrives to pick up your parcel, they will physically verify the actual weight. The notification with your confirmed original cost will be sent to you after the driver's verification is completed.
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-2 small text-uppercase letter-spacing-1">Order Details Summary:</h6>
                <div class="bg-light rounded-3 p-3 small mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Pickup:</span>
                        <strong class="text-dark text-truncate ms-2" style="max-width: 250px;" id="modalPickupText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Dropoff:</span>
                        <strong class="text-dark text-truncate ms-2" style="max-width: 250px;" id="modalDropoffText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Weight:</span>
                        <strong class="text-dark" id="modalWeightText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Delivery Type:</span>
                        <strong class="text-dark" id="modalTypeText">Normal Delivery</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Vehicle Selected:</span>
                        <span class="badge bg-primary text-white" id="modalVehicleText"><i class="bi bi-truck me-1"></i>Truck</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Origin Service:</span>
                        <strong class="text-dark" id="modalOriginText">Doorstep Pickup</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Destination Service:</span>
                        <strong class="text-dark" id="modalDestText">Doorstep Delivery</strong>
                    </div>
                    <div id="modalSpecialRow" class="d-flex justify-content-between mb-1 d-none text-warning-emphasis">
                        <span><i class="bi bi-truck me-1"></i>Special Delivery (+15%):</span>
                        <strong class="font-mono" id="modalSpecialSurchargeText">+Rs. 0</strong>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                        <strong class="text-dark">Estimated Cost:</strong>
                        <strong class="text-primary fs-6" id="modalCostText">-</strong>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Review Again</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 text-white fw-semibold" onclick="confirmAndSubmitDelivery()">
                    <i class="bi bi-check2-circle me-1"></i>I Understand, Confirm Booking
                </button>
            </div>
        </div>
    </div>
</div>

<!-- POP-UP 2: EDIT DELIVERY MODAL (Within 1-Hour Window) -->
<div class="modal fade" id="editDeliveryModal" tabindex="-1" aria-labelledby="editDeliveryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0 pt-3 px-4">
                <h5 class="modal-title fw-bold text-dark" id="editDeliveryModalLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Delivery (<span id="editTrackingNumber"></span>)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editDeliveryForm" asp-action="EditDelivery" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editRequestId" name="id" value="" />
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Vehicle Type</label>
                    <select id="editVehicleType" name="VehicleType" class="form-select rounded-3 py-2 fw-semibold">
                        <option value="Bike">Bike (Up to 40 kg)</option>
                        <option value="Pickup">Pickup (Up to 800 kg)</option>
                        <option value="Van">Van (Up to 1,500 kg)</option>
                        <option value="Truck">Truck (Up to 5,000 kg)</option>
                    </select>
                </div>
                <input type="hidden" id="editHeight" name="Height" value="1.0" />
                <input type="hidden" id="editWidth" name="Width" value="1.0" />

                <div class="modal-body px-4 py-3">
                    <div class="alert alert-info border-0 rounded-3 py-2 px-3 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>You are modifying this delivery request within the 1-hour allowed window.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Pickup Address</label>
                        <input id="editPickup" name="PickupLocation" class="form-control rounded-3 py-2" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Dropoff Address</label>
                        <input id="editDropoff" name="DropoffLocation" class="form-control rounded-3 py-2" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Weight (kg)</label>
                        <input id="editWeight" name="ParcelWeight" type="number" step="0.5" min="0.5" class="form-control rounded-3 py-2" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Delivery Type</label>
                        <select id="editRouteType" name="RouteType" class="form-select rounded-3 py-2 fw-semibold">
                            <option value="Normal">Normal Delivery</option>
                            <option value="Fast">Fast Delivery</option>
                            <option value="Express">Express Delivery</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Package Description</label>
                        <input id="editDesc" name="ParcelDescription" class="form-control rounded-3 py-2" />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 text-white fw-semibold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .custom-pickup-pin, .custom-dropoff-pin, .custom-vehicle-marker {
            background: transparent !important;
            border: none !important;
        }
        .pin-bubble {
            width: 32px;
            height: 32px;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 14px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.35);
            position: relative;
        }
        .pin-bubble i {
            transform: rotate(45deg);
        }
        .pin-pickup {
            background: linear-gradient(135deg, #10b981, #047857);
            border: 2px solid #ffffff;
        }
        .pin-dropoff {
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            border: 2px solid #ffffff;
        }
        .pin-pulse {
            position: absolute;
            width: 22px;
            height: 10px;
            border-radius: 50%;
            bottom: -5px;
            left: 5px;
            opacity: 0.6;
            animation: pinPulseAnim 2s infinite ease-out;
        }
        .pin-pulse-green {
            background: rgba(16, 185, 129, 0.4);
        }
        .pin-pulse-red {
            background: rgba(239, 68, 68, 0.4);
        }
        @@keyframes pinPulseAnim {
            0% { transform: scale(0.6); opacity: 0.8; }
            100% { transform: scale(2.2); opacity: 0; }
        }
        .vehicle-marker-badge {
            width: 34px;
            height: 34px;
            background: #0f172a;
            border: 2px solid #38bdf8;
            color: #38bdf8;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            position: relative;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.45);
        }
        .vehicle-marker-badge .live-dot {
            position: absolute;
            top: -2px;
            right: -2px;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #22c55e;
            border: 1.5px solid #fff;
            animation: liveDotPulse 1.5s infinite;
        }
        @@keyframes liveDotPulse {
            0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
            70% { box-shadow: 0 0 0 7px rgba(34, 197, 94, 0); }
            100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
        }
        .leaflet-popup-content-wrapper {
            border-radius: 10px !important;
            box-shadow: 0 6px 18px rgba(0,0,0,0.12) !important;
        }
        .leaflet-popup-content {
            margin: 8px 10px !important;
            font-size: 0.78rem !important;
            line-height: 1.35 !important;
        }
        .selectable-option-card {
            border: 1.5px solid #e2e8f0;
            background: #ffffff;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
        }
        .selectable-option-card:hover {
            border-color: #94a3b8;
            background: #f8fafc;
        }
        .selectable-option-card:has(input:checked) {
            border-color: #2563eb !important;
            background: rgba(37, 99, 235, 0.05) !important;
            box-shadow: 0 0 0 1px #2563eb;
        }
        .cursor-pointer {
            cursor: pointer;
        }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let estimateTimeout = null;
        let map = null;
        let routeLayer = null;
        let routeGlowLayer = null;
        let pickupMarker = null;
        let dropoffMarker = null;
        let vehicleMarker = null;
        let vehicleAnimInterval = null;
        let lastEstimateData = null;

        // Built-in Pakistani Cities Dictionary for Instant Zero-Delay Map Rendering
        const PAK_CITIES = {
            'lahore': [31.5204, 74.3587],
            'karachi': [24.8607, 67.0011],
            'islamabad': [33.6844, 73.0479],
            'rawalpindi': [33.5651, 73.0169],
            'faisalabad': [31.4504, 73.1350],
            'multan': [30.1575, 71.5249],
            'gujranwala': [32.1877, 74.1945],
            'peshawar': [34.0151, 71.5249],
            'quetta': [30.1798, 66.9750],
            'sialkot': [32.4945, 74.5229],
            'kasur': [31.1179, 74.4506],
            'murree': [33.9070, 73.3943],
            'abbottabad': [34.1688, 73.2215],
            'hyderabad': [25.3960, 68.3578],
            'bahawalpur': [29.3956, 71.6836],
            'sargodha': [32.0836, 72.6711],
            'sukkur': [27.7052, 68.8574],
            'jhelum': [32.9425, 73.7257],
            'gujrat': [32.5742, 74.0754],
            'sheikhupura': [31.7131, 73.9783],
            'sahiwal': [30.6682, 73.1114],
            'okara': [30.8081, 73.4458],
            'rahim yar khan': [28.4212, 70.2989],
            'larkana': [27.5590, 68.2120],
            'mardan': [34.1989, 72.0450],
            'swat': [34.7758, 72.3626],
            'mingora': [34.7758, 72.3626],
            'muzaffarabad': [34.3700, 73.4711],
            'mirpur': [33.1478, 73.7519],
            'gwadar': [25.1216, 62.3254]
        };

        function resolveClientCoords(addr) {
            if (!addr) return null;
            const clean = addr.toLowerCase();
            for (const [name, coords] of Object.entries(PAK_CITIES)) {
                if (clean.includes(name)) return coords;
            }
            return null;
        }

        function initRouteMap() {
            const mapEl = document.getElementById('routeMap');
            if (!mapEl || map) return;
            map = L.map('routeMap', { zoomControl: false }).setView([31.5204, 74.3587], 7);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: 'Map data &copy; OpenStreetMap'
            }).addTo(map);
            L.control.zoom({ position: 'topright' }).addTo(map);
            setTimeout(() => { if (map) map.invalidateSize(); }, 250);
        }

        function toggleOriginPickupMode() {
            const isDoorstep = document.getElementById('originDoorstep')?.checked;
            const pickupContainer = document.getElementById('pickupAddrContainer');
            const warehouseInfo = document.getElementById('originWarehouseInfo');
            const pickupInput = document.getElementById('pickupAddr');
            const whSelect = document.getElementById('originWarehouseSelect');

            if (isDoorstep) {
                if (pickupContainer) pickupContainer.classList.remove('d-none');
                if (warehouseInfo) warehouseInfo.classList.add('d-none');
                if (pickupInput) {
                    pickupInput.required = true;
                    if (whSelect && pickupInput.value === whSelect.value) {
                        pickupInput.value = '';
                    }
                }
            } else {
                if (pickupContainer) pickupContainer.classList.add('d-none');
                if (warehouseInfo) warehouseInfo.classList.remove('d-none');
                if (pickupInput) {
                    pickupInput.required = false;
                    if (whSelect) {
                        pickupInput.value = whSelect.value;
                    }
                }
            }
            onOriginWarehouseChanged();
        }

        function onOriginWarehouseChanged() {
            const whSelect = document.getElementById('originWarehouseSelect');
            const isWarehouse = document.getElementById('originWarehouse')?.checked;
            const pickupInput = document.getElementById('pickupAddr');
            const nameDisplay = document.getElementById('originWarehouseNameDisplay');

            if (whSelect && nameDisplay) {
                nameDisplay.innerText = whSelect.options[whSelect.selectedIndex]?.text || whSelect.value;
            }
            if (isWarehouse && whSelect && pickupInput) {
                pickupInput.value = whSelect.value;
            }
            debouncedUpdate();
        }

        function toggleDestinationDeliveryMode() {
            const isDoorstep = document.getElementById('destDoorstep')?.checked;
            const dropoffContainer = document.getElementById('dropoffAddrContainer');
            const destWarehouseInfo = document.getElementById('destWarehouseInfo');
            const dropoffInput = document.getElementById('dropoffAddr');
            const destSelect = document.getElementById('destWarehouseSelect');

            if (isDoorstep) {
                if (dropoffContainer) dropoffContainer.classList.remove('d-none');
                if (destWarehouseInfo) destWarehouseInfo.classList.add('d-none');
                if (dropoffInput) {
                    dropoffInput.required = true;
                    if (destSelect && dropoffInput.value === destSelect.value) {
                        dropoffInput.value = '';
                    }
                }
            } else {
                if (dropoffContainer) dropoffContainer.classList.add('d-none');
                if (destWarehouseInfo) destWarehouseInfo.classList.remove('d-none');
                if (dropoffInput) {
                    dropoffInput.required = false;
                    if (destSelect) {
                        dropoffInput.value = destSelect.value;
                    }
                }
            }
            onDestWarehouseChanged();
        }

        function onDestWarehouseChanged() {
            const destSelect = document.getElementById('destWarehouseSelect');
            const isWarehouse = document.getElementById('destWarehouse')?.checked;
            const dropoffInput = document.getElementById('dropoffAddr');
            const nameDisplay = document.getElementById('destWarehouseNameDisplay');

            if (destSelect && nameDisplay) {
                nameDisplay.innerText = destSelect.options[destSelect.selectedIndex]?.text || destSelect.value;
            }
            if (isWarehouse && destSelect && dropoffInput) {
                dropoffInput.value = destSelect.value;
            }
            updateWarehouseWarningNotice(lastEstimateData);
            debouncedUpdate();
        }

        function decodePolyline(str, precision) {
            var index = 0, lat = 0, lng = 0, coordinates = [], shift = 0, result = 0, byte = null, lat_change, lng_change;
            var factor = Math.pow(10, precision || 5);
            while (index < str.length) {
                byte = null; shift = 0; result = 0;
                do {
                    byte = str.charCodeAt(index++) - 63;
                    result |= (byte & 0x1f) << shift;
                    shift += 5;
                } while (byte >= 0x20);
                lat_change = ((result & 1) ? ~(result >> 1) : (result >> 1));
                shift = 0; result = 0;
                do {
                    byte = str.charCodeAt(index++) - 63;
                    result |= (byte & 0x1f) << shift;
                    shift += 5;
                } while (byte >= 0x20);
                lng_change = ((result & 1) ? ~(result >> 1) : (result >> 1));
                lat += lat_change;
                lng += lng_change;
                coordinates.push([lat / factor, lng / factor]);
            }
            return coordinates;
        }

        function clearMapLayers() {
            if (!map) return;
            if (vehicleAnimInterval) {
                clearInterval(vehicleAnimInterval);
                vehicleAnimInterval = null;
            }
            if (routeGlowLayer) { map.removeLayer(routeGlowLayer); routeGlowLayer = null; }
            if (routeLayer) { map.removeLayer(routeLayer); routeLayer = null; }
            if (pickupMarker) { map.removeLayer(pickupMarker); pickupMarker = null; }
            if (dropoffMarker) { map.removeLayer(dropoffMarker); dropoffMarker = null; }
            if (vehicleMarker) { map.removeLayer(vehicleMarker); vehicleMarker = null; }
        }

        function renderRouteOnMap(startPt, endPt, coords, pickupText, dropoffText, providerName) {
            initRouteMap();
            if (!map) return;
            clearMapLayers();

            // 1. Draw Polyline Route if available
            if (coords && coords.length > 1) {
                routeGlowLayer = L.polyline(coords, { color: '#60a5fa', weight: 8, opacity: 0.35, lineCap: 'round' }).addTo(map);
                routeLayer = L.polyline(coords, { color: '#1d4ed8', weight: 4, opacity: 0.95, lineJoin: 'round' }).addTo(map);
            }

            // 2. Custom Green Pickup Pin
            if (startPt) {
                const pickupIcon = L.divIcon({
                    className: 'custom-pickup-pin',
                    html: '<div class="pin-bubble pin-pickup shadow-sm"><i class="bi bi-geo-alt-fill"></i></div><div class="pin-pulse pin-pulse-green"></div>',
                    iconSize: [32, 32],
                    iconAnchor: [16, 32],
                    popupAnchor: [0, -32]
                });
                pickupMarker = L.marker(startPt, { icon: pickupIcon }).addTo(map);
                pickupMarker.bindPopup(`<strong>📍 Pickup Location</strong><br/><span class="text-secondary">${pickupText || 'Sender Address'}</span>`);
            }

            // 3. Custom Red Destination Pin
            if (endPt) {
                const dropoffIcon = L.divIcon({
                    className: 'custom-dropoff-pin',
                    html: '<div class="pin-bubble pin-dropoff shadow-sm"><i class="bi bi-flag-fill"></i></div><div class="pin-pulse pin-pulse-red"></div>',
                    iconSize: [32, 32],
                    iconAnchor: [16, 32],
                    popupAnchor: [0, -32]
                });
                dropoffMarker = L.marker(endPt, { icon: dropoffIcon }).addTo(map);
                dropoffMarker.bindPopup(`<strong>🏁 Destination</strong><br/><span class="text-secondary">${dropoffText || 'Recipient Address'}</span>`);
            }

            // 4. Live Moving Courier / Fleet Vehicle Marker
            if (coords && coords.length > 1) {
                const vehicleIcon = L.divIcon({
                    className: 'custom-vehicle-marker',
                    html: '<div class="vehicle-marker-badge"><i class="bi bi-truck"></i><span class="live-dot"></span></div>',
                    iconSize: [34, 34],
                    iconAnchor: [17, 17],
                    popupAnchor: [0, -17]
                });
                let currentStep = 0;
                vehicleMarker = L.marker(coords[0], { icon: vehicleIcon, zIndexOffset: 1000 }).addTo(map);
                vehicleMarker.bindTooltip('<span class="fw-semibold">Fleetify Live Courier</span>', { permanent: false, direction: 'top' });

                const totalPoints = coords.length;
                const stepInterval = Math.max(90, Math.min(300, Math.floor(6000 / totalPoints)));
                vehicleAnimInterval = setInterval(() => {
                    currentStep = (currentStep + 1) % totalPoints;
                    if (vehicleMarker && coords[currentStep]) {
                        vehicleMarker.setLatLng(coords[currentStep]);
                    }
                }, stepInterval);
            }

            // 5. Fit bounds with padding so everything is visible
            if (routeLayer) {
                map.fitBounds(routeLayer.getBounds(), { padding: [30, 30], maxZoom: 14 });
            } else if (startPt && endPt) {
                const bounds = L.latLngBounds([startPt, endPt]);
                map.fitBounds(bounds, { padding: [30, 30], maxZoom: 14 });
            } else if (startPt) {
                map.setView(startPt, 11);
            }

            // 6. Update display texts below map
            const origEl = document.getElementById('mapOriginDisplay');
            const destEl = document.getElementById('mapDestDisplay');
            if (origEl) origEl.innerHTML = `<i class="bi bi-geo-alt-fill text-success me-1"></i>${pickupText || 'Origin'}`;
            if (destEl) destEl.innerHTML = `<i class="bi bi-flag-fill text-danger me-1"></i>${dropoffText || 'Destination'}`;

            setTimeout(() => { if (map) map.invalidateSize(); }, 150);
        }

        // Instant client-side preview for recognized Pakistani cities while typing
        function instantClientMapPreview() {
            const isOriginDoorstep = document.getElementById('originDoorstep')?.checked;
            const originWh = document.getElementById('originWarehouseSelect')?.value || '';
            const pickupVal = document.getElementById('pickupAddr')?.value || '';
            const pickup = isOriginDoorstep ? (pickupVal || originWh) : originWh;

            const isDestDoorstep = document.getElementById('destDoorstep')?.checked;
            const destWh = document.getElementById('destWarehouseSelect')?.value || '';
            const dropoffVal = document.getElementById('dropoffAddr')?.value || '';
            const dropoff = isDestDoorstep ? (dropoffVal || destWh) : destWh;

            const pCoord = resolveClientCoords(pickup);
            const dCoord = resolveClientCoords(dropoff);

            if (pCoord && dCoord) {
                renderRouteOnMap(pCoord, dCoord, [pCoord, dCoord], pickup, dropoff, 'Fleetify Instant Preview');
            } else if (pCoord) {
                renderRouteOnMap(pCoord, null, null, pickup, null, 'Fleetify Instant Preview');
            } else if (dCoord) {
                renderRouteOnMap(null, dCoord, null, null, dropoff, 'Fleetify Instant Preview');
            }
        }

        // Real-time AI & Map Cost Calculation (((1.5 * Distance * Weight) + Petrol) * Speed + 15% Special Delivery)
        function updateAiEstimate() {
            initRouteMap();

            const isDoorstep = document.getElementById('originDoorstep')?.checked;
            const originType = isDoorstep ? 'DoorstepPickup' : 'WarehouseDropoff';
            let pickup = document.getElementById('pickupAddr')?.value || '';
            const whSelect = document.getElementById('originWarehouseSelect');

            if (!isDoorstep && whSelect) {
                pickup = whSelect.value;
                if (document.getElementById('pickupAddr')) {
                    document.getElementById('pickupAddr').value = pickup;
                }
            } else if (isDoorstep && !pickup && whSelect) {
                pickup = whSelect.value;
            }

            const isDestDoorstep = document.getElementById('destDoorstep')?.checked;
            const destType = isDestDoorstep ? 'DoorstepDelivery' : 'WarehousePickup';
            let dropoff = document.getElementById('dropoffAddr')?.value || '';
            const destWhSelect = document.getElementById('destWarehouseSelect');

            if (!isDestDoorstep && destWhSelect) {
                dropoff = destWhSelect.value;
                if (document.getElementById('dropoffAddr')) {
                    document.getElementById('dropoffAddr').value = dropoff;
                }
            } else if (isDestDoorstep && !dropoff && destWhSelect) {
                dropoff = destWhSelect.value;
            }

            const weight = parseFloat(document.getElementById('packageWeight')?.value) || 2.0;
            const vehicle = document.getElementById('vehicleType')?.value || 'Truck';
            const route = document.getElementById('deliveryType')?.value || 'Normal';

            const specialCities = ['sahiwal', 'okara', 'kasur', 'kasoor', 'sukkur'];
            const dropLower = dropoff.toLowerCase();
            const matchedSpecial = specialCities.find(c => dropLower.includes(c));

            fetch('/api/ai/estimate-cost', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    pickupLocation: pickup,
                    dropoffLocation: dropoff,
                    parcelWeight: weight,
                    vehicleType: vehicle,
                    routeType: route,
                    originType: originType,
                    destinationType: destType
                })
            })
            .then(res => {
                if (!res.ok) throw new Error('Network error: ' + res.status);
                return res.json();
            })
            .then(data => {
                lastEstimateData = data;

                if (document.getElementById('estDistanceKm')) {
                    document.getElementById('estDistanceKm').innerText = Math.floor(data.distanceKm) + ' km';
                }
                const currentWeight = (data.parcelWeight || weight || 2.0);
                if (document.getElementById('estWeight')) {
                    document.getElementById('estWeight').innerText = Math.floor(currentWeight) + ' kg';
                }
                if (document.getElementById('estDeliveryType')) {
                    document.getElementById('estDeliveryType').innerText = (data.deliveryType || route);
                }
                document.getElementById('estTotal').innerText = 'Rs. ' + Math.floor(data.estimatedTotal);
                document.getElementById('estDeliveryDays').innerText = data.estimatedDeliveryDays;

                const provBadge = document.getElementById('estMapProvider');
                if (provBadge && data.provider) {
                    provBadge.innerHTML = `<i class="bi bi-broadcast text-success me-1"></i>${data.provider} Verified`;
                }

                // Cost Estimate Surcharge Row (+15% for special delivery destination)
                const isSpecial = data.isSpecialDelivery || data.isPrivateTransport || !!matchedSpecial;
                const surchargeRow = document.getElementById('estSpecialSurchargeRow');
                const surchargeAmt = document.getElementById('estSpecialSurchargeAmount');
                const hubStatus = document.getElementById('estHubStatus');

                if (isSpecial) {
                    if (surchargeRow) surchargeRow.classList.remove('d-none');
                    if (surchargeAmt) {
                        const extra15 = (data.specialDeliverySurcharge > 0) 
                            ? data.specialDeliverySurcharge 
                            : (data.privateTransportSurcharge > 0 ? data.privateTransportSurcharge : Math.round(data.estimatedTotal * 0.15));
                        surchargeAmt.innerText = '+Rs. ' + Math.floor(extra15);
                    }
                    if (hubStatus) hubStatus.innerText = 'Special Delivery Hub (+15%)';
                } else {
                    if (surchargeRow) surchargeRow.classList.add('d-none');
                    if (hubStatus) {
                        hubStatus.innerText = (data.originCity && data.destinationCity) 
                            ? `${data.originCity} Hub → ${data.destinationCity} Hub` 
                            : 'Connected Hub Network';
                    }
                }

                // Trigger the warning notice ONLY conditionally when the user selects a city without a warehouse while choosing warehouse operations
                updateWarehouseWarningNotice(data);

                const distInput = document.getElementById('distanceKm');
                if (distInput) distInput.value = data.distanceKm;

                // Render Route Polyline & Live Pins on Map
                let routeCoords = null;
                if (data.routePolyline) {
                    try {
                        routeCoords = decodePolyline(data.routePolyline);
                    } catch (e) {
                        console.warn('Polyline decode error:', e);
                    }
                }

                let startCoord = null;
                let endCoord = null;

                if (data.originLat && data.originLng) {
                    startCoord = [data.originLat, data.originLng];
                } else if (routeCoords && routeCoords.length > 0) {
                    startCoord = routeCoords[0];
                } else {
                    startCoord = resolveClientCoords(pickup);
                }

                if (data.destinationLat && data.destinationLng) {
                    endCoord = [data.destinationLat, data.destinationLng];
                } else if (routeCoords && routeCoords.length > 0) {
                    endCoord = routeCoords[routeCoords.length - 1];
                } else {
                    endCoord = resolveClientCoords(dropoff);
                }

                // If polyline was missing but start and end exist, construct straight-line coords
                if ((!routeCoords || routeCoords.length < 2) && startCoord && endCoord) {
                    routeCoords = [startCoord, endCoord];
                }

                if (startCoord || endCoord || routeCoords) {
                    renderRouteOnMap(startCoord, endCoord, routeCoords, pickup, dropoff, data.provider);
                }
            })
            .catch(err => {
                console.error("Error fetching AI estimate:", err);
                instantClientMapPreview();
            });
        }

        function updateWarehouseWarningNotice(data) {
            const specialNotice = document.getElementById('specialDeliveryNotice');
            const specialCitySpan = document.getElementById('specialCityName');
            if (!specialNotice) return;

            // Check if user chose warehouse operations:
            // "trigger the warning notice 'Fleetify does not operate a warehouse in [City]' only conditionally when the user selects a city without a warehouse while choosing warehouse operations"
            const destWarehouseRadio = document.getElementById('destWarehouse');
            const isWarehouseOp = destWarehouseRadio && destWarehouseRadio.checked;

            // If user did NOT choose warehouse operations (e.g. Doorstep Delivery is selected), do NOT show warehouse warning notice!
            if (!isWarehouseOp) {
                specialNotice.classList.add('d-none');
                return;
            }

            // In Warehouse Self-Pickup mode, check the selected destination warehouse / city:
            const destWhSelect = document.getElementById('destWarehouseSelect');
            const selectedOpt = destWhSelect ? destWhSelect.options[destWhSelect.selectedIndex] : null;
            const isNoWarehouseAttr = selectedOpt?.getAttribute('data-no-warehouse') === 'true';

            const dropoffInput = document.getElementById('dropoffAddr');
            const dropoffVal = (dropoffInput && dropoffInput.value ? dropoffInput.value : (destWhSelect ? destWhSelect.value : '')).trim();

            const warehouseCities = ['lahore', 'karachi', 'islamabad', 'rawalpindi', 'faisalabad', 'multan', 'gujranwala', 'peshawar', 'sialkot', 'quetta'];
            const specialCities = ['sahiwal', 'okara', 'kasur', 'kasoor', 'sukkur'];

            const dropLower = dropoffVal.toLowerCase();
            const hasWarehouse = warehouseCities.some(c => dropLower.includes(c));
            const matchedSpecial = specialCities.find(c => dropLower.includes(c));
            const isCityWithoutWarehouse = isNoWarehouseAttr || matchedSpecial || (!hasWarehouse && dropLower.length >= 3);

            // Only show if user chose warehouse operations AND city has no warehouse!
            if (isCityWithoutWarehouse && !hasWarehouse) {
                specialNotice.classList.remove('d-none');
                let displayCity = selectedOpt?.getAttribute('data-city')
                    || (matchedSpecial ? (matchedSpecial.charAt(0).toUpperCase() + matchedSpecial.slice(1)) : (data?.destinationCity || dropoffVal.split(',')[0].trim()));
                if (displayCity.toLowerCase() === 'kasoor') displayCity = 'Kasur';
                if (specialCitySpan) specialCitySpan.innerText = displayCity;
            } else {
                specialNotice.classList.add('d-none');
            }
        }

        function toggleDestinationMode() {
            toggleDestinationDeliveryMode();
        }

        function debouncedUpdate() {
            instantClientMapPreview();
            clearTimeout(estimateTimeout);
            estimateTimeout = setTimeout(updateAiEstimate, 350);
        }

        // Pop-up trigger with validation and 1-hour policy notice
        function showDeliveryNoticeModal() {
            const form = document.getElementById('deliveryForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const isDoorstep = document.getElementById('originDoorstep')?.checked;
            const originWhSelect = document.getElementById('originWarehouseSelect');
            const pickupInput = document.getElementById('pickupAddr');

            if (!isDoorstep && originWhSelect && pickupInput) {
                pickupInput.value = originWhSelect.value;
            }

            const isDestDoorstep = document.getElementById('destDoorstep')?.checked;
            const destWhSelect = document.getElementById('destWarehouseSelect');
            const dropoffInput = document.getElementById('dropoffAddr');

            if (!isDestDoorstep && destWhSelect && dropoffInput) {
                dropoffInput.value = destWhSelect.value;
            }

            const destSelectedOpt = destWhSelect?.selectedOptions[0];
            const isNoWarehouse = destSelectedOpt?.getAttribute('data-no-warehouse') === 'true';
            if (!isDestDoorstep && isNoWarehouse) {
                const cityName = destSelectedOpt?.getAttribute('data-city') || 'this city';
                alert(`Fleetify does not operate a warehouse in ${cityName}. Warehouse self-pickup is not available here; please choose Doorstep Delivery instead.`);
                return;
            }

            const pickup = isDoorstep 
                ? (pickupInput?.value || 'Doorstep Location')
                : (originWhSelect?.selectedOptions[0]?.text || 'Origin Hub');

            const dropoff = isDestDoorstep 
                ? (dropoffInput?.value || 'Doorstep Destination')
                : (destWhSelect?.selectedOptions[0]?.text || 'Destination Hub');

            const rawWeight = parseFloat(document.getElementById('packageWeight')?.value) || 2.0;
            const weight = Math.floor(rawWeight);
            const typeSel = document.getElementById('deliveryType');
            const deliveryType = typeSel ? typeSel.options[typeSel.selectedIndex].text : 'Normal Delivery';
            const vehSel = document.getElementById('vehicleType');
            const vehicleText = vehSel ? vehSel.options[vehSel.selectedIndex].text : 'Truck (Up to 5,000 kg)';
            const total = document.getElementById('estTotal')?.innerText || 'Rs. 0';

            const originText = isDoorstep 
                ? 'Doorstep Pickup (Courier)' 
                : 'Warehouse Dropoff (' + (originWhSelect?.selectedOptions[0]?.text || 'Hub') + ')';

            const destText = isDestDoorstep 
                ? 'Doorstep Delivery (Address)' 
                : 'Warehouse Self Pickup (' + (destWhSelect?.selectedOptions[0]?.text || 'Hub') + ')';

            document.getElementById('modalPickupText').innerText = pickup;
            document.getElementById('modalDropoffText').innerText = dropoff;
            document.getElementById('modalWeightText').innerText = weight + ' kg';
            if (document.getElementById('modalTypeText')) {
                document.getElementById('modalTypeText').innerText = deliveryType;
            }
            if (document.getElementById('modalVehicleText')) {
                document.getElementById('modalVehicleText').innerText = vehicleText;
            }
            if (document.getElementById('modalOriginText')) {
                document.getElementById('modalOriginText').innerText = originText;
            }
            if (document.getElementById('modalDestText')) {
                document.getElementById('modalDestText').innerText = destText;
            }

            const specialCities = ['sahiwal', 'okara', 'kasur', 'kasoor', 'sukkur'];
            const dropLower = dropoff.toLowerCase();
            const matchedSpecial = specialCities.find(c => dropLower.includes(c)) || isNoWarehouse;
            const isSpecial = (lastEstimateData && (lastEstimateData.isSpecialDelivery || lastEstimateData.isPrivateTransport)) || !!matchedSpecial;

            const specialRow = document.getElementById('modalSpecialRow');
            const specialText = document.getElementById('modalSpecialSurchargeText');
            if (specialRow) {
                if (isSpecial) {
                    specialRow.classList.remove('d-none');
                    const extra15 = (lastEstimateData && (lastEstimateData.specialDeliverySurcharge || lastEstimateData.privateTransportSurcharge)) || 0;
                    if (specialText) specialText.innerText = '+Rs. ' + Math.floor(extra15);
                } else {
                    specialRow.classList.add('d-none');
                }
            }

            document.getElementById('modalCostText').innerText = total;

            const modalEl = document.getElementById('submitNoticeModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        function confirmAndSubmitDelivery() {
            document.getElementById('deliveryForm').submit();
        }

        function openEditModal(id, tracking, pickup, dropoff, weight, routeType, desc, vehicleType) {
            document.getElementById('editRequestId').value = id;
            document.getElementById('editTrackingNumber').innerText = tracking;
            document.getElementById('editPickup').value = pickup;
            document.getElementById('editDropoff').value = dropoff;
            document.getElementById('editWeight').value = weight;
            if (document.getElementById('editRouteType')) {
                document.getElementById('editRouteType').value = routeType || 'Normal';
            }
            if (document.getElementById('editVehicleType')) {
                document.getElementById('editVehicleType').value = vehicleType || 'Truck';
            }
            document.getElementById('editDesc').value = desc;

            const editModalEl = document.getElementById('editDeliveryModal');
            const modal = bootstrap.Modal.getOrCreateInstance(editModalEl);
            modal.show();
        }

        // Live interactive listeners
        document.getElementById('pickupAddr')?.addEventListener('input', debouncedUpdate);
        document.getElementById('dropoffAddr')?.addEventListener('input', () => {
            updateWarehouseWarningNotice(lastEstimateData);
            debouncedUpdate();
        });
        document.getElementById('packageWeight')?.addEventListener('input', debouncedUpdate);
        document.getElementById('deliveryType')?.addEventListener('change', updateAiEstimate);
        document.getElementById('vehicleType')?.addEventListener('change', updateAiEstimate);
        document.getElementById('originDoorstep')?.addEventListener('change', toggleOriginPickupMode);
        document.getElementById('originWarehouse')?.addEventListener('change', toggleOriginPickupMode);
        document.getElementById('originWarehouseSelect')?.addEventListener('change', onOriginWarehouseChanged);
        document.getElementById('destDoorstep')?.addEventListener('change', toggleDestinationDeliveryMode);
        document.getElementById('destWarehouse')?.addEventListener('change', toggleDestinationDeliveryMode);
        document.getElementById('destWarehouseSelect')?.addEventListener('change', onDestWarehouseChanged);

        // Fix map tile rendering when switching between tabs
        document.getElementById('new-delivery-tab')?.addEventListener('shown.bs.tab', () => {
            if (map) {
                setTimeout(() => map.invalidateSize(), 150);
            }
        });

        // Run on page load
        document.addEventListener('DOMContentLoaded', () => {
            initRouteMap();
            toggleOriginPickupMode();
            toggleDestinationDeliveryMode();
            updateWarehouseWarningNotice(null);
            updateAiEstimate();
        });
    </script>
}
