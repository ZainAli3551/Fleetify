        function resolveClientCoords(addr) {
            if (!addr) return null;
            const clean = addr.toLowerCase();
            for (const [name, coords] of Object.entries(PAK_CITIES)) {
                if (clean.includes(name)) return coords;
            }
            return null;
        }

        function initRouteMap() {
            const mapEl = document.getElementById('routeMap');
            if (!mapEl || map) return;
            map = L.map('routeMap', { zoomControl: false }).setView([31.5204, 74.3587], 7);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: 'Map data &copy; OpenStreetMap'
            }).addTo(map);
            L.control.zoom({ position: 'topright' }).addTo(map);
            setTimeout(() => { if (map) map.invalidateSize(); }, 250);
        }

        function toggleOriginPickupMode() {
            const isDoorstep = document.getElementById('originDoorstep')?.checked;
            const pickupContainer = document.getElementById('pickupAddrContainer');
            const warehouseInfo = document.getElementById('originWarehouseInfo');
            const pickupInput = document.getElementById('pickupAddr');
            const whSelect = document.getElementById('originWarehouseSelect');

            const selectedOpt = whSelect ? whSelect.options[whSelect.selectedIndex] : null;
            const doorstepDefault = selectedOpt ? (selectedOpt.getAttribute('data-doorstep-default') || '') : '';

            if (isDoorstep) {
                if (pickupContainer) pickupContainer.classList.remove('d-none');
                if (warehouseInfo) warehouseInfo.classList.add('d-none');
                if (pickupInput) {
                    pickupInput.required = true;
                    if (!pickupInput.value || (whSelect && pickupInput.value === whSelect.value) || pickupInput.value.startsWith('Fleetify')) {
                        pickupInput.value = doorstepDefault;
                    }
                }
            } else {
                if (pickupContainer) pickupContainer.classList.add('d-none');
                if (warehouseInfo) warehouseInfo.classList.remove('d-none');
                if (pickupInput) {
                    pickupInput.required = false;
                    if (whSelect) {
                        pickupInput.value = whSelect.value;
                    }
                }
            }
            onOriginWarehouseChanged();
        }

        function onOriginWarehouseChanged() {
            const whSelect = document.getElementById('originWarehouseSelect');
            const isWarehouse = document.getElementById('originWarehouse')?.checked;
            const isDoorstep = document.getElementById('originDoorstep')?.checked;
            const pickupInput = document.getElementById('pickupAddr');
            const nameDisplay = document.getElementById('originWarehouseNameDisplay');

            const selectedOpt = whSelect ? whSelect.options[whSelect.selectedIndex] : null;
            const doorstepDefault = selectedOpt ? (selectedOpt.getAttribute('data-doorstep-default') || '') : '';

            if (whSelect && nameDisplay) {
                nameDisplay.innerText = selectedOpt?.text || whSelect.value;
            }
            if (isWarehouse && whSelect && pickupInput) {
                pickupInput.value = whSelect.value;
            } else if (isDoorstep && pickupInput && doorstepDefault) {
                if (!pickupInput.value || pickupInput.value.startsWith('Fleetify')) {
                    pickupInput.value = doorstepDefault;
                }
            }
            debouncedUpdate();
        }

        function toggleDestinationDeliveryMode() {
            const isDoorstep = document.getElementById('destDoorstep')?.checked;
            const dropoffContainer = document.getElementById('dropoffAddrContainer');
            const destWarehouseInfo = document.getElementById('destWarehouseInfo');
            const dropoffInput = document.getElementById('dropoffAddr');
            const destSelect = document.getElementById('destWarehouseSelect');

            const selectedOpt = destSelect ? destSelect.options[destSelect.selectedIndex] : null;
            const doorstepDefault = selectedOpt ? (selectedOpt.getAttribute('data-doorstep-default') || '') : '';

            if (isDoorstep) {
                if (dropoffContainer) dropoffContainer.classList.remove('d-none');
                if (destWarehouseInfo) destWarehouseInfo.classList.add('d-none');
                if (dropoffInput) {
                    dropoffInput.required = true;
                    if (!dropoffInput.value || (destSelect && dropoffInput.value === destSelect.value) || dropoffInput.value.startsWith('Fleetify')) {
                        dropoffInput.value = doorstepDefault;
                    }
                }
            } else {
                if (dropoffContainer) dropoffContainer.classList.add('d-none');
                if (destWarehouseInfo) destWarehouseInfo.classList.remove('d-none');
                if (dropoffInput) {
                    dropoffInput.required = false;
                    if (destSelect) {
                        dropoffInput.value = destSelect.value;
                    }
                }
