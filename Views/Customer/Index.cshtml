@model Fleetify.Models.ViewModels.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Portal";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- User Header (Figure 23) -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Fleetify</h2>
            <p class="text-secondary small mb-0">Welcome, <strong class="text-dark">@Model.UserName</strong></p>
        </div>
    </div>

    @if (Model.Notifications != null && Model.Notifications.Any())
    {
        <div class="card border-0 shadow-xs rounded-4 bg-white p-3 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary rounded-circle p-2"><i class="bi bi-bell-fill text-white"></i></span>
                    <h6 class="fw-bold text-dark mb-0">Recent Notifications &amp; Updates</h6>
                </div>
                <span class="badge bg-light text-secondary border">@Model.Notifications.Count Total</span>
            </div>
            <div class="list-group list-group-flush small">
                @foreach (var notif in Model.Notifications.Take(3))
                {
                    <div class="list-group-item px-0 py-2 border-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                            <div>
                                <strong class="text-dark">@notif.Title</strong>
                                <span class="text-secondary d-block">@notif.Message</span>
                            </div>
                        </div>
                        <span class="text-muted x-small text-nowrap ms-3">@notif.SentAt.ToString("MMM dd, HH:mm")</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- 4 Top Metric Cards (Figure 23) -->
    <div class="row g-3 mb-4">
        <!-- Total Deliveries -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Total Deliveries</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalDeliveries</h3>
                    </div>
                    <div class="kpi-icon bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- In Transit -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">In Transit</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.InTransitCount</h3>
                    </div>
                    <div class="kpi-icon bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="bi bi-truck fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delivered -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Delivered</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.DeliveredCount</h3>
                    </div>
                    <div class="kpi-icon bg-success-subtle text-success rounded-circle p-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Spent -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Total Spent</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">Rs. @Model.TotalSpent.ToString("N0")</h3>
                    </div>
                    <div class="kpi-icon bg-purple-subtle text-purple rounded-circle p-3">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs (Figure 23: New Delivery | Track Deliveries) -->
    <ul class="nav nav-pills mb-4 gap-2" id="customerTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 py-2" id="new-delivery-tab" data-bs-toggle="tab" data-bs-target="#new-delivery-pane" type="button" role="tab">
                New Delivery
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 py-2" id="track-deliveries-tab" data-bs-toggle="tab" data-bs-target="#track-deliveries-pane" type="button" role="tab">
                Track Deliveries (@Model.MyDeliveries.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="customerTabsContent">
        <!-- TAB 1: NEW DELIVERY (Figure 23) -->
        <div class="tab-pane fade show active" id="new-delivery-pane" role="tabpanel" tabindex="0">
            <div class="row g-4">
                <!-- Request Form (Left Column) -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-xs rounded-4 p-4 p-md-5 bg-white">
                        <h5 class="fw-bold text-dark mb-4">Request New Delivery</h5>

                        <form asp-action="CreateDelivery" method="post" id="deliveryForm">
                            @Html.AntiForgeryToken()

                            <!-- 1. TOP ROW: TWO DROPDOWNS FOR ORIGIN WAREHOUSE AND DESTINATION WAREHOUSE -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-dark mb-1">
                                        <i class="bi bi-building text-primary me-1"></i>Origin Warehouse
                                    </label>
                                    <select id="originWarehouseSelect" name="NewDelivery.OriginWarehouse" class="form-select rounded-3 py-2 fw-semibold" onchange="onOriginWarehouseChanged()">
                                        <option value="Fleetify GT Road Hub, Shaheenabad, near Gulshan Park / GT Road, Gujranwala" data-city="Gujranwala" data-doorstep-default="Shaheenabad, near Gulshan Park / GT Road, Gujranwala" selected>Fleetify GT Road Hub – Gujranwala: Shaheenabad, near Gulshan Park / GT Road</option>
                                        <option value="Fleetify Central Hub, Thokar Niaz Baig, near Multan Road Bypass, Lahore" data-city="Lahore" data-doorstep-default="Thokar Niaz Baig, near Multan Road Bypass, Lahore">Fleetify Central Hub – Lahore: Thokar Niaz Baig, near Multan Road Bypass</option>
                                        <option value="Fleetify South Hub, S.I.T.E. Industrial Area, near Habib Bank Chowrangi, Karachi" data-city="Karachi" data-doorstep-default="S.I.T.E. Industrial Area, near Habib Bank Chowrangi, Karachi">Fleetify South Hub – Karachi: S.I.T.E. Industrial Area, near Habib Bank Chowrangi</option>
                                        <option value="Fleetify North Hub, I-9 Industrial Area, near Sector I-9/3, Islamabad" data-city="Islamabad" data-doorstep-default="I-9 Industrial Area, near Sector I-9/3, Islamabad">Fleetify North Hub – Islamabad: I-9 Industrial Area, near Sector I-9/3</option>
                                        <option value="Fleetify Twin Cities Hub, Murree Road, near Faizabad Interchange, Rawalpindi" data-city="Rawalpindi" data-doorstep-default="Murree Road, near Faizabad Interchange, Rawalpindi">Fleetify Twin Cities Hub – Rawalpindi: Murree Road, near Faizabad Interchange</option>
                                        <option value="Fleetify Textile Hub, Sargodha Road, near Millat Chowk, Faisalabad" data-city="Faisalabad" data-doorstep-default="Sargodha Road, near Millat Chowk, Faisalabad">Fleetify Textile Hub – Faisalabad: Sargodha Road, near Millat Chowk</option>
                                        <option value="Fleetify South Punjab Hub, Khanewal Road, near Industrial Estate, Multan" data-city="Multan" data-doorstep-default="Khanewal Road, near Industrial Estate, Multan">Fleetify South Punjab Hub – Multan: Khanewal Road, near Industrial Estate</option>
                                        <option value="Fleetify Khyber Hub, Hayatabad Industrial Estate, near Phase 7, Peshawar" data-city="Peshawar" data-doorstep-default="Hayatabad Industrial Estate, near Phase 7, Peshawar">Fleetify Khyber Hub – Peshawar: Hayatabad Industrial Estate, near Phase 7</option>
                                        <option value="Fleetify Export Hub, Wazirabad Road, near Sambrial, Sialkot" data-city="Sialkot" data-doorstep-default="Wazirabad Road, near Sambrial, Sialkot">Fleetify Export Hub – Sialkot: Wazirabad Road, near Sambrial</option>
                                        <option value="Fleetify Balochistan Hub, Zarghoon Road, near Quetta Cantt, Quetta" data-city="Quetta" data-doorstep-default="Zarghoon Road, near Quetta Cantt, Quetta">Fleetify Balochistan Hub – Quetta: Zarghoon Road, near Quetta Cantt</option>
                                    </select>
                                    <span class="text-muted d-block x-small mt-1"><i class="bi bi-geo-alt me-1"></i>Fleetify warehouse serving your pickup region.</span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-dark mb-1">
                                        <i class="bi bi-building text-danger me-1"></i>Destination Warehouse
                                    </label>
                                    <select id="destWarehouseSelect" name="NewDelivery.DestinationWarehouse" class="form-select rounded-3 py-2 fw-semibold" onchange="onDestWarehouseChanged()">
                                        <optgroup label="Fleetify Hub Warehouses">
                                            <option value="Fleetify Central Hub, Thokar Niaz Baig, near Multan Road Bypass, Lahore" data-city="Lahore" data-doorstep-default="Thokar Niaz Baig, near Multan Road Bypass, Lahore" selected>Fleetify Central Hub – Lahore: Thokar Niaz Baig, near Multan Road Bypass</option>
                                            <option value="Fleetify South Hub, S.I.T.E. Industrial Area, near Habib Bank Chowrangi, Karachi" data-city="Karachi" data-doorstep-default="S.I.T.E. Industrial Area, near Habib Bank Chowrangi, Karachi">Fleetify South Hub – Karachi: S.I.T.E. Industrial Area, near Habib Bank Chowrangi</option>
                                            <option value="Fleetify North Hub, I-9 Industrial Area, near Sector I-9/3, Islamabad" data-city="Islamabad" data-doorstep-default="I-9 Industrial Area, near Sector I-9/3, Islamabad">Fleetify North Hub – Islamabad: I-9 Industrial Area, near Sector I-9/3</option>
                                            <option value="Fleetify Twin Cities Hub, Murree Road, near Faizabad Interchange, Rawalpindi" data-city="Rawalpindi" data-doorstep-default="Murree Road, near Faizabad Interchange, Rawalpindi">Fleetify Twin Cities Hub – Rawalpindi: Murree Road, near Faizabad Interchange</option>
                                            <option value="Fleetify Textile Hub, Sargodha Road, near Millat Chowk, Faisalabad" data-city="Faisalabad" data-doorstep-default="Sargodha Road, near Millat Chowk, Faisalabad">Fleetify Textile Hub – Faisalabad: Sargodha Road, near Millat Chowk</option>
                                            <option value="Fleetify South Punjab Hub, Khanewal Road, near Industrial Estate, Multan" data-city="Multan" data-doorstep-default="Khanewal Road, near Industrial Estate, Multan">Fleetify South Punjab Hub – Multan: Khanewal Road, near Industrial Estate</option>
                                            <option value="Fleetify GT Road Hub, Shaheenabad, near Gulshan Park / GT Road, Gujranwala" data-city="Gujranwala" data-doorstep-default="Shaheenabad, near Gulshan Park / GT Road, Gujranwala">Fleetify GT Road Hub – Gujranwala: Shaheenabad, near Gulshan Park / GT Road</option>
                                            <option value="Fleetify Khyber Hub, Hayatabad Industrial Estate, near Phase 7, Peshawar" data-city="Peshawar" data-doorstep-default="Hayatabad Industrial Estate, near Phase 7, Peshawar">Fleetify Khyber Hub – Peshawar: Hayatabad Industrial Estate, near Phase 7</option>
                                            <option value="Fleetify Export Hub, Wazirabad Road, near Sambrial, Sialkot" data-city="Sialkot" data-doorstep-default="Wazirabad Road, near Sambrial, Sialkot">Fleetify Export Hub – Sialkot: Wazirabad Road, near Sambrial</option>
                                            <option value="Fleetify Balochistan Hub, Zarghoon Road, near Quetta Cantt, Quetta" data-city="Quetta" data-doorstep-default="Zarghoon Road, near Quetta Cantt, Quetta">Fleetify Balochistan Hub – Quetta: Zarghoon Road, near Quetta Cantt</option>
                                        </optgroup>
                                        <optgroup label="Special Delivery Areas (No Warehouse - 15% Surcharge)">
                                            <option value="GT Road, near Pakpattan Chowk, Sahiwal, Pakistan" data-city="Sahiwal" data-doorstep-default="GT Road, near Pakpattan Chowk, Sahiwal" data-no-warehouse="true">Sahiwal: GT Road, near Pakpattan Chowk (No Warehouse - Special Delivery +15%)</option>
                                            <option value="M.A. Jinnah Road, near General Bus Stand, Okara, Pakistan" data-city="Okara" data-doorstep-default="M.A. Jinnah Road, near General Bus Stand, Okara" data-no-warehouse="true">Okara: M.A. Jinnah Road, near General Bus Stand (No Warehouse - Special Delivery +15%)</option>
                                            <option value="Railway Road, near Steel Bagh, Kasur, Pakistan" data-city="Kasur" data-doorstep-default="Railway Road, near Steel Bagh, Kasur" data-no-warehouse="true">Kasur: Railway Road, near Steel Bagh (No Warehouse - Special Delivery +15%)</option>
                                            <option value="Military Road, near Sukkur Bypass, Sukkur, Pakistan" data-city="Sukkur" data-doorstep-default="Military Road, near Sukkur Bypass, Sukkur" data-no-warehouse="true">Sukkur: Military Road, near Sukkur Bypass (No Warehouse - Special Delivery +15%)</option>
                                        </optgroup>
                                    </select>
                                    <span class="text-muted d-block x-small mt-1"><i class="bi bi-flag me-1"></i>Destination warehouse hub or delivery region.</span>
                                </div>
                            </div>

                            <!-- Pickup Cities Datalist -->
                            <datalist id="pakistanCitiesList">
                                <option value="Shaheenabad, near Gulshan Park / GT Road, Gujranwala" label="Gujranwala Hub: Shaheenabad, near Gulshan Park" />
                                <option value="Thokar Niaz Baig, near Multan Road Bypass, Lahore" label="Lahore Central Hub: Thokar Niaz Baig" />
                                <option value="S.I.T.E. Industrial Area, near Habib Bank Chowrangi, Karachi" label="Karachi South Hub: S.I.T.E. Industrial Area" />
                                <option value="I-9 Industrial Area, near Sector I-9/3, Islamabad" label="Islamabad North Hub: I-9 Industrial Area" />
                                <option value="Murree Road, near Faizabad Interchange, Rawalpindi" label="Rawalpindi Hub: Murree Road / Faizabad" />
                                <option value="Sargodha Road, near Millat Chowk, Faisalabad" label="Faisalabad Hub: Sargodha Road / Millat Chowk" />
                                <option value="Khanewal Road, near Industrial Estate, Multan" label="Multan Hub: Khanewal Road" />
                                <option value="Hayatabad Industrial Estate, near Phase 7, Peshawar" label="Peshawar Hub: Hayatabad Industrial Estate" />
                                <option value="Wazirabad Road, near Sambrial, Sialkot" label="Sialkot Hub: Wazirabad Road / Sambrial" />
                                <option value="Zarghoon Road, near Quetta Cantt, Quetta" label="Quetta Hub: Zarghoon Road" />
                            </datalist>

                            <!-- Dropoff Cities Datalist: Warehouse Hubs & Special Delivery Cities (Sahiwal, Okara, Kasur, Sukkur) -->
                            <datalist id="dropoffCitiesList">
                                <option value="Thokar Niaz Baig, near Multan Road Bypass, Lahore" label="Lahore Central Hub: Thokar Niaz Baig" />
                                <option value="Shaheenabad, near Gulshan Park / GT Road, Gujranwala" label="Gujranwala Hub: Shaheenabad" />
                                <option value="S.I.T.E. Industrial Area, near Habib Bank Chowrangi, Karachi" label="Karachi South Hub: S.I.T.E." />
                                <option value="I-9 Industrial Area, near Sector I-9/3, Islamabad" label="Islamabad North Hub: I-9" />
                                <option value="Murree Road, near Faizabad Interchange, Rawalpindi" label="Rawalpindi Hub: Faizabad" />
                                <option value="Sargodha Road, near Millat Chowk, Faisalabad" label="Faisalabad Hub: Millat Chowk" />
                                <option value="Khanewal Road, near Industrial Estate, Multan" label="Multan Hub: Khanewal Road" />
                                <option value="Hayatabad Industrial Estate, near Phase 7, Peshawar" label="Peshawar Hub: Hayatabad Phase 7" />
                                <option value="Wazirabad Road, near Sambrial, Sialkot" label="Sialkot Hub: Sambrial" />
                                <option value="Zarghoon Road, near Quetta Cantt, Quetta" label="Quetta Hub: Zarghoon Road" />
                                <option value="GT Road, near Pakpattan Chowk, Sahiwal" label="Sahiwal: GT Road, near Pakpattan Chowk (+15%)" />
                                <option value="M.A. Jinnah Road, near General Bus Stand, Okara" label="Okara: M.A. Jinnah Road, near General Bus Stand (+15%)" />
                                <option value="Railway Road, near Steel Bagh, Kasur" label="Kasur: Railway Road, near Steel Bagh (+15%)" />
                                <option value="Military Road, near Sukkur Bypass, Sukkur" label="Sukkur: Military Road, near Sukkur Bypass (+15%)" />
                            </datalist>

                            <!-- Package Information -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">
                                        Package Type <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="NewDelivery.ParcelDescription" id="parcelDescription" class="form-select rounded-3 py-2 fw-semibold">
                                        <option value="Electronics" selected>Electronics</option>
                                        <option value="Iron or Steel">Iron or Steel</option>
                                        <option value="Hardware Parts">Hardware Parts</option>
                                    </select>
                                    <span class="text-muted d-block x-small mt-1">Select the general category</span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">
                                        Package Name <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="NewDelivery.PackageName" id="packageName" type="text" class="form-control rounded-3 py-2" placeholder="e.g. Sony 55-inch 4K TV" required />
                                    <span class="text-muted d-block x-small mt-1">Exact name or model of the product</span>
                                </div>
                            </div>

                            <!-- Weight & Quantity Card with Live Total Weight Calculation -->
                            <div class="card border border-primary-subtle bg-light-blue rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-bold text-dark d-flex align-items-center gap-1">
                                        <i class="bi bi-speedometer2 text-primary"></i> Weight &amp; Quantity
                                    </span>
                                    <span class="badge bg-primary text-white rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                        <i class="bi bi-calculator me-1"></i>Auto-Calculated Total Weight
                                    </span>
                                </div>
                                <div class="text-primary small mb-2" style="font-size: 0.75rem;">
                                    <i class="bi bi-info-circle-fill me-1"></i>Enter single item weight; total parcel weight is calculated automatically for your rate.
                                </div>

                                <div class="row g-2 mb-2">
                                    <div class="col-md-6">
                                        <label class="form-label x-small fw-semibold text-secondary mb-1">Single Item Weight (kg) <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="NewDelivery.SingleItemWeight" id="singleItemWeight" type="number" step="0.1" min="0.1" class="form-control font-mono fw-semibold" value="2.0" placeholder="2.0" required />
                                            <span class="input-group-text bg-white text-muted">kg</span>
                                        </div>
                                        <span class="text-muted d-block x-small mt-1">Weight of 1 item / piece</span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label x-small fw-semibold text-secondary mb-1">Quantity (Total Items) <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="NewDelivery.Quantity" id="packageQuantity" type="number" min="1" step="1" class="form-control font-mono fw-bold" value="1" placeholder="1" required />
                                            <span class="input-group-text bg-white text-muted">items</span>
                                        </div>
                                        <span class="text-muted d-block x-small mt-1">Number of items to dispatch</span>
                                    </div>
                                </div>

                                <!-- Weight Calculation Live Feedback -->
                                <div class="p-2 rounded-2 bg-white border border-primary-subtle mt-2 shadow-xs">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-secondary small" style="font-size: 0.75rem;">
                                            <i class="bi bi-box-seam me-1 text-primary"></i>Single Item Weight:
                                        </span>
                                        <span class="font-mono text-dark fw-bold small" id="calcSingleWeight">2.00 kg</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-secondary small fw-semibold" style="font-size: 0.75rem;">
                                            Total Parcel Weight (<span id="calcWeightQtyMultiplier">1 item</span>):
                                        </span>
                                        <span class="badge bg-success text-white font-mono px-2 py-1" style="font-size: 0.85rem;" id="calcTotalWeight">2.00 kg</span>
                                    </div>
                                    <div class="text-muted text-end mt-1" style="font-size: 0.65rem;">
                                        Formula: <span class="font-mono" id="calcWeightFormula">2.00 kg × 1 item = 2.00 kg</span>
                                    </div>
                                </div>
                                <input type="hidden" asp-for="NewDelivery.ParcelWeight" id="packageWeight" value="2.0" />
                            </div>

                            <!-- Dimensions (Mandatory in Feet) & Volume Calculation Card -->
                            <div class="card border border-primary-subtle bg-light-blue rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-bold text-dark d-flex align-items-center gap-1">
                                        <i class="bi bi-box-seam text-primary"></i> Dimensions (Single Product)
                                    </span>
                                    <span class="badge bg-primary text-white rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                        <i class="bi bi-rulers me-1"></i>Mandatory in Feet (ft)
                                    </span>
                                </div>
                                <div class="text-primary small mb-2" style="font-size: 0.75rem;">
                                    <i class="bi bi-info-circle-fill me-1"></i>Please enter all single-product dimensions strictly in <strong>Feet (ft)</strong>.
                                </div>

                                <div class="row g-2 mb-2">
                                    <div class="col-md-4">
                                        <label class="form-label x-small fw-semibold text-secondary mb-1">Length (ft) <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="NewDelivery.Length" id="packageLength" type="number" step="0.1" min="0.1" class="form-control font-mono fw-semibold" value="2.0" placeholder="2.0" required />
                                            <span class="input-group-text bg-white text-muted">ft</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label x-small fw-semibold text-secondary mb-1">Width (ft) <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="NewDelivery.Width" id="packageWidth" type="number" step="0.1" min="0.1" class="form-control font-mono fw-semibold" value="1.5" placeholder="1.5" required />
                                            <span class="input-group-text bg-white text-muted">ft</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label x-small fw-semibold text-secondary mb-1">Height (ft) <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="NewDelivery.Height" id="packageHeight" type="number" step="0.1" min="0.1" class="form-control font-mono fw-semibold" value="1.0" placeholder="1.0" required />
                                            <span class="input-group-text bg-white text-muted">ft</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Volume Calculation Live Feedback -->
                                <div class="p-2 rounded-2 bg-white border border-primary-subtle mt-2 shadow-xs">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-secondary small" style="font-size: 0.75rem;">
                                            <i class="bi bi-calculator me-1 text-primary"></i>Single Product Volume:
                                        </span>
                                        <span class="font-mono text-dark fw-bold small" id="calcSingleCft">3.00 CFT</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-secondary small fw-semibold" style="font-size: 0.75rem;">
                                            Total Cubic Feet (<span id="calcQtyMultiplier">1 unit</span>):
                                        </span>
                                        <span class="badge bg-primary text-white font-mono px-2 py-1" style="font-size: 0.85rem;" id="calcTotalCft">3.00 CFT</span>
                                    </div>
                                    <div class="text-muted text-end mt-1" style="font-size: 0.65rem;">
                                        Formula: <span class="font-mono" id="calcFormula">2.0 × 1.5 × 1.0 ft × 1</span>
                                    </div>
                                </div>
                                <input type="hidden" asp-for="NewDelivery.TotalCubicFeet" id="totalCubicFeet" value="3.0" />
                            </div>

                            <!-- Delivery Type Selection -->
                            <div class="mb-3" id="deliveryTypeContainer">
                                <label class="form-label small fw-semibold text-secondary">Delivery Type</label>
                                <select asp-for="NewDelivery.RouteType" id="deliveryType" class="form-select rounded-3 py-2 fw-semibold text-dark">
                                    <option value="Normal" selected>Normal Delivery</option>
                                    <option value="Fast">Fast Delivery</option>
                                    <option value="Express">Express Delivery</option>
                                </select>
                            </div>

                            <!-- REPOSITIONED: Pickup Mode & Delivery Mode (At the very end of the form, directly below Delivery Type) -->
                            <div class="row g-3 mb-4" id="serviceModesContainer">
                                <!-- Left Column: Pickup Selection Blocks & Dynamic Pickup Address -->
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-secondary mb-1 d-block">Pickup Mode</label>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <label class="selectable-option-card d-block p-2.5 rounded-3 border h-100 position-relative cursor-pointer" for="originDoorstep" id="cardOriginDoorstep">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input class="form-check-input mt-0 flex-shrink-0" type="radio" asp-for="NewDelivery.OriginType" id="originDoorstep" value="DoorstepPickup" checked onchange="toggleOriginPickupMode()">
                                                    <div class="lh-sm">
                                                        <span class="fw-bold text-dark d-block small"><i class="bi bi-house-door-fill text-primary me-1"></i>Doorstep Pickup</span>
                                                        <span class="text-muted x-small d-block mt-0.5">Rider picks up from you</span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                        <div class="col-6">
                                            <label class="selectable-option-card d-block p-2.5 rounded-3 border h-100 position-relative cursor-pointer" for="originWarehouse" id="cardOriginWarehouse">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input class="form-check-input mt-0 flex-shrink-0" type="radio" asp-for="NewDelivery.OriginType" id="originWarehouse" value="WarehouseDropoff" onchange="toggleOriginPickupMode()">
                                                    <div class="lh-sm">
                                                        <span class="fw-bold text-dark d-block small"><i class="bi bi-building text-info me-1"></i>Warehouse Dropoff</span>
                                                        <span class="text-muted x-small d-block mt-0.5">You drop off at hub</span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Specific Pickup Address Field (Appears ONLY when Doorstep Pickup is selected) -->
                                    <div id="pickupAddrContainer">
                                        <label class="form-label small fw-semibold text-secondary">Specific Pickup Address (Street / Landmark)</label>
                                        <input asp-for="NewDelivery.PickupLocation" id="pickupAddr" class="form-control rounded-3 py-2" placeholder="e.g. Shaheenabad, near Gulshan Park / GT Road, Gujranwala" value="Shaheenabad, near Gulshan Park / GT Road, Gujranwala" autocomplete="off" list="pakistanCitiesList" required />
                                        <span class="text-muted d-block x-small mt-1"><i class="bi bi-geo-alt me-1"></i>Courier will arrive at this exact address for pickup.</span>

                                        <!-- Conditional Pickup Date (Appears ONLY when Doorstep Pickup is selected) -->
                                        <div id="pickupDateContainer" class="mt-2">
                                            <label class="form-label small fw-semibold text-secondary mb-1">Pickup Date</label>
                                            <input asp-for="NewDelivery.PickupDate" id="pickupDate" type="date" class="form-control rounded-3 py-2" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                                            <span class="text-muted d-block x-small mt-1"><i class="bi bi-calendar-event me-1"></i>Date rider will arrive at your address.</span>
                                        </div>
                                    </div>

                                    <!-- Warehouse Drop-off Hub Confirmation Info (Appears when Warehouse Dropoff is selected) -->
                                    <div id="originWarehouseInfo" class="alert alert-light border rounded-3 p-2.5 d-none mb-0">
                                        <div class="d-flex align-items-center gap-2 text-primary small">
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            <div>
                                                <strong class="d-block text-dark x-small">Drop-off Hub Confirmed:</strong>
                                                <span id="originWarehouseNameDisplay" class="x-small text-secondary">Fleetify GT Road Hub – Gujranwala: Shaheenabad, near Gulshan Park / GT Road</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column: Drop-off Selection Blocks & Dynamic Drop-off Address -->
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-secondary mb-1 d-block">Delivery Mode</label>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <label class="selectable-option-card d-block p-2.5 rounded-3 border h-100 position-relative cursor-pointer" for="destDoorstep" id="cardDestDoorstep">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input class="form-check-input mt-0 flex-shrink-0" type="radio" asp-for="NewDelivery.DestinationType" id="destDoorstep" value="DoorstepDelivery" checked onchange="toggleDestinationDeliveryMode()">
                                                    <div class="lh-sm">
                                                        <span class="fw-bold text-dark d-block small"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Doorstep Delivery</span>
                                                        <span class="text-muted x-small d-block mt-0.5">Deliver to recipient</span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                        <div class="col-6">
                                            <label class="selectable-option-card d-block p-2.5 rounded-3 border h-100 position-relative cursor-pointer" for="destWarehouse" id="cardDestWarehouse">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input class="form-check-input mt-0 flex-shrink-0" type="radio" asp-for="NewDelivery.DestinationType" id="destWarehouse" value="WarehousePickup" onchange="toggleDestinationDeliveryMode()">
                                                    <div class="lh-sm">
                                                        <span class="fw-bold text-dark d-block small"><i class="bi bi-box-arrow-in-down-right text-info me-1"></i>Warehouse Self Pickup</span>
                                                        <span class="text-muted x-small d-block mt-0.5">Pick up from hub</span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Specific Drop-off Address Field (Appears ONLY when Doorstep Delivery is selected) -->
                                    <div id="dropoffAddrContainer">
                                        <label class="form-label small fw-semibold text-secondary">Specific Drop-off Address (Street / Landmark)</label>
                                        <input asp-for="NewDelivery.DropoffLocation" id="dropoffAddr" class="form-control rounded-3 py-2" placeholder="e.g. Thokar Niaz Baig, near Multan Road Bypass, Lahore" value="Thokar Niaz Baig, near Multan Road Bypass, Lahore" autocomplete="off" list="dropoffCitiesList" required />
                                        <span class="text-muted d-block x-small mt-1"><i class="bi bi-flag me-1"></i>Courier will deliver parcel directly to this doorstep location.</span>
                                    </div>

                                    <!-- Warehouse Self-Pickup Hub Confirmation Info (Appears when Warehouse Self-Pickup is selected) -->
                                    <div id="destWarehouseInfo" class="alert alert-light border rounded-3 p-2.5 d-none mb-0">
                                        <div class="d-flex align-items-center gap-2 text-primary small">
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            <div>
                                                <strong class="d-block text-dark x-small">Self-Pickup Hub Confirmed:</strong>
                                                <span id="destWarehouseNameDisplay" class="x-small text-secondary">Fleetify Central Hub – Lahore: Thokar Niaz Baig, near Multan Road Bypass</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Warning Notice (Triggered ONLY conditionally when selecting city without warehouse while choosing warehouse operations) -->
                                    <div id="specialDeliveryNotice" class="alert alert-warning border border-warning-subtle rounded-3 small p-2 mt-2 d-none">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0 mt-0.5"></i>
                                            <div class="x-small">
                                                <strong>Notice:</strong> Fleetify does not operate a warehouse in <span id="specialCityName" class="fw-bold">this city</span>. Warehouse self-pickup is not available here; please choose <strong>Doorstep Delivery</strong> (special delivery with an additional <strong>15% charge</strong>).
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" asp-for="NewDelivery.VehicleType" id="vehicleType" value="Truck" />
                            <input type="hidden" id="distanceKm" name="NewDelivery.EstimatedDistanceKm" value="15" />

                            <div class="d-grid">
                                <button type="button" class="btn btn-primary rounded-pill py-2 fw-semibold text-white shadow-sm" onclick="showDeliveryNoticeModal()">
                                    <i class="bi bi-send me-1"></i> Submit Delivery Request
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Cost Estimate Card (Right Column - Figure 23) -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-xs rounded-4 p-4 bg-white sticky-top" style="top: 20px;">
                        <h6 class="fw-bold text-dark mb-3">Cost Estimate</h6>

                        <!-- Driving Distance (Hub-to-Hub Route) -->
                        <div class="d-flex justify-content-between mb-2 small pb-1.5 border-bottom">
                            <span class="fw-semibold text-dark"><i class="bi bi-speedometer me-1 text-primary"></i>Driving Distance (Hub-to-Hub)</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-mono fw-bold" id="estDistanceKm">15 km</span>
                        </div>
                        <span id="estTotalDrivingDistance" class="d-none">15 km</span>
                        <div id="estPickupLegRow" class="d-none"><span id="estPickupLegDistance">0 km</span></div>
                        <div id="estDeliveryLegRow" class="d-none"><span id="estDeliveryLegDistance">0 km</span></div>

                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Single Item Weight</span>
                            <span class="fw-semibold text-dark font-mono" id="estSingleWeight">2.0 kg</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Quantity</span>
                            <span class="fw-semibold text-dark font-mono" id="estQuantity">1 unit</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Total Cargo Weight (B2)</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle font-mono" id="estWeight">2.0 kg</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Product</span>
                            <span class="fw-semibold text-dark text-truncate ms-2" style="max-width: 140px;" id="estPackageName">Product</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Package Type</span>
                            <span class="fw-semibold text-dark" id="estPackageType">Electronics</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Dimensions (ft)</span>
                            <span class="fw-semibold text-secondary font-mono" id="estDimensions">2.0 × 1.5 × 1.0 ft</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Total Volume (D2)</span>
                            <span class="badge bg-primary text-white font-mono" id="estVolume">3.00 CFT</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Volume Multiplier</span>
                            <span class="fw-semibold text-dark font-mono" id="estVolumeMultiplier">1.00× (&lt;1000 CFT)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-secondary">Delivery Speed (C2)</span>
                            <span class="fw-semibold text-primary" id="estDeliveryType">Normal (1.0×)</span>
                        </div>

                        <div id="estSpecialSurchargeRow" class="d-flex justify-content-between mb-2 small text-warning-emphasis d-none">
                            <span><i class="bi bi-truck me-1"></i>Special Delivery (+15%)</span>
                            <span class="fw-semibold font-mono" id="estSpecialSurchargeAmount">+Rs. 0</span>
                        </div>

                        <div id="estHubInfoRow" class="d-flex justify-content-between mb-2 small text-secondary">
                            <span>Hub Network</span>
                            <span class="fw-semibold text-dark" id="estHubStatus">Connected Hubs</span>
                        </div>

                        <!-- Doorstep Surcharge & Tiered Pricing Formula Section (Requirement 3) -->
                        <div id="estDoorstepSurchargesBox" class="p-2.5 rounded-3 bg-light border border-primary-subtle my-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="x-small fw-bold text-dark d-flex align-items-center gap-1">
                                    <i class="bi bi-fuel-pump text-primary"></i> Doorstep Extra Charges
                                </span>
                                <span class="badge bg-primary text-white font-mono" style="font-size: 0.7rem;" id="estDoorstepLegCount">2 Legs</span>
                            </div>
                            <div class="d-flex justify-content-between x-small text-secondary mb-1">
                                <span>Tier Fuel Surcharge (<span id="estDoorstepTierCft">&le;300 CFT</span>):</span>
                                <span class="font-mono text-dark fw-semibold" id="estDoorstepFuelRate">Rs. 1,000 / leg</span>
                            </div>
                            <div class="d-flex justify-content-between x-small text-secondary mb-1">
                                <span>Weight Surcharge (<span id="estDoorstepWeightTierLabel">Rs. 1/kg (&lt;1t)</span>):</span>
                                <span class="font-mono text-dark fw-semibold" id="estDoorstepWeightRate">Rs. 2.00 / leg</span>
                            </div>
                            <div class="d-flex justify-content-between x-small text-secondary mb-1" id="estPickupSurchargeDetailRow">
                                <span><i class="bi bi-house-door text-primary me-1"></i>Doorstep Pickup:</span>
                                <span class="font-mono text-primary fw-semibold" id="estPickupSurchargeDetail">+Rs. 1,000</span>
                            </div>
                            <div class="d-flex justify-content-between x-small text-secondary mb-1" id="estDeliverySurchargeDetailRow">
                                <span><i class="bi bi-geo-alt text-danger me-1"></i>Doorstep Delivery:</span>
                                <span class="font-mono text-danger fw-semibold" id="estDeliverySurchargeDetail">+Rs. 1,000</span>
                            </div>
                            <div class="d-flex justify-content-between small fw-bold text-dark border-top pt-1 mt-1">
                                <span>Total Doorstep Surcharges:</span>
                                <span class="font-mono text-primary" id="estTotalDoorstepSurcharge">+Rs. 2,000</span>
                            </div>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold text-dark">Estimated Total</span>
                            <h4 class="fw-bold text-primary mb-0" id="estTotal">Rs. 545</h4>
                        </div>

                        <div class="p-3 bg-light-blue rounded-3 text-primary small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-clock-history fs-5"></i>
                            <div>
                                <span class="d-block text-secondary x-small">Estimated Delivery</span>
                                <strong id="estDeliveryDays">4 to 6 days</strong>
                            </div>
                        </div>

                        <!-- Interactive Live Route Map -->
                        <div class="mt-1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-secondary small fw-semibold">
                                    <i class="bi bi-geo-alt-fill text-primary me-1"></i>Live Route Visualizer
                                </span>
                                <span id="estMapProvider" class="badge bg-light text-primary border" style="font-size: 0.68rem;">
                                    <i class="bi bi-broadcast text-success me-1"></i>Live GPS Active
                                </span>
                            </div>
                            <div id="routeMap" class="rounded-3 border shadow-sm position-relative overflow-hidden" style="height: 250px; width: 100%; background: #f1f5f9; z-index: 1;"></div>
                            <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-muted" style="font-size: 0.72rem;">
                                <span id="mapOriginDisplay" class="text-truncate" style="max-width: 45%;"><i class="bi bi-geo-alt-fill text-success me-1"></i>Pickup</span>
                                <span id="mapRouteStatus" class="fw-semibold text-primary px-1"><i class="bi bi-arrow-right"></i></span>
                                <span id="mapDestDisplay" class="text-truncate text-end" style="max-width: 45%;"><i class="bi bi-flag-fill text-danger me-1"></i>Destination</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: TRACK DELIVERIES (History & Tracking) -->
        <div class="tab-pane fade" id="track-deliveries-pane" role="tabpanel" tabindex="0">
            <div class="card border-0 shadow-xs rounded-4 bg-white p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">My Delivery Bookings</h5>
                        <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i>Time-Limited: You can only Edit or Cancel delivery requests within <strong>1 hour</strong> of booking.</p>
                    </div>
                    <form asp-action="Track" method="get" class="d-flex gap-2" style="max-width: 320px;">
                        <input name="trackingNumber" class="form-control form-control-sm rounded-pill" placeholder="Enter Tracking # (e.g. FLT-...)" required />
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 text-white">Track</button>
                    </form>
                </div>

                @{
                    var arrivedShipments = Model.MyDeliveries.Where(d => d.RequestedStatus == "Arrived at Destination Warehouse").ToList();
                }
                @if (arrivedShipments.Any())
                {
                    <div class="mb-4">
                        @foreach (var arr in arrivedShipments)
                        {
                            <div class="card border-primary shadow-sm rounded-4 p-4 bg-primary-subtle bg-opacity-25 mb-3">
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-primary text-white rounded-pill px-3 py-1 font-mono">
                                                <i class="bi bi-building me-1"></i> ARRIVED AT DESTINATION WAREHOUSE
                                            </span>
                                            <span class="badge bg-light text-dark border font-mono">@arr.TrackingNumber</span>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1">
                                            Your parcel has arrived at our destination warehouse!
                                        </h5>
                                        <p class="text-secondary small mb-2">
                                            Destination Hub: <strong class="text-dark">@(arr.DestinationWarehouseName ?? "Fleetify Destination Warehouse Hub")</strong>
                                            @if (!string.IsNullOrEmpty(arr.DestinationWarehouseAddress))
                                            {
                                                <span>(@arr.DestinationWarehouseAddress)</span>
                                            }
                                        </p>
                                        <div class="small">
                                            <span class="text-secondary">Current Preference:</span>
                                            <span class="badge @(arr.DestinationType == "WarehousePickup" ? "bg-info text-white" : "bg-success text-white") rounded-pill">
                                                @(arr.DestinationType == "WarehousePickup" ? "Self-Pickup from Warehouse" : "Doorstep Delivery to Address")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <form asp-action="SetDestinationDeliveryPreference" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@arr.RequestID" />
                                            <input type="hidden" name="preference" value="WarehousePickup" />
                                            <button type="submit" class="btn @(arr.DestinationType == "WarehousePickup" ? "btn-info text-white" : "btn-outline-info") rounded-pill px-3 py-2 btn-sm fw-semibold">
                                                <i class="bi bi-box-arrow-in-down-right me-1"></i> I Will Pick Up at Warehouse
                                            </button>
                                        </form>
                                        <form asp-action="SetDestinationDeliveryPreference" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@arr.RequestID" />
                                            <input type="hidden" name="preference" value="DoorstepDelivery" />
                                            <button type="submit" class="btn @(arr.DestinationType == "DoorstepDelivery" ? "btn-success text-white" : "btn-outline-success") rounded-pill px-3 py-2 btn-sm fw-semibold">
                                                <i class="bi bi-truck me-1"></i> Deliver to My Address
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (Model.MyDeliveries.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th>Tracking #</th>
                                    <th>Date</th>
                                    <th>Pickup &rarr; Dropoff</th>
                                    <th>Services</th>
                                    <th>Weight</th>
                                    <th>Speed</th>
                                    <th>Vehicle</th>
                                    <th>Cost</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.MyDeliveries)
                                {
                                    <tr>
                                        <td class="fw-bold font-mono text-primary">@d.TrackingNumber</td>
                                        <td>@d.RequestDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 200px;">
                                                <i class="bi bi-circle-fill text-muted me-1 small"></i>@d.PickupLocation
                                                <br />
                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@d.DropoffLocation
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                <span class="badge @(d.OriginType == "WarehouseDropoff" ? "bg-light text-primary border" : "bg-light text-secondary border")" style="font-size: 0.7rem;">
                                                    <i class="bi @(d.OriginType == "WarehouseDropoff" ? "bi-building" : "bi-house-door") me-1"></i>@(d.OriginType == "WarehouseDropoff" ? "Wh. Dropoff" : "Doorstep Pick")
                                                </span>
                                                <span class="badge @(d.DestinationType == "WarehousePickup" ? "bg-info-subtle text-info border border-info-subtle" : "bg-light text-secondary border")" style="font-size: 0.7rem;">
                                                    <i class="bi @(d.DestinationType == "WarehousePickup" ? "bi-box-arrow-in-down-right" : "bi-truck") me-1"></i>@(d.DestinationType == "WarehousePickup" ? "Wh. Pickup" : "Doorstep Del")
                                                </span>
                                                @if (d.IsPrivateTransport)
                                                {
                                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle" style="font-size: 0.65rem;">
                                                        <i class="bi bi-shield-lock me-1"></i>Dedicated Private
                                                    </span>
                                                }
                                            </div>
                                        <td>
                                            @{
                                                var dQty = d.Quantity > 0 ? d.Quantity : 1;
                                                var dSingleWeight = d.SingleItemWeight > 0 ? d.SingleItemWeight : (dQty > 0 ? Math.Round(d.ParcelWeight / dQty, 2) : d.ParcelWeight);
                                                var dTotalWeight = d.ParcelWeight > 0 ? d.ParcelWeight : Math.Round(dSingleWeight * dQty, 2);
                                                var totalCft = d.TotalCubicFeet > 0 ? d.TotalCubicFeet : Math.Round((d.Length > 0 ? d.Length : 2) * (d.Width > 0 ? d.Width : 1.5) * (d.Height > 0 ? d.Height : 1) * dQty, 2);
                                            }
                                            <div class="fw-bold text-dark font-mono">
                                                Total: @dTotalWeight.ToString("0.##") kg
                                            </div>
                                            <div class="text-muted font-mono" style="font-size: 0.70rem;">
                                                (@dQty × @dSingleWeight.ToString("0.##") kg/unit)
                                            </div>
                                            <div class="fw-semibold text-dark text-truncate mt-1" style="font-size: 0.75rem; max-width: 140px;" title="@(!string.IsNullOrWhiteSpace(d.PackageName) ? d.PackageName : d.ParcelDescription)">
                                                @(!string.IsNullOrWhiteSpace(d.PackageName) ? d.PackageName : (!string.IsNullOrWhiteSpace(d.ParcelDescription) ? d.ParcelDescription : "Product"))
                                            </div>
                                            <div class="badge bg-light text-secondary border font-mono" style="font-size: 0.65rem;">
                                                @(string.IsNullOrWhiteSpace(d.ParcelDescription) ? "Electronics" : d.ParcelDescription)
                                            </div>
                                            <div class="text-secondary font-mono" style="font-size: 0.65rem;">
                                                @(d.Length > 0 ? d.Length : 2)×@(d.Width > 0 ? d.Width : 1.5)×@(d.Height > 0 ? d.Height : 1) ft
                                            </div>
                                            <div class="text-primary font-mono fw-semibold" style="font-size: 0.65rem;">
                                                @dQty qty • @totalCft.ToString("0.##") CFT
                                            </div>
                                        </td>
                                        <td>
                                            @{
                                                var speed = string.IsNullOrWhiteSpace(d.RouteType) ? "Normal" : d.RouteType;
                                                var speedBadge = speed == "Express" ? "bg-danger-subtle text-danger" : speed == "Fast" ? "bg-warning-subtle text-warning-emphasis" : "bg-light text-dark";
                                            }
                                            <span class="badge @speedBadge border">@speed</span>
                                        </td>
                                        <td>
                                            @{
                                                var vIcon = (d.VehicleType ?? "Truck") switch {
                                                    "Bike" => "bi-bicycle",
                                                    "Pickup" => "bi-truck",
                                                    "Van" => "bi-box-seam",
                                                    _ => "bi-truck"
                                                };
                                            }
                                            <span class="badge bg-primary-subtle text-primary border"><i class="bi @vIcon me-1"></i>@d.VehicleType</span>
                                        </td>
                                        <td class="fw-bold text-dark">Rs. @Math.Floor(d.EstimatedCost).ToString("F0")</td>
                                        <td>
                                            @if (d.RequestedStatus == "Delivered")
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Delivered</span>
                                            }
                                            else if (d.RequestedStatus == "ArrivedAtWarehouse" || d.RequestedStatus == "Arrived at Destination Warehouse")
                                            {
                                                <span class="badge bg-primary text-white rounded-pill px-3 py-1"><i class="bi bi-building me-1"></i>At Destination Hub</span>
                                            }
                                            else if (d.WeightStatus == "Finalized" || d.RequestedStatus == "Cost Finalized")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Cost Finalized</span>
                                            }
                                            else if (d.WeightStatus == "VerifiedMatched" || d.RequestedStatus == "Weight Verified")
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1"><i class="bi bi-shield-check me-1"></i>Weight Verified</span>
                                            }
                                            else if (d.WeightStatus == "DiscrepancyReported" || d.RequestedStatus == "Weight Reported")
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1"><i class="bi bi-exclamation-triangle me-1"></i>Weight Reported</span>
                                            }
                                            else if (d.RequestedStatus == "In-Transit")
                                            {
                                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">In-Transit</span>
                                            }
                                            else if (d.RequestedStatus == "Assigned")
                                            {
                                                <span class="badge bg-info-subtle text-info rounded-pill px-3 py-1">Driver Assigned</span>
                                            }
                                            else if (d.RequestedStatus == "Cancelled")
                                            {
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">Pending Verification</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end align-items-center gap-1">
                                                <a asp-action="Track" asp-route-trackingNumber="@d.TrackingNumber" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-1" title="Track Live">
                                                    <i class="bi bi-geo-alt"></i>
                                                </a>
                                                @{
                                                    var elapsedMins = (DateTime.UtcNow - d.RequestDate).TotalMinutes;
                                                    var isEditable = elapsedMins <= 60.0 && d.RequestedStatus == "Pending";
                                                    var minsLeft = Math.Max(0, (int)(60.0 - elapsedMins));
                                                }
                                                @if (isEditable)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-1" title="Edit Request (~@minsLeft mins left)"
                                                            onclick="openEditModal(@d.RequestID, '@d.TrackingNumber', '@Html.Raw(d.PickupLocation.Replace("'", "\\'"))', '@Html.Raw(d.DropoffLocation.Replace("'", "\\'"))', @dSingleWeight, '@Html.Raw((d.RouteType ?? "Normal").Replace("'", "\\'"))', '@Html.Raw((d.ParcelDescription ?? "Electronics").Replace("'", "\\'"))', '@Html.Raw((d.VehicleType ?? "Truck").Replace("'", "\\'"))', @(d.Length > 0 ? d.Length : 2.0), @(d.Width > 0 ? d.Width : 1.5), @(d.Height > 0 ? d.Height : 1.0), '@Html.Raw((d.PackageName ?? "").Replace("'", "\\'"))', @dQty, @dTotalWeight)">
                                                        <i class="bi bi-pencil-square text-dark"></i>
                                                    </button>
                                                    <form asp-action="CancelDelivery" method="post" class="d-inline" onsubmit="return confirm('Aap yeh delivery request cancel karna chahte hain? (Tracking: @d.TrackingNumber)');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@d.RequestID" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1" title="Cancel (~@minsLeft mins left)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border rounded-pill small ms-1" style="font-size: 0.65rem;" title="1-hour window">
                                                        <i class="bi bi-hourglass-split"></i> @(minsLeft)m
                                                    </span>
                                                }
                                                else if (d.RequestedStatus != "Cancelled")
                                                {
                                                    <span class="badge bg-light text-muted border rounded-pill small ms-1" style="font-size: 0.65rem;" title="1-hour window closed; locked for shipping">
                                                        <i class="bi bi-lock-fill"></i> Locked
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-box2 fs-1 mb-2"></i>
                        <h5>No deliveries requested yet.</h5>
                        <p class="small">Switch to the "New Delivery" tab above to book your first delivery.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- POP-UP 1: SUBMIT DELIVERY 1-HOUR LOCK NOTICE MODAL -->
<div class="modal fade" id="submitNoticeModal" tabindex="-1" aria-labelledby="submitNoticeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-warning bg-opacity-10 border-bottom-0 pb-2 pt-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-warning text-dark p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="submitNoticeModalLabel">Important Delivery Notice</h5>
                        <span class="text-muted small">1-Hour Edit &amp; Cancellation Policy</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <!-- Block 1: Time limit (unified into 1 paragraph) -->
                <div class="alert alert-warning border-0 rounded-3 p-3 mb-2">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-clock-history fs-4 text-warning-emphasis flex-shrink-0 mt-1"></i>
                        <div class="small text-dark">
                            <strong>Time limit:</strong> You can only Edit, Delete, or Cancel this delivery request within 1 hour (60 minutes) of submission. Please note that the delivery request will lock automatically after 1 hour, and once locked, no further modifications or cancellations can be processed.
                        </div>
                    </div>
                </div>

                <!-- Block 2: Weight Verification & Cost Finalization -->
                <div class="alert alert-info border-0 rounded-3 p-3 mb-3 bg-info-subtle">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-shield-check fs-4 text-primary flex-shrink-0 mt-1"></i>
                        <div class="small text-dark">
                            <strong>Weight Verification &amp; Final Cost:</strong> When the driver arrives to pick up your parcel, they will physically verify the actual weight. The notification with your confirmed original cost will be sent to you after the driver's verification is completed.
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-2 small text-uppercase letter-spacing-1">Order Details Summary:</h6>
                <div class="bg-light rounded-3 p-3 small mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Pickup:</span>
                        <strong class="text-dark text-truncate ms-2" style="max-width: 250px;" id="modalPickupText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Dropoff:</span>
                        <strong class="text-dark text-truncate ms-2" style="max-width: 250px;" id="modalDropoffText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Single Item Weight:</span>
                        <strong class="text-dark font-mono" id="modalSingleWeightText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Quantity:</span>
                        <strong class="text-dark font-mono" id="modalQuantityText">1 unit</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Total Parcel Weight (B2):</span>
                        <strong class="text-success font-mono" id="modalWeightText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Product Name:</span>
                        <strong class="text-dark text-truncate ms-2" style="max-width: 250px;" id="modalPackageNameText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Package Type:</span>
                        <strong class="text-dark" id="modalPackageTypeText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Dimensions (Single Unit):</span>
                        <strong class="text-dark font-mono" id="modalDimensionsText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Volume Multiplier:</span>
                        <strong class="text-dark font-mono" id="modalVolumeMultiplierText">1.00×</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Total Volume:</span>
                        <strong class="text-primary font-mono" id="modalVolumeCftText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Delivery Type:</span>
                        <strong class="text-dark" id="modalTypeText">Normal Delivery</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Estimated Time:</span>
                        <strong class="text-primary font-mono" id="modalDeliveryDaysText">4 to 6 days</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1" id="modalPickupDateRow">
                        <span class="text-secondary">Pickup Date:</span>
                        <strong class="text-dark" id="modalPickupDateText">-</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Origin Service:</span>
                        <strong class="text-dark" id="modalOriginText">Doorstep Pickup</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Destination Service:</span>
                        <strong class="text-dark" id="modalDestText">Doorstep Delivery</strong>
                    </div>
                    <div id="modalDistanceRow" class="d-flex justify-content-between mb-1 text-secondary">
                        <span><i class="bi bi-speedometer me-1"></i>Total Driving Distance:</span>
                        <strong class="text-dark font-mono" id="modalDistanceText">-</strong>
                    </div>
                    <div id="modalDoorstepSurchargeRow" class="d-flex justify-content-between mb-1 d-none text-primary">
                        <span><i class="bi bi-fuel-pump me-1"></i>Doorstep Extra Charges:</span>
                        <strong class="font-mono" id="modalDoorstepSurchargeText">+Rs. 0</strong>
                    </div>
                    <div id="modalSpecialRow" class="d-flex justify-content-between mb-1 d-none text-warning-emphasis">
                        <span><i class="bi bi-truck me-1"></i>Special Delivery (+15%):</span>
                        <strong class="font-mono" id="modalSpecialSurchargeText">+Rs. 0</strong>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                        <strong class="text-dark">Estimated Cost:</strong>
                        <strong class="text-primary fs-6" id="modalCostText">-</strong>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Review Again</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 text-white fw-semibold" onclick="confirmAndSubmitDelivery()">
                    <i class="bi bi-check2-circle me-1"></i>I Understand, Confirm Booking
                </button>
            </div>
        </div>
    </div>
</div>

<!-- POP-UP 2: EDIT DELIVERY MODAL (Within 1-Hour Window) -->
<div class="modal fade" id="editDeliveryModal" tabindex="-1" aria-labelledby="editDeliveryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0 pt-3 px-4">
                <h5 class="modal-title fw-bold text-dark" id="editDeliveryModalLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Delivery (<span id="editTrackingNumber"></span>)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editDeliveryForm" asp-action="EditDelivery" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editRequestId" name="id" value="" />
                <input type="hidden" id="editVehicleType" name="VehicleType" value="Truck" />

                <div class="modal-body px-4 py-3">
                    <div class="alert alert-info border-0 rounded-3 py-2 px-3 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>You are modifying this delivery request within the 1-hour allowed window.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Pickup Address</label>
                        <input id="editPickup" name="PickupLocation" class="form-control rounded-3 py-2" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Dropoff Address</label>
                        <input id="editDropoff" name="DropoffLocation" class="form-control rounded-3 py-2" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Package Name</label>
                            <input id="editPackageName" name="PackageName" type="text" class="form-control rounded-3 py-2" placeholder="e.g. 55-inch LED TV" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Package Type</label>
                            <select id="editDesc" name="ParcelDescription" class="form-select rounded-3 py-2 fw-semibold">
                                <option value="Electronics">Electronics</option>
                                <option value="Iron or Steel">Iron or Steel</option>
                                <option value="Hardware Parts">Hardware Parts</option>
                            </select>
                        </div>
                    </div>
                    <!-- Weight & Quantity Card in Edit Modal -->
                    <div class="card border border-primary-subtle bg-light-blue p-2 rounded-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="x-small fw-bold text-dark"><i class="bi bi-speedometer2 text-primary me-1"></i>Weight &amp; Quantity</span>
                            <span class="badge bg-primary text-white rounded-pill" style="font-size: 0.65rem;">Auto Total Weight</span>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label x-small text-secondary mb-1">Single Item Wt (kg)</label>
                                <div class="input-group input-group-sm">
                                    <input id="editSingleWeight" name="SingleItemWeight" type="number" step="0.1" min="0.1" class="form-control font-mono" value="2.0" required />
                                    <span class="input-group-text bg-white text-muted">kg</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label x-small text-secondary mb-1">Quantity (Items)</label>
                                <div class="input-group input-group-sm">
                                    <input id="editQuantity" name="Quantity" type="number" min="1" step="1" class="form-control font-mono fw-bold" value="1" required />
                                    <span class="input-group-text bg-white text-muted">items</span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded border" style="font-size: 0.75rem;">
                            <span class="text-secondary">Total Weight (B2):</span>
                            <strong class="text-success font-mono" id="editCalcTotalWeight">2.00 kg</strong>
                        </div>
                        <input type="hidden" id="editWeight" name="ParcelWeight" value="2.0" />
                    </div>
                    <div class="card border border-primary-subtle bg-light-blue p-2 rounded-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="x-small fw-bold text-dark"><i class="bi bi-box-seam text-primary me-1"></i>Dimensions (Single Unit)</span>
                            <span class="badge bg-primary text-white rounded-pill" style="font-size: 0.65rem;">Mandatory in Feet (ft)</span>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label x-small text-secondary mb-1">Length (ft)</label>
                                <div class="input-group input-group-sm">
                                    <input id="editLength" name="Length" type="number" step="0.1" min="0.1" class="form-control font-mono" value="2.0" required />
                                    <span class="input-group-text bg-white text-muted">ft</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <label class="form-label x-small text-secondary mb-1">Width (ft)</label>
                                <div class="input-group input-group-sm">
                                    <input id="editWidth" name="Width" type="number" step="0.1" min="0.1" class="form-control font-mono" value="1.5" required />
                                    <span class="input-group-text bg-white text-muted">ft</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <label class="form-label x-small text-secondary mb-1">Height (ft)</label>
                                <div class="input-group input-group-sm">
                                    <input id="editHeight" name="Height" type="number" step="0.1" min="0.1" class="form-control font-mono" value="1.0" required />
                                    <span class="input-group-text bg-white text-muted">ft</span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded border" style="font-size: 0.75rem;">
                            <span class="text-secondary">Total Volume:</span>
                            <strong class="text-primary font-mono" id="editCalcTotalCft">3.00 CFT</strong>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Delivery Type</label>
                        <select id="editRouteType" name="RouteType" class="form-select rounded-3 py-2 fw-semibold">
                            <option value="Normal">Normal Delivery</option>
                            <option value="Fast">Fast Delivery</option>
                            <option value="Express">Express Delivery</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 text-white fw-semibold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .custom-pickup-pin, .custom-dropoff-pin, .custom-vehicle-marker {
            background: transparent !important;
            border: none !important;
        }
        .pin-bubble {
            width: 32px;
            height: 32px;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 14px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.35);
            position: relative;
        }
        .pin-bubble i {
            transform: rotate(45deg);
        }
        .pin-pickup {
            background: linear-gradient(135deg, #10b981, #047857);
            border: 2px solid #ffffff;
        }
        .pin-dropoff {
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            border: 2px solid #ffffff;
        }
        .pin-pulse {
            position: absolute;
            width: 22px;
            height: 10px;
            border-radius: 50%;
            bottom: -5px;
            left: 5px;
            opacity: 0.6;
            animation: pinPulseAnim 2s infinite ease-out;
        }
        .pin-pulse-green {
            background: rgba(16, 185, 129, 0.4);
        }
        .pin-pulse-red {
