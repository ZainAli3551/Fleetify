            const q = parseInt(document.getElementById('packageQuantity')?.value) || 1;
            const totalWt = Math.round((sw * q) * 100) / 100;

            if (document.getElementById('calcSingleWeight')) {
                document.getElementById('calcSingleWeight').innerText = sw.toFixed(2) + ' kg';
            }
            if (document.getElementById('calcWeightQtyMultiplier')) {
                document.getElementById('calcWeightQtyMultiplier').innerText = `${q} ${q > 1 ? 'items' : 'item'}`;
            }
            if (document.getElementById('calcTotalWeight')) {
                document.getElementById('calcTotalWeight').innerText = totalWt.toFixed(2) + ' kg';
            }
            if (document.getElementById('calcWeightFormula')) {
                document.getElementById('calcWeightFormula').innerText = `${sw.toFixed(2)} kg × ${q} = ${totalWt.toFixed(2)} kg`;
            }
            if (document.getElementById('packageWeight')) {
                document.getElementById('packageWeight').value = totalWt;
            }

            if (document.getElementById('estSingleWeight')) {
                document.getElementById('estSingleWeight').innerText = sw.toFixed(1) + ' kg';
