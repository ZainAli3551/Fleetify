                                <thead>
                                    <tr>
                                        <th>Tracking #</th>
                                        <th>Date</th>
                                        <th>Pickup &rarr; Dropoff</th>
                                        <th>Weight / Item</th>
                                        <th>Estimated Cost</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in Model.MyDeliveries)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-action="Track" asp-route-trackingNumber="@req.TrackingNumber" class="fly-tracking-badge">
                                                    @req.TrackingNumber
                                                </a>
                                            </td>
                                            <td class="small text-muted font-mono">@req.RequestDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <div class="small fw-semibold text-dark text-truncate" style="max-width: 200px;">
                                                    <i class="bi bi-circle-fill text-success me-1 x-small"></i>@req.PickupLocation
                                                </div>
                                                <div class="small text-muted text-truncate" style="max-width: 200px;">
                                                    <i class="bi bi-geo-alt-fill text-danger me-1 x-small"></i>@req.DropoffLocation
                                                </div>
                                            </td>
                                            <td class="small font-mono">
                                                @(req.ParcelWeight > 0 ? req.ParcelWeight.ToString("0.##") : "2.0") kg
                                                <span class="d-block text-muted x-small">@(!string.IsNullOrWhiteSpace(req.PackageName) ? req.PackageName : (req.ParcelDescription ?? "Package"))</span>
                                            </td>
                                            <td class="small fw-bold text-dark font-mono">
                                                PKR @req.EstimatedCost.ToString("N0")
                                            </td>
                                            <td>
                                                @if (req.RequestedStatus == "Delivered")
                                                {
                                                    <span class="fly-status-pill fly-status-delivered">Delivered</span>
                                                }
                                                else if (req.RequestedStatus == "In-Transit" || req.RequestedStatus == "Assigned")
                                                {
                                                    <span class="fly-status-pill fly-status-transit">In Transit</span>
                                                }
                                                else
                                                {
                                                    <span class="fly-status-pill fly-status-pending">Pending</span>
                                                }
