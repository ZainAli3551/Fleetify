            if (document.getElementById('modalVolumeMultiplierText')) {
                const vm = (lastEstimateData && lastEstimateData.volumeMultiplier) || 1.0;
                document.getElementById('modalVolumeMultiplierText').innerText = vm.toFixed(2) + '×';
            }
            if (document.getElementById('modalVolumeCftText')) {
