@model Fleetify.Models.ViewModels.DriverDashboardViewModel
@{
    ViewData["Title"] = "Driver Portal";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- Top Driver Header (Figure 22) -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Fleetify Driver</h2>
            <p class="text-secondary small mb-0">Welcome, <strong class="text-dark">@Model.DriverName</strong> (Status: <span class="badge bg-success-subtle text-success">@Model.AvailabilityStatus</span>)</p>
        </div>
    </div>

    <!-- 4 Top Metric Cards (Figure 22) -->
    <div class="row g-3 mb-4">
        <!-- Today's Deliveries -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Today's Deliveries</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TodaysDeliveries</h3>
                    </div>
                    <div class="kpi-icon bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Completed -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Completed</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.CompletedDeliveries</h3>
                    </div>
                    <div class="kpi-icon bg-success-subtle text-success rounded-circle p-3">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Distance Today -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Distance Today</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.DistanceTodayKm km</h3>
                    </div>
                    <div class="kpi-icon bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="bi bi-cursor-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Earnings Today -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-xs rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small">Earnings Today</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">Rs. @Math.Floor(Model.EarningsToday).ToString("F0")</h3>
                    </div>
                    <div class="kpi-icon bg-purple-subtle text-purple rounded-circle p-3">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs (Figure 22: Available, Active, Completed) -->
    <ul class="nav nav-pills mb-4 gap-2" id="driverTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 py-2" id="available-tab" data-bs-toggle="tab" data-bs-target="#available-pane" type="button" role="tab">
                Available (@Model.AvailableAssignments.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 py-2" id="active-tab" data-bs-toggle="tab" data-bs-target="#active-pane" type="button" role="tab">
                Active (@Model.ActiveAssignments.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 py-2" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed-pane" type="button" role="tab">
                Completed (@Model.CompletedAssignments.Count)
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="driverTabsContent">
        <!-- AVAILABLE TAB (Figure 22) -->
        <div class="tab-pane fade show active" id="available-pane" role="tabpanel" tabindex="0">
            @if (Model.AvailableAssignments.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var a in Model.AvailableAssignments)
                    {
                        var req = a.DeliveryRequest;
                        if (req == null) continue;

                        <div class="card border-0 shadow-xs rounded-4 p-4 bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="text-secondary small">Tracking Number</span>
                                    <h5 class="fw-bold text-dark mb-0 font-mono">@req.TrackingNumber</h5>
                                </div>
                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1 font-mono">PENDING</span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-circle-fill text-muted mt-1 small"></i>
                                        <div>
                                            <span class="text-secondary small">Pickup</span>
                                            <div class="fw-semibold text-dark">@req.PickupLocation</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                                        <div>
                                            <span class="text-secondary small">Dropoff</span>
                                            <div class="fw-semibold text-dark">@req.DropoffLocation</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 py-2 border-top border-bottom my-2 small text-secondary">
                                <div class="col-6 col-md-3">
                                    <span>Customer:</span>
                                    <strong class="text-dark d-block">@(req.User?.FullName ?? "Customer")</strong>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span>Distance:</span>
                                    <strong class="text-dark d-block">@req.DistanceKm km</strong>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span>Weight:</span>
                                    <strong class="text-dark d-block">@req.ParcelWeight kg</strong>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span>Vehicle:</span>
                                    <strong class="text-dark d-block">@(a.Vehicle?.VehicleNumber ?? "Fleet Vehicle")</strong>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
                                <h4 class="fw-bold text-dark mb-0">Rs. @Math.Floor(req.EstimatedCost).ToString("F0")</h4>
                                <div class="d-flex gap-2">
                                    <form asp-action="RejectAssignment" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="assignmentId" value="@a.AssignmentID" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-4">Reject</button>
                                    </form>
                                    <form asp-action="AcceptAssignment" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="assignmentId" value="@a.AssignmentID" />
                                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 text-white">Accept</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-xs rounded-4 bg-white p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 mb-2"></i>
                    <h5>No new assignments currently waiting.</h5>
                    <p class="small mb-0">Check back shortly or refresh when the dispatcher assigns new deliveries.</p>
                </div>
            }
        </div>

        <!-- ACTIVE TAB -->
        <div class="tab-pane fade" id="active-pane" role="tabpanel" tabindex="0">
            @if (Model.ActiveAssignments.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var a in Model.ActiveAssignments)
                    {
                        var req = a.DeliveryRequest;
                        if (req == null) continue;

                        <div class="card border-0 shadow-xs rounded-4 p-4 bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="text-secondary small">Tracking Number</span>
                                    <h5 class="fw-bold text-primary mb-0 font-mono">@req.TrackingNumber</h5>
                                </div>
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 font-mono">
                                    @(req.RequestedStatus.ToUpper())
                                </span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <i class="bi bi-geo-alt-fill text-muted me-1"></i>From: <strong>@req.PickupLocation</strong>
                                </div>
                                <div class="col-md-6">
                                    <i class="bi bi-flag-fill text-danger me-1"></i>To: <strong>@req.DropoffLocation</strong>
                                </div>
                            </div>

                            <!-- Parcel Pickup & Weight Verification Section -->
                            <div class="p-3 @(req.WeightStatus == "Finalized" ? "bg-success-subtle border-success-subtle" : req.WeightStatus == "VerifiedMatched" ? "bg-info-subtle border-info-subtle" : req.WeightStatus == "DiscrepancyReported" ? "bg-warning-subtle border-warning-subtle" : "bg-warning-subtle border-warning-subtle") rounded-3 mt-2 border mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-bold text-dark">
                                        <i class="bi bi-shield-check text-primary me-1"></i>Pickup &amp; Weight Verification
                                    </span>
                                    <div>
                                        <span class="badge bg-light text-dark border me-1">Declared: @req.ParcelWeight kg</span>
                                        @if (req.WeightStatus == "Finalized")
                                        {
                                            <span class="badge bg-success text-white"><i class="bi bi-patch-check-fill me-1"></i>Cost Finalized: Rs. @Math.Floor(req.EstimatedCost).ToString("F0")</span>
                                        }
                                        else if (req.WeightStatus == "VerifiedMatched")
                                        {
                                            <span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i>Weight Verified (@(req.VerifiedWeight ?? req.ParcelWeight) kg)</span>
                                        }
                                        else if (req.WeightStatus == "DiscrepancyReported")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Discrepancy: @req.VerifiedWeight kg (Awaiting Admin Finalization)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white">Pending Verification</span>
                                        }
                                    </div>
                                </div>

                                @if (req.WeightStatus != "Finalized")
                                {
                                    <form asp-action="VerifyWeight" method="post" class="d-flex flex-wrap gap-2 align-items-center mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="assignmentId" value="@a.AssignmentID" />

                                        <div class="input-group input-group-sm" style="max-width: 200px;">
                                            <span class="input-group-text bg-white fw-semibold">Measured</span>
                                            <input name="verifiedWeight" type="number" step="0.1" min="0.1" class="form-control" value="@(req.VerifiedWeight ?? req.ParcelWeight)" required />
                                            <span class="input-group-text bg-white">kg</span>
                                        </div>

                                        <input name="remarks" class="form-control form-control-sm rounded-pill" placeholder="Note (e.g. scale calibration, heavy parcel)..." style="max-width: 280px;" />

                                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 text-white">
                                            <i class="bi bi-check2-circle me-1"></i>Verify &amp; Report Weight
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="small text-success mt-1">
                                        <i class="bi bi-check2-all me-1"></i>Cost finalized by Admin based on verified weight (@req.ParcelWeight kg). Proceed with dropoff delivery.
                                    </div>
                                }
                            </div>

                            <!-- Progress Actions -->
                            <div class="p-3 bg-light rounded-3 mt-2">
                                <span class="small fw-semibold text-secondary d-block mb-2">Update Delivery Progress:</span>
                                <form asp-action="UpdateDeliveryStatus" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="assignmentId" value="@a.AssignmentID" />

                                    <select name="status" class="form-select form-select-sm rounded-pill" style="max-width: 170px;">
                                        <option value="In-Transit" selected="@(req.RequestedStatus == "In-Transit")">In-Transit</option>
                                        <option value="Delivered">Delivered</option>
                                    </select>

                                    <input name="remarks" class="form-control form-control-sm rounded-pill" placeholder="Driver notes / location remarks..." style="max-width: 320px;" />

                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-4 text-white">
                                        <i class="bi bi-arrow-right-circle me-1"></i>Save Progress
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-xs rounded-4 bg-white p-5 text-center text-muted">
                    <i class="bi bi-truck fs-1 mb-2"></i>
                    <h5>No active deliveries in progress.</h5>
                    <p class="small mb-0">Accept an available delivery from the Available tab to begin delivery.</p>
                </div>
            }
        </div>

        <!-- COMPLETED TAB -->
        <div class="tab-pane fade" id="completed-pane" role="tabpanel" tabindex="0">
            @if (Model.CompletedAssignments.Any())
            {
                <div class="card border-0 shadow-xs rounded-4 bg-white p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th>Tracking #</th>
                                    <th>Customer</th>
                                    <th>Dropoff Destination</th>
                                    <th>Completed At</th>
                                    <th>Distance</th>
                                    <th>Your Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.CompletedAssignments)
                                {
                                    <tr>
                                        <td class="fw-bold font-mono text-primary">@a.DeliveryRequest?.TrackingNumber</td>
                                        <td>@a.DeliveryRequest?.User?.FullName</td>
                                        <td>@a.DeliveryRequest?.DropoffLocation</td>
                                        <td>@a.AssignedDate.ToString("MMM dd, yyyy")</td>
                                        <td>@a.DeliveryRequest?.DistanceKm km</td>
                                        <td class="fw-bold text-success">Rs. @Math.Floor(((a.DeliveryRequest?.EstimatedCost ?? 0) * 0.70)).ToString("F0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-xs rounded-4 bg-white p-5 text-center text-muted">
                    <i class="bi bi-award fs-1 mb-2"></i>
                    <h5>No completed deliveries yet.</h5>
                </div>
            }
        </div>
    </div>
</div>
