@using System.Security.Claims
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var adminName = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(adminName) || adminName == "admin@fleetify.com") { adminName = "Alex Thompson"; }
    var initials = string.Join("", adminName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
    if (string.IsNullOrEmpty(initials)) { initials = "AT"; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin Dashboard") - Fleetify</title>
    <!-- Google Fonts: Plus Jakarta Sans, Inter, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Leaflet Map CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/favicon.png?v=20261009" asp-append-version="true" />

    <style>
        :root {
            --fleet-bg: #0b111e;
            --fleet-sidebar-bg: #0d1527;
            --fleet-card-bg: #111a2e;
            --fleet-card-border: rgba(255, 255, 255, 0.07);
            --fleet-blue: #2563eb;
            --fleet-blue-light: #3b82f6;
            --fleet-text-main: #ffffff;
            --fleet-text-muted: #8fa0b5;
            --fleet-font: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            --fleet-mono: 'JetBrains Mono', monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--fleet-font);
            background-color: var(--fleet-bg);
            color: var(--fleet-text-main);
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        /* Generic Dark Overrides for nested admin views */
        .card,
        .fleet-table-card,
        .modal-content {
            background-color: var(--fleet-card-bg) !important;
            border-color: var(--fleet-card-border) !important;
            color: var(--fleet-text-main) !important;
        }

        .table {
            color: var(--fleet-text-main) !important;
            --bs-table-bg: transparent !important;
        }

        .table-light, thead {
            background-color: #0e172a !important;
            color: #8fa0b5 !important;
            border-color: rgba(255, 255, 255, 0.06) !important;
        }

        .table td, .table th {
            border-color: rgba(255, 255, 255, 0.05) !important;
        }

        .text-dark {
            color: #ffffff !important;
        }

        .text-secondary, .text-muted {
            color: var(--fleet-text-muted) !important;
        }

        /* =========================================================================
           LEFT DARK SIDEBAR (Matches Reference Design)
           ========================================================================= */
        .admin-sidebar {
            width: 220px;
            background-color: var(--fleet-sidebar-bg);
            color: #ffffff;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1040;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            overflow-y: auto;
        }

        .sidebar-brand-wrapper {
            padding: 22px 20px 18px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-logo-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: linear-gradient(135deg, #1d4ed8 0%, #38bdf8 100%);
            box-shadow: 0 2px 10px rgba(37, 99, 235, 0.4);
        }

        .sidebar-logo-icon svg {
            width: 20px;
            height: 20px;
            fill: #ffffff;
        }

        .sidebar-brand-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.02em;
            line-height: 1;
        }

        .sidebar-menu {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 12px 12px;
            flex-grow: 1;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            color: #8fa0b5;
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.88rem;
            font-weight: 500;
            transition: all 0.15s ease;
        }

        .sidebar-item i {
            font-size: 1.05rem;
            width: 20px;
            text-align: center;
        }

        .sidebar-item:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.04);
        }

        .sidebar-item.active {
            background-color: #172554;
            color: #3b82f6;
            font-weight: 600;
        }

        .sidebar-item.active i {
            color: #3b82f6;
        }

        .sidebar-chevron {
            margin-left: auto;
            font-size: 0.72rem;
            color: #64748b;
        }

        /* =========================================================================
           MAIN WORKSPACE & TOPBAR
           ========================================================================= */
        .admin-main-wrapper {
            margin-left: 220px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            width: calc(100% - 220px);
            background-color: var(--fleet-bg);
        }

        .admin-topbar {
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--fleet-bg);
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            gap: 20px;
        }

        .admin-topbar-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .topbar-hamburger-btn {
            background: transparent;
            border: none;
            color: #8fa0b5;
            font-size: 1.25rem;
            cursor: pointer;
            padding: 4px;
            line-height: 1;
            display: flex;
            align-items: center;
        }

        .topbar-hamburger-btn:hover {
            color: #ffffff;
        }

        .topbar-tab-item {
            color: #ffffff;
            font-size: 0.88rem;
            font-weight: 600;
            position: relative;
            padding: 6px 2px 8px 2px;
            text-decoration: none;
        }

        .topbar-tab-item.active::after {
            content: '';
            position: absolute;
            bottom: -13px;
            left: 0;
            right: 0;
            height: 2px;
            background-color: #3b82f6;
            border-radius: 2px;
        }

        .admin-topbar-right {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .topbar-search-box {
            position: relative;
            width: 240px;
        }

        .topbar-search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 0.85rem;
        }

        .topbar-search-input {
            width: 100%;
            background: #111a2e;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 9999px;
            padding: 7px 14px 7px 34px;
            font-size: 0.82rem;
            color: #ffffff;
            outline: none;
            transition: all 0.2s ease;
        }

        .topbar-search-input::placeholder {
            color: #64748b;
        }

        .topbar-search-input:focus {
            border-color: #3b82f6;
            background: #131f38;
        }

        .topbar-bell-btn {
            background: transparent;
            border: none;
            color: #8fa0b5;
            font-size: 1.15rem;
            cursor: pointer;
            position: relative;
            padding: 4px;
            line-height: 1;
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .topbar-bell-btn:hover {
            color: #ffffff;
        }

        .bell-dot-badge {
            position: absolute;
            top: 3px;
            right: 4px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #ef4444;
        }

        .topbar-profile-pill {
            display: flex;
            align-items: center;
            gap: 9px;
            cursor: pointer;
            padding: 3px 6px;
            border-radius: 8px;
            transition: background 0.15s ease;
            user-select: none;
        }

        .topbar-profile-pill:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .profile-avatar-img {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .profile-user-name {
            font-size: 0.84rem;
            font-weight: 500;
            color: #ffffff;
        }

        .profile-chevron {
            font-size: 0.72rem;
            color: #8fa0b5;
        }

        /* Content Body */
        .admin-content-body {
            padding: 20px 28px 28px 28px;
            flex-grow: 1;
        }

        /* Responsive Mobile Breakpoint */
        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }
            .admin-sidebar.show {
                transform: translateX(0);
            }
            .admin-main-wrapper {
                margin-left: 0;
                width: 100%;
            }
            .admin-topbar {
                padding: 12px 16px;
            }
            .admin-content-body {
                padding: 16px;
            }
            .topbar-search-box {
                width: 160px;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ========================================================================
         1. LEFT DARK SIDEBAR (EXACT MATCH ACROSS ALL SECTIONS)
         ======================================================================== -->
    <aside class="admin-sidebar" id="adminSidebar">
        <!-- Top Branding: Wing F Logo + Fleetify -->
        <div class="sidebar-brand-wrapper">
            <div class="sidebar-logo-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                </svg>
            </div>
            <span class="sidebar-brand-title">Fleetify</span>
        </div>

        <!-- Navigation Links with Reference Matching Items -->
        <nav class="sidebar-menu">
            <a href="/Admin/Index" class="sidebar-item @(currentAction == "Index" ? "active" : "")">
                <i class="bi bi-grid-fill"></i>
                <span>Dashboard</span>
            </a>
            <a href="/Admin/Index#realTimeFleetMap" class="sidebar-item">
                <i class="bi bi-map"></i>
                <span>Map View</span>
            </a>
            <a href="/Admin/Vehicles" class="sidebar-item @(currentAction == "Vehicles" ? "active" : "")">
                <i class="bi bi-car-front"></i>
                <span>Vehicles</span>
                <i class="bi bi-chevron-down sidebar-chevron"></i>
            </a>
            <a href="/Admin/Drivers" class="sidebar-item @(currentAction == "Drivers" ? "active" : "")">
                <i class="bi bi-person"></i>
                <span>Drivers</span>
            </a>
            <a href="/Admin/Deliveries" class="sidebar-item @(currentAction == "Deliveries" ? "active" : "")">
                <i class="bi bi-send"></i>
                <span>Trips</span>
            </a>
            <a href="/Admin/Maintenance" class="sidebar-item @(currentAction == "Maintenance" ? "active" : "")">
                <i class="bi bi-file-earmark-text"></i>
                <span>Reports</span>
            </a>
            <a href="/Admin/Support" class="sidebar-item @(currentAction == "Support" ? "active" : "")">
                <i class="bi bi-gear"></i>
                <span>Settings</span>
            </a>
            <a href="/Admin/Assignments" class="sidebar-item @(currentAction == "Assignments" ? "active" : "")">
                <i class="bi bi-shield-check"></i>
                <span>Admin</span>
            </a>
        </nav>
    </aside>

    <!-- ========================================================================
         2. MAIN ADMIN WORKSPACE
         ======================================================================== -->
    <div class="admin-main-wrapper">
        
        <!-- Top App Bar / Search Bar (Matches Reference Image) -->
        <header class="admin-topbar">
            <!-- Left: Hamburger Menu + Dashboard Tab -->
            <div class="admin-topbar-left">
                <button class="topbar-hamburger-btn" type="button" onclick="document.getElementById('adminSidebar').classList.toggle('show')">
                    <i class="bi bi-list"></i>
                </button>
                <a href="/Admin/Index" class="topbar-tab-item active">Dashboard</a>
            </div>

            <!-- Right: Search Box, Bell Icon with Dot, Alex Thompson Profile -->
            <div class="admin-topbar-right">
                <div class="topbar-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" class="topbar-search-input" id="adminGlobalSearch" placeholder="Search" onkeyup="filterAdminGlobal(this.value);" />
                </div>

                <a href="/Admin/Maintenance" class="topbar-bell-btn" title="Alerts">
                    <i class="bi bi-bell"></i>
                    <span class="bell-dot-badge"></span>
                </a>

                <!-- Profile Dropdown -->
                <div class="dropdown">
                    <div class="topbar-profile-pill" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&h=100&fit=crop&crop=face" alt="Alex Thompson" class="profile-avatar-img" />
                        <span class="profile-user-name">Alex Thompson</span>
                        <i class="bi bi-chevron-down profile-chevron"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg rounded-3 py-2 border-secondary border-opacity-25" style="background: #0d1527;">
                        <li class="px-3 py-1 text-muted small text-uppercase">Admin Portal</li>
                        <li class="px-3 py-1 text-white fw-bold small">@adminName</li>
                        <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 small text-light" href="/Admin/Support">
                                <i class="bi bi-headset text-info"></i>Support Desk
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 small text-light" href="/Admin/Maintenance">
                                <i class="bi bi-cpu text-primary"></i>AI Maintenance
                            </a>
                        </li>
                        <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger small">
                                    <i class="bi bi-box-arrow-right"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Workspace Body -->
        <main class="admin-content-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3 d-flex align-items-center gap-2 small bg-success bg-opacity-10 text-success border-success border-opacity-25" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3 d-flex align-items-center gap-2 small bg-danger bg-opacity-10 text-danger border-danger border-opacity-25" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap 5.3.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // Global search filter for any table on the current active admin view
        function filterAdminGlobal(keyword) {
            keyword = (keyword || '').toLowerCase();
            const tables = document.querySelectorAll('table tbody tr');
            tables.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(keyword) ? '' : 'none';
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
