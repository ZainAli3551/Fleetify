@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto" style="max-width: 500px;">
        <div class="text-danger mb-3">
            <i class="bi bi-shield-x fs-1"></i>
        </div>
        <h3 class="fw-bold mb-2">Access Denied</h3>
        <p class="text-muted mb-4">You do not have permission to view this resource with your current role.</p>
        <div>
            <a asp-controller="Account" asp-action="SelectRole" class="btn btn-outline-primary rounded-pill px-4">Switch Role</a>
        </div>
    </div>
</div>
