@{
    ViewData["Title"] = "Intelligent Logistics & Fleet Management";
}

<!-- Custom Styles for High-End Landing Page -->
<style>
    /* Hero Ambient Lighting & Gradients */
    .landing-hero {
        background: radial-gradient(circle at 10% 20%, rgba(37, 99, 235, 0.18) 0%, transparent 40%),
                    radial-gradient(circle at 90% 80%, rgba(6, 182, 212, 0.15) 0%, transparent 40%),
                    linear-gradient(135deg, #090e17 0%, #0f172a 50%, #111827 100%);
        color: #ffffff;
        position: relative;
        overflow: hidden;
        border-radius: 1.5rem;
        margin-top: -1rem;
    }

    .landing-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
        background-size: 28px 28px;
        opacity: 0.35;
        pointer-events: none;
    }

    /* Glassmorphism Cards */
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.08);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .glass-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 35px -12px rgba(37, 99, 235, 0.16);
        border-color: rgba(147, 197, 253, 0.8);
    }

    /* Portal Cards Hero Variant */
    .portal-card {
        position: relative;
        border-radius: 1.25rem;
        overflow: hidden;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .portal-card:hover {
        transform: translateY(-8px);
    }

    .portal-admin {
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        border: 1px solid rgba(99, 102, 241, 0.25);
    }

    .portal-admin:hover {
        box-shadow: 0 20px 40px -15px rgba(99, 102, 241, 0.25);
        border-color: #6366f1;
    }

    .portal-customer {
        background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);
        border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .portal-customer:hover {
        box-shadow: 0 20px 40px -15px rgba(16, 185, 129, 0.25);
        border-color: #10b981;
    }

    /* Glow Badges */
    .badge-glow-blue {
        background: rgba(37, 99, 235, 0.15);
        color: #60a5fa;
        border: 1px solid rgba(96, 165, 250, 0.3);
    }

    .badge-glow-green {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(52, 211, 153, 0.3);
    }

    /* Tracking Search Bar */
    .hero-search-bar {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 9999px;
        padding: 6px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        transition: all 0.25s ease;
    }

    .hero-search-bar:focus-within {
        border-color: #60a5fa;
        background: rgba(255, 255, 255, 0.15);
        box-shadow: 0 8px 32px 0 rgba(37, 99, 235, 0.35);
    }

    .hero-search-bar input {
        background: transparent;
        border: none;
        color: #ffffff;
        padding-left: 1.25rem;
    }

    .hero-search-bar input::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    .hero-search-bar input:focus {
        outline: none;
        box-shadow: none;
        color: #ffffff;
    }

    /* Feature Icon Bubbles */
    .icon-bubble {
        width: 58px;
        height: 58px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    /* Floating Metric Pill */
    .metric-pill {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 1rem;
        padding: 0.85rem 1.25rem;
        backdrop-filter: blur(8px);
    }

    /* Interactive Hub Badges */
    .hub-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.85rem;
        border-radius: 9999px;
        font-size: 0.82rem;
        font-weight: 500;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #334155;
        transition: all 0.2s ease;
    }

    .hub-badge:hover {
        background: #eff6ff;
        color: #2563eb;
        border-color: #bfdbfe;
        transform: translateY(-2px);
    }
</style>

<div class="container-fluid px-lg-5 py-3">

    <!-- 1. HERO SECTION -->
    <div class="landing-hero p-4 p-md-5 mb-5 shadow-lg">
        <div class="row align-items-center g-4 position-relative" style="z-index: 2;">
            <div class="col-lg-7 text-center text-lg-start">
                
                <!-- Status Pill -->
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill badge-glow-blue mb-3 small">
                    <span class="spinner-grow spinner-grow-sm text-info" style="width: 8px; height: 8px;" role="status"></span>
                    <span class="fw-semibold">Fleetify Nationwide Network Active</span>
                    <span class="text-white-50">|</span>
                    <span class="text-white-50">10 Major City Hubs</span>
                </div>

                <!-- Main Punchy Title -->
                <h1 class="display-4 fw-bold text-white mb-3 lh-sm">
                    Next-Gen Intelligent Fleet Operations &amp; Express Logistics
                </h1>
                
                <!-- Subtitle -->
                <p class="fs-5 text-light opacity-75 mb-4 pe-lg-4" style="max-width: 620px;">
                    Experience seamless doorstep pickups, central warehouse drop-offs, and live GPS route visualization with precision AI-powered cost estimation.
                </p>

                <!-- Hero Live Tracking Search Bar -->
                <div class="pe-lg-4 mb-4" style="max-width: 580px;">
                    <form action="/Customer/Track" method="get" class="hero-search-bar d-flex align-items-center">
                        <i class="bi bi-search text-info fs-5 ms-3"></i>
                        <input type="text" name="trackingNumber" class="form-control" placeholder="Enter Tracking # (e.g. FLT-2026-XXXXXX)" required autocomplete="off" />
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 text-white fw-semibold d-flex align-items-center gap-2 flex-shrink-0 shadow-sm">
                            <span>Track</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </form>
                    <span class="x-small text-white-50 ms-3 mt-1.5 d-block">
                        <i class="bi bi-shield-check text-success me-1"></i>Track any ongoing shipment live without signing in.
                    </span>
                </div>

                <!-- Quick Metrics Grid -->
                <div class="row g-3 pe-lg-4 pt-2">
                    <div class="col-4">
                        <div class="metric-pill text-center text-lg-start">
                            <h4 class="fw-bold text-white mb-0">10+</h4>
                            <span class="x-small text-white-50">Central Hubs</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="metric-pill text-center text-lg-start">
                            <h4 class="fw-bold text-white mb-0">99.4%</h4>
                            <span class="x-small text-white-50">On-Time Arrival</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="metric-pill text-center text-lg-start">
                            <h4 class="fw-bold text-white mb-0">1-Hour</h4>
                            <span class="x-small text-white-50">Edit / Cancel Lock</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Hero Illustration / Visual Showcase -->
            <div class="col-lg-5 text-center">
                <div class="position-relative mx-auto" style="max-width: 440px;">
                    <!-- Floating Map & Route Visualizer Preview Card -->
                    <div class="card border-0 rounded-4 shadow-lg p-3 text-dark bg-white position-relative" style="z-index: 3;">
                        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary text-white rounded-pill px-2.5 py-1">
                                    <i class="bi bi-broadcast me-1"></i>Live Route
                                </span>
                                <span class="small fw-bold text-secondary">Gujranwala &rarr; Karachi</span>
                            </div>
                            <span class="badge bg-success-subtle text-success small font-mono">1,259 km</span>
                        </div>
                        
                        <div class="p-3 bg-light rounded-3 text-start mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="x-small text-muted">Delivery Speed</span>
                                <span class="badge bg-primary text-white x-small">Normal Delivery</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong class="small text-dark">Estimated Transit</strong>
                                <span class="fw-bold text-primary font-mono small">4 to 6 days</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-1 px-1">
                            <div class="text-start">
                                <span class="x-small text-muted d-block">Calculated Total</span>
                                <strong class="fs-4 text-primary fw-bold font-mono">Rs. 7,977</strong>
                            </div>
                            <a asp-controller="Account" asp-action="Login" asp-route-role="Customer" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                Ship This Route &rarr;
                            </a>
                        </div>
                    </div>

                    <!-- Glowing Decorative Underlay -->
                    <div class="position-absolute top-50 start-50 translate-middle w-100 h-100 rounded-circle" style="background: radial-gradient(circle, rgba(37, 99, 235, 0.45) 0%, transparent 70%); filter: blur(30px); z-index: 1;"></div>
                </div>
            </div>
        </div>
    </div>


    <!-- 2. CORE PORTAL SELECTOR (MODULE 1 & MODULE 2) -->
    <div class="mb-5">
        <div class="text-center mb-4">
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 font-mono fw-semibold mb-2">ACCESS CONTROL</span>
            <h2 class="fw-bold text-dark mb-1">Choose Your Portal to Begin</h2>
            <p class="text-secondary small">Select your designated environment to access fleet management or customer services.</p>
        </div>

        <div class="row justify-content-center g-4">
            <!-- Module 1: Admin Operations Portal -->
            <div class="col-md-6 col-lg-5">
                <a asp-controller="Account" asp-action="Login" asp-route-role="Admin" class="text-decoration-none">
                    <div class="card h-100 portal-card portal-admin shadow-sm p-4 p-lg-4 text-start">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="icon-bubble bg-indigo-subtle text-indigo">
                                <i class="bi bi-shield-lock-fill text-primary"></i>
                            </div>
                            <span class="badge bg-indigo-subtle text-indigo rounded-pill px-3 py-1 font-mono small fw-semibold">MODULE 1</span>
                        </div>
                        
                        <h3 class="fw-bold text-dark mb-2">Fleet Operations Portal</h3>
                        <p class="text-muted small mb-4">
                            Central command center for authorized fleet administrators. Full dispatch management, automated driver routing, and enterprise analytics.
                        </p>

                        <!-- Key Admin Features -->
                        <ul class="list-unstyled small text-secondary mb-4 space-y-2">
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-primary"></i>
                                <span><strong>Driver &amp; Fleet Assignments:</strong> Automated and manual vehicle dispatches</span>
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-primary"></i>
                                <span><strong>On-Call Backup Directory:</strong> Instant replacement driver directory</span>
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-primary"></i>
                                <span><strong>AI Maintenance Diagnostics:</strong> Proactive fleet health alerts</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-primary"></i>
                                <span><strong>24/7 Live Support Desk:</strong> Real-time customer chat management</span>
                            </li>
                        </ul>

                        <div class="mt-auto pt-2">
                            <button class="btn btn-primary w-100 rounded-pill py-2.5 text-white fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                                <span>Enter Admin Operations</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Module 2: Customer / User Portal -->
            <div class="col-md-6 col-lg-5">
                <a asp-controller="Account" asp-action="Login" asp-route-role="Customer" class="text-decoration-none">
                    <div class="card h-100 portal-card portal-customer shadow-sm p-4 p-lg-4 text-start">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="icon-bubble bg-success-subtle text-success">
                                <i class="bi bi-box-seam-fill"></i>
                            </div>
                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 font-mono small fw-semibold">MODULE 2</span>
                        </div>
                        
                        <h3 class="fw-bold text-dark mb-2">Customer Shipping Portal</h3>
                        <p class="text-muted small mb-4">
                            Effortless parcel bookings for individuals and businesses. Choose doorstep collection or warehouse dropoff with transparent pricing.
                        </p>

                        <!-- Key Customer Features -->
                        <ul class="list-unstyled small text-secondary mb-4 space-y-2">
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span><strong>Dual Pickup Modes:</strong> Doorstep rider pickup or warehouse drop-off</span>
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span><strong>1-Hour Edit &amp; Cancel Policy:</strong> Guaranteed modification window</span>
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span><strong>Real-time Route Map:</strong> Live GPS tracking from origin to destination</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span><strong>Arrival Preferences:</strong> Choose hub self-pickup or doorstep drop</span>
                            </li>
                        </ul>

                        <div class="mt-auto pt-2">
                            <button class="btn btn-success w-100 rounded-pill py-2.5 text-white fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm" style="background-color: #10b981; border-color: #10b981;">
                                <span>Enter Customer Portal</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>


    <!-- 3. INTERACTIVE INSTANT RATE ESTIMATOR WIDGET -->
    <div class="card glass-card border-0 rounded-4 p-4 p-lg-5 mb-5 shadow-sm">
        <div class="row align-items-center g-4">
            <div class="col-lg-5">
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 font-mono fw-semibold mb-2">LIVE ESTIMATOR</span>
                <h3 class="fw-bold text-dark mb-2">Check Delivery Cost in Real-Time</h3>
                <p class="text-secondary small mb-4">
                    Calculate fair, formula-accurate delivery rates across all 10 hubs and special delivery routes before booking.
                </p>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-secondary mb-1">Origin Hub</label>
                        <select id="estOriginSelect" class="form-select rounded-3 py-2 fw-semibold">
                            <option value="Fleetify GT Road Hub, Climax Town, Main GT Road, Gujranwala" selected>Fleetify GT Road Hub - Gujranwala</option>
                            <option value="Fleetify Central Hub, Multan Road, Near Thokar Niaz Baig, Lahore">Fleetify Central Hub - Lahore</option>
                            <option value="Fleetify South Hub, Plot 42, Korangi Industrial Area, Karachi">Fleetify South Hub - Karachi</option>
                            <option value="Fleetify North Hub, Sector I-9/2 Industrial Area, Islamabad">Fleetify North Hub - Islamabad</option>
                            <option value="Fleetify Twin Cities Hub, Westridge 1, Main Peshawar Road, Rawalpindi">Fleetify Twin Cities Hub - Rawalpindi</option>
                            <option value="Fleetify Textile Hub, Small Industrial Estate, Sargodha Road, Faisalabad">Fleetify Textile Hub - Faisalabad</option>
                            <option value="Fleetify South Punjab Hub, Industrial Estate Phase 2, Khanewal Road, Multan">Fleetify South Punjab Hub - Multan</option>
                            <option value="Fleetify Khyber Hub, Industrial Estate, Jamrud Road, Hayatabad, Peshawar">Fleetify Khyber Hub - Peshawar</option>
                            <option value="Fleetify Export Hub, Sambrial Road, Near Dry Port, Sialkot">Fleetify Export Hub - Sialkot</option>
                            <option value="Fleetify Balochistan Hub, Joint Road, Near Railway Station, Quetta">Fleetify Balochistan Hub - Quetta</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold text-secondary mb-1">Destination Hub or City</label>
                        <select id="estDestSelect" class="form-select rounded-3 py-2 fw-semibold">
                            <option value="Fleetify South Hub, Plot 42, Korangi Industrial Area, Karachi" selected>Fleetify South Hub - Karachi</option>
                            <option value="Fleetify Central Hub, Multan Road, Near Thokar Niaz Baig, Lahore">Fleetify Central Hub - Lahore</option>
                            <option value="Fleetify GT Road Hub, Climax Town, Main GT Road, Gujranwala">Fleetify GT Road Hub - Gujranwala</option>
                            <option value="Fleetify North Hub, Sector I-9/2 Industrial Area, Islamabad">Fleetify North Hub - Islamabad</option>
                            <option value="Fleetify Twin Cities Hub, Westridge 1, Main Peshawar Road, Rawalpindi">Fleetify Twin Cities Hub - Rawalpindi</option>
                            <option value="Fleetify Textile Hub, Small Industrial Estate, Sargodha Road, Faisalabad">Fleetify Textile Hub - Faisalabad</option>
                            <option value="Fleetify South Punjab Hub, Industrial Estate Phase 2, Khanewal Road, Multan">Fleetify South Punjab Hub - Multan</option>
                            <option value="Fleetify Khyber Hub, Industrial Estate, Jamrud Road, Hayatabad, Peshawar">Fleetify Khyber Hub - Peshawar</option>
                            <option value="Fleetify Export Hub, Sambrial Road, Near Dry Port, Sialkot">Fleetify Export Hub - Sialkot</option>
                            <option value="Fleetify Balochistan Hub, Joint Road, Near Railway Station, Quetta">Fleetify Balochistan Hub - Quetta</option>
                            <option value="Sahiwal, Pakistan">Sahiwal (Special Delivery +15%)</option>
                            <option value="Okara, Pakistan">Okara (Special Delivery +15%)</option>
                            <option value="Kasur, Pakistan">Kasur (Special Delivery +15%)</option>
                            <option value="Sukkur, Pakistan">Sukkur (Special Delivery +15%)</option>
                        </select>
                    </div>

                    <div class="col-6">
                        <label class="form-label small fw-semibold text-secondary mb-1">Weight (kg)</label>
                        <input type="number" id="estWeightInput" class="form-control rounded-3 py-2 fw-semibold" value="2.0" min="0.5" step="0.5" />
                    </div>

                    <div class="col-6">
                        <label class="form-label small fw-semibold text-secondary mb-1">Delivery Speed</label>
                        <select id="estSpeedSelect" class="form-select rounded-3 py-2 fw-semibold">
                            <option value="Normal" selected>Normal Delivery</option>
                            <option value="Fast">Fast Delivery</option>
                            <option value="Express">Express Delivery</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Result Card (Right side) -->
            <div class="col-lg-7">
                <div class="card border-0 rounded-4 p-4 text-white shadow-lg" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-50">
                        <span class="badge bg-primary text-white rounded-pill px-3 py-1">
                            <i class="bi bi-lightning-charge-fill me-1"></i>Instant AI Quote
                        </span>
                        <span id="estProviderBadge" class="small text-white-50">Verified Road Distance</span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <span class="x-small text-white-50 d-block">Distance</span>
                            <strong class="fs-5 text-white font-mono" id="previewDistance">1,259 km</strong>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="x-small text-white-50 d-block">Transit Time</span>
                            <strong class="fs-5 text-info" id="previewDays">4 to 6 days</strong>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="x-small text-white-50 d-block">Base Rate</span>
                            <span class="fs-6 text-white-50 font-mono" id="previewBaseCost">Rs. 3,777</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="x-small text-white-50 d-block">Distance Surcharge</span>
                            <span class="fs-6 text-white-50 font-mono" id="previewPetrol">Rs. 4,200</span>
                        </div>
                    </div>

                    <div id="previewSpecialRow" class="alert alert-warning py-1.5 px-3 rounded-3 small mb-3 d-none">
                        <i class="bi bi-info-circle-fill me-1"></i>Special out-of-network delivery (+15% transport fee included)
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-50">
                        <div>
                            <span class="x-small text-white-50 d-block">Total Estimated Cost</span>
                            <h2 class="fw-bold text-info mb-0 font-mono" id="previewTotal">Rs. 7,977</h2>
                        </div>
                        <a asp-controller="Account" asp-action="Login" asp-route-role="Customer" class="btn btn-primary rounded-pill px-4 py-2.5 text-white fw-semibold shadow-sm d-flex align-items-center gap-2">
                            <span>Book at this Rate</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- 4. NATIONWIDE HUB NETWORK COVERAGE -->
    <div class="mb-5">
        <div class="text-center mb-4">
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 font-mono fw-semibold mb-2">HUB INFRASTRUCTURE</span>
            <h3 class="fw-bold text-dark mb-1">Fleetify Central Hubs Across Pakistan</h3>
            <p class="text-secondary small">Strategically located industrial transit facilities ensuring fast turnaround and zero delays.</p>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
            <span class="hub-badge"><i class="bi bi-geo-alt-fill text-primary"></i>Lahore (Central Hub)</span>
            <span class="hub-badge"><i class="bi bi-geo-alt-fill text-primary"></i>Karachi (South Hub)</span>
            <span class="hub-badge"><i class="bi bi-geo-alt-fill text-primary"></i>Islamabad (North Hub)</span>
