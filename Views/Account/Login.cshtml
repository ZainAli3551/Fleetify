@model Fleetify.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = $"Sign In as {Model.Role}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 auth-card bg-white">
                <div class="text-center mb-4">
                    <a asp-controller="Account" asp-action="SelectRole" class="d-inline-block mb-3 text-decoration-none">
                        <img src="~/images/fleetify-logo.png" alt="Fleetify Logo" style="height: 55px; object-fit: contain;" />
                    </a>
                    <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
                    <p class="text-muted small">Sign in as <span class="fw-semibold text-primary">@Model.Role</span></p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Role" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small text-secondary fw-medium">Email</label>
                        <input asp-for="Email" class="form-control rounded-3 py-2" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label small text-secondary fw-medium">Password</label>
                        <input asp-for="Password" type="password" class="form-control rounded-3 py-2" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold text-white">Sign In</button>
                    </div>

                    <div class="text-center small">
                        <p class="mb-2">
                            Don't have an account?
                            <a asp-action="Register" asp-route-role="@Model.Role" class="text-primary text-decoration-none fw-semibold">Sign up</a>
                        </p>
                        <a asp-action="SelectRole" class="text-secondary text-decoration-none">— Change role</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
