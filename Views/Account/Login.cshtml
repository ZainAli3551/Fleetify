@model Fleetify.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = $"Sign In - {Model.Role} Portal";
}

<div class="container py-4 py-lg-5">
    <div class="card border-0 shadow-2xl rounded-5 overflow-hidden auth-split-card mx-auto">
        <div class="row g-0">
            <!-- Left Column: Realistic Fleet Banner & Brand Story -->
            <div class="col-lg-6 d-none d-lg-flex position-relative auth-image-col text-white p-5 flex-column justify-content-between">
                <div class="position-relative" style="z-index: 2;">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill auth-glass-pill mb-4">
                        <span class="pulse-dot"></span>
                        <span class="x-small fw-bold text-uppercase tracking-wider text-cyan">Enterprise Fleet Logistics</span>
                    </div>
                    <div>
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                            <img src="~/images/fleetify-logo-white-bg.png" alt="Fleetify" style="height: 42px; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.35);" />
                        </a>
                    </div>
                </div>

                <div class="position-relative my-auto py-4" style="z-index: 2;">
                    <span class="badge bg-primary-subtle text-cyan border border-info border-opacity-25 rounded-pill px-3 py-1 font-mono x-small fw-semibold mb-3 d-inline-block">
                        AUTOMATED ROUTE &amp; DISPATCH TELEMETRY
                    </span>
                    <h2 class="display-6 fw-bold mb-3 text-white lh-sm">
                        Intelligent Fleet Operations &amp; Real-Time Cargo Logistics
                    </h2>
                    <p class="text-light opacity-90 mb-4" style="font-size: 0.95rem; line-height: 1.65; max-width: 480px;">
                        Connect to Pakistan's premier freight network featuring live GPS telemetry, formula-accurate instant pricing, and automated dispatch across 150+ nationwide hubs.
                    </p>

                    <!-- Trust Metric Badges -->
                    <div class="row g-2.5">
                        <div class="col-6">
                            <div class="auth-stat-card p-3 rounded-3">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="p-2 rounded-2 bg-primary bg-opacity-25 text-cyan">
                                        <i class="bi bi-truck fs-5"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block text-white font-mono small">500+ Vehicles</strong>
                                        <span class="text-white-50 x-small">Active Fleet</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="auth-stat-card p-3 rounded-3">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="p-2 rounded-2 bg-primary bg-opacity-25 text-cyan">
                                        <i class="bi bi-speedometer2 fs-5"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block text-white font-mono small">99.8% On-Time</strong>
                                        <span class="text-white-50 x-small">Precision SLA</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="auth-stat-card p-3 rounded-3">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="p-2 rounded-2 bg-primary bg-opacity-25 text-cyan">
                                        <i class="bi bi-geo-alt-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block text-white font-mono small">Nationwide</strong>
                                        <span class="text-white-50 x-small">150+ Network Hubs</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="auth-stat-card p-3 rounded-3">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="p-2 rounded-2 bg-primary bg-opacity-25 text-cyan">
                                        <i class="bi bi-shield-check fs-5"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block text-white font-mono small">100% Insured</strong>
                                        <span class="text-white-50 x-small">Verified Security</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="position-relative pt-3 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center x-small text-white-50" style="z-index: 2;">
                    <span>&copy; @DateTime.UtcNow.Year Fleetify Logistics</span>
                    <span><i class="bi bi-broadcast text-success me-1"></i>Live Telemetry Connected</span>
                </div>
            </div>

            <!-- Right Column: Authentication Form & Role Selector -->
            <div class="col-lg-6 bg-white p-4 p-md-5 d-flex flex-column justify-content-center">
                <div class="text-center text-lg-start mb-4">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-block d-lg-none mb-3 text-decoration-none">
                        <img src="~/images/fleetify-logo.png" alt="Fleetify" style="height: 48px;" />
                    </a>
                    <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
                    <p class="text-secondary small mb-0">Select your role and sign in to access your portal.</p>
                </div>

                <!-- Box to Select Role -->
                <div class="role-select-box p-2.5 rounded-4 mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-2 px-1">
                        <span class="x-small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.05em;">
                            <i class="bi bi-person-gear me-1 text-primary"></i>Select Your Role
                        </span>
                        <span id="roleIndicatorBadge" class="badge rounded-pill @(Model.Role == "Admin" ? "bg-indigo-subtle text-indigo" : "bg-success-subtle text-success") font-mono x-small">
                            @(Model.Role == "Admin" ? "Fleet Administrator" : "Customer / Shipper")
                        </span>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <button type="button" class="btn w-100 role-option-btn @(Model.Role == "Customer" ? "active" : "")" id="btnRoleCustomer" onclick="chooseRole('Customer')">
                                <div class="d-flex align-items-center justify-content-center gap-1.5 mb-0.5">
                                    <i class="bi bi-box-seam-fill text-success fs-5"></i>
                                    <span class="fw-bold text-dark">Customer</span>
                                </div>
                                <span class="role-desc text-muted x-small d-block">Shipper &amp; Tracking</span>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn w-100 role-option-btn @(Model.Role == "Admin" ? "active" : "")" id="btnRoleAdmin" onclick="chooseRole('Admin')">
                                <div class="d-flex align-items-center justify-content-center gap-1.5 mb-0.5">
                                    <i class="bi bi-shield-lock-fill text-primary fs-5"></i>
                                    <span class="fw-bold text-dark">Fleet Admin</span>
                                </div>
                                <span class="role-desc text-muted x-small d-block">Operations &amp; Dispatch</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Sign In Form -->
                <form asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Role" id="inputRole" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3"></div>
                    }

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0 rounded-end-3 py-2.5" placeholder="name@example.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary mb-0">Password</label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control border-start-0 rounded-end-3 py-2.5" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" id="submitBtn" class="btn btn-primary btn-lg rounded-pill py-2.5 fw-bold text-white shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <span id="submitBtnText">Sign In as @(Model.Role == "Admin" ? "Fleet Admin" : "Customer")</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                    <div class="text-center small">
                        <p class="mb-2 text-secondary">
                            Don't have an account yet?
                            <a id="registerLink" asp-action="Register" asp-route-role="@Model.Role" class="text-primary text-decoration-none fw-bold">Sign up now</a>
                        </p>
                        <a asp-controller="Account" asp-action="SelectRole" class="text-muted text-decoration-none x-small">
                            <i class="bi bi-arrow-left me-1"></i>Back to Fleetify Overview
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function chooseRole(selectedRole) {
            document.getElementById('inputRole').value = selectedRole;
            const btnCustomer = document.getElementById('btnRoleCustomer');
            const btnAdmin = document.getElementById('btnRoleAdmin');
            const submitBtnText = document.getElementById('submitBtnText');
            const roleBadge = document.getElementById('roleIndicatorBadge');
            const registerLink = document.getElementById('registerLink');

            if (selectedRole === 'Admin') {
                btnAdmin.classList.add('active');
                btnCustomer.classList.remove('active');
                submitBtnText.textContent = 'Sign In as Fleet Admin';
                roleBadge.className = 'badge rounded-pill bg-indigo-subtle text-indigo font-mono x-small';
                roleBadge.textContent = 'Fleet Administrator';
                if (registerLink) registerLink.href = '/Account/Register?role=Admin';
                history.replaceState(null, '', '/Account/Login?role=Admin');
            } else {
                btnCustomer.classList.add('active');
                btnAdmin.classList.remove('active');
                submitBtnText.textContent = 'Sign In as Customer';
                roleBadge.className = 'badge rounded-pill bg-success-subtle text-success font-mono x-small';
                roleBadge.textContent = 'Customer / Shipper';
                if (registerLink) registerLink.href = '/Account/Register?role=Customer';
                history.replaceState(null, '', '/Account/Login?role=Customer');
            }
        }
    </script>
}
