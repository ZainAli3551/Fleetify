@model Fleetify.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password - Fleetify";
}

<style>
    .fleet-reset-viewport {
        min-height: 100vh;
        width: 100%;
        background: radial-gradient(circle at 50% 20%, #f1f5f9 0%, #e2e8f0 60%, #cbd5e1 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1.25rem;
        font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .fleet-reset-card {
        width: 100%;
        max-width: 480px;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.18),
                    0 10px 25px -5px rgba(15, 23, 42, 0.06),
                    0 0 0 1px rgba(226, 232, 240, 0.9);
        overflow: hidden;
        padding: 2.75rem 2.5rem;
    }

    .reset-brand-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        margin-bottom: 1.5rem;
    }

    .reset-logo-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: linear-gradient(135deg, #1d4ed8 0%, #38bdf8 100%);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    }

    .reset-logo-icon svg {
        width: 20px;
        height: 20px;
        fill: #ffffff;
    }

    .reset-brand-name {
        font-size: 1.35rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .reset-header-title {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
        margin-bottom: 0.35rem;
    }

    .reset-header-desc {
        font-size: 0.88rem;
        color: #64748b;
        margin-bottom: 1.75rem;
    }

    .pill-field-group {
        margin-bottom: 1.25rem;
    }

    .pill-field-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 0.4rem;
    }

    .pill-input-box {
        position: relative;
        display: flex;
        align-items: center;
    }

    .pill-input-icon {
        position: absolute;
        left: 1rem;
        color: #94a3b8;
        font-size: 1.05rem;
        pointer-events: none;
    }

    .pill-input-control {
        width: 100%;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem 2.75rem 0.75rem 2.85rem;
        font-size: 0.9rem;
        color: #0f172a;
        outline: none;
        transition: all 0.2s ease;
    }

    .pill-input-control:focus {
        background: #ffffff;
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .pill-action-eye {
        position: absolute;
        right: 0.85rem;
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 1.1rem;
        cursor: pointer;
        padding: 4px;
        line-height: 1;
    }

    .pill-action-eye:hover {
        color: #334155;
    }

    .btn-reset-submit {
        width: 100%;
        background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 0.85rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        transition: all 0.2s ease;
        margin-top: 0.5rem;
    }

    .btn-reset-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
        background: linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
    }

    .clean-alert {
        padding: 0.85rem 1rem;
        border-radius: 12px;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.25rem;
    }

    .clean-alert-danger {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        color: #b91c1c;
    }
</style>

<div class="fleet-reset-viewport">
    <div class="fleet-reset-card">
        
        <!-- Brand Header -->
        <a href="/" class="reset-brand-badge">
            <div class="reset-logo-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                </svg>
            </div>
            <span class="reset-brand-name">Fleetify</span>
        </a>

        <h1 class="reset-header-title">Set New Password</h1>
        <p class="reset-header-desc">
            Enter a new password for your registered account (<strong>@Model.Email</strong>).
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="clean-alert clean-alert-danger">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div asp-validation-summary="All" class="m-0"></div>
            </div>
        }

        <form asp-action="ResetPassword" method="post" id="resetPasswordForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <!-- New Password -->
            <div class="pill-field-group">
                <label asp-for="NewPassword" class="pill-field-label">New Password</label>
                <div class="pill-input-box">
                    <span class="pill-input-icon"><i class="bi bi-lock"></i></span>
                    <input asp-for="NewPassword" type="password" id="inputNewPassword" class="pill-input-control" placeholder="Minimum 6 characters" required autofocus />
                    <button type="button" class="pill-action-eye" onclick="togglePass('inputNewPassword', this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <!-- Confirm Password -->
            <div class="pill-field-group">
                <label asp-for="ConfirmPassword" class="pill-field-label">Confirm New Password</label>
                <div class="pill-input-box">
                    <span class="pill-input-icon"><i class="bi bi-shield-check"></i></span>
                    <input asp-for="ConfirmPassword" type="password" id="inputConfirmPassword" class="pill-input-control" placeholder="Re-enter new password" required />
                    <button type="button" class="pill-action-eye" onclick="togglePass('inputConfirmPassword', this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-reset-submit">
                <i class="bi bi-check2-circle me-1"></i> Update Password
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <a href="/Account/Login" class="text-decoration-none small text-muted">
                <i class="bi bi-arrow-left me-1"></i> Return to Sign In
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePass(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
