@model Fleetify.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = $"Create {Model.Role} Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 auth-card bg-white">
                <div class="text-center mb-4">
                    <a asp-controller="Account" asp-action="SelectRole" class="d-inline-block mb-3 text-decoration-none">
                        <img src="~/images/fleetify-logo.png" alt="Fleetify Logo" style="height: 55px; object-fit: contain;" />
                    </a>
                    <h3 class="fw-bold text-dark mb-1">Create Account</h3>
                    <p class="text-muted small">Sign up as <span class="fw-semibold text-primary">@Model.Role</span></p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Role" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small text-secondary fw-medium">Full Name</label>
                        <input asp-for="FullName" class="form-control rounded-3 py-2" placeholder="e.g. Ibrahim Sian" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small text-secondary fw-medium">Email</label>
                        <input asp-for="Email" class="form-control rounded-3 py-2" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label small text-secondary fw-medium">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3 py-2" placeholder="+92 300 1234567" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    @if (Model.Role == "Customer")
                    {
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label small text-secondary fw-medium">Default Pickup/Dropoff Address</label>
                            <input asp-for="Address" class="form-control rounded-3 py-2" placeholder="123 Main St, Gujranwala" />
                        </div>
                    }
                    else if (Model.Role == "Driver")
                    {
                        <div class="mb-3">
                            <label asp-for="LicenseNumber" class="form-label small text-secondary fw-medium">Driver License Number</label>
                            <input asp-for="LicenseNumber" class="form-control rounded-3 py-2" placeholder="PK-DL-98765" />
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label small text-secondary fw-medium">Password</label>
                        <input asp-for="Password" type="password" class="form-control rounded-3 py-2" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold text-white">Create Account</button>
                    </div>

                    <div class="text-center small">
                        <p class="mb-2">
                            Already have an account?
                            <a asp-action="Login" asp-route-role="@Model.Role" class="text-primary text-decoration-none fw-semibold">Sign in</a>
                        </p>
                        <a asp-action="SelectRole" class="text-secondary text-decoration-none">— Change role</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
